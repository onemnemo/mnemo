<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Referenced from MnemoApp.sln purely so a solution build compiles this
    project; it is a standalone fixture generator for the TS/C# inline span
    differential test, not part of the shipped app. That build coverage is
    the point: this is the only way to regenerate the frozen cross-language
    span fixture, and it must fail loudly (a compile error) the moment Mnemo.Core
    changes shape, not silently the next time someone tries to regenerate.
    See Program.cs for the run command.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mnemo.SpanFixtureGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mnemo.Core\Mnemo.Core.csproj" />
  </ItemGroup>

</Project>
