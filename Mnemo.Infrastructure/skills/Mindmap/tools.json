{
  "tools": [
    {
      "name": "search_mindmaps",
      "description": "Find mindmaps. With query: fuzzy title search. Without query: lists mindmaps. limit defaults to 20.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "integer" },
          "fuzzy": { "type": "boolean" }
        }
      },
      "enabled": true
    },
    {
      "name": "outline_mindmap",
      "description": "Compact nested tree: { id, label, children[] } with short node ids. Use before editing to keep context small. Returns version for edit_mindmap.",
      "parameters": {
        "type": "object",
        "properties": {
          "mindmap_id": { "type": "string" }
        },
        "required": ["mindmap_id"]
      },
      "enabled": true
    },
    {
      "name": "read_mindmap",
      "description": "Read nodes with full detail (label, parent, style, layout, links). subtree_of: one node + descendants. node_ids: specific nodes. Omit both for full graph.",
      "parameters": {
        "type": "object",
        "properties": {
          "mindmap_id": { "type": "string" },
          "subtree_of": { "type": "string", "description": "Node id or short-id prefix." },
          "node_ids": { "type": "array", "items": { "type": "string" } },
          "include_links": { "type": "boolean", "description": "Include cross-link edges (default true)." }
        },
        "required": ["mindmap_id"]
      },
      "enabled": true
    },
    {
      "name": "edit_mindmap",
      "description": "Atomic batch of mindmap ops. set_label {id, label}. add {anchor?, nodes:[{label, children[]}]} inserts nested subtrees. delete {id|ids} cascades. move {id, parent}. link {source, target, link_label?}. unlink {edge_id} or {source, target}. style {id|ids|subtree_of, color, shape, collapsed}. Structural ops auto-run layout. Pass expected_version from outline/read.",
      "parameters": {
        "type": "object",
        "properties": {
          "mindmap_id": { "type": "string" },
          "expected_version": { "type": "string" },
          "ops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": { "type": "string", "enum": ["set_label", "add", "delete", "move", "link", "unlink", "style"] },
                "id": { "type": "string" },
                "ids": { "type": "array", "items": { "type": "string" } },
                "label": { "type": "string" },
                "anchor": { "type": "string" },
                "parent": { "type": "string" },
                "source": { "type": "string" },
                "target": { "type": "string" },
                "edge_id": { "type": "string" },
                "link_label": { "type": "string" },
                "color": { "type": "string" },
                "shape": { "type": "string", "enum": ["rectangle", "pill", "circle"] },
                "collapsed": { "type": "boolean" },
                "subtree_of": { "type": "string" },
                "include_anchor": { "type": "boolean" },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "type": "string" },
                      "color": { "type": "string" },
                      "shape": { "type": "string" },
                      "children": { "type": "array", "items": { "type": "object" } }
                    },
                    "required": ["label"]
                  }
                }
              },
              "required": ["op"]
            }
          }
        },
        "required": ["mindmap_id", "ops"]
      },
      "enabled": true
    },
    {
      "name": "create_mindmap",
      "description": "Create a mindmap. outline[]: nested {label, children[]} tree built in one call under the root. from_note_id: convert a note's headings/bullets into a mindmap. Auto-layout after creation.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "root_label": { "type": "string" },
          "from_note_id": { "type": "string", "description": "Build from an existing note." },
          "layout_algorithm": { "type": "string", "enum": ["TreeVertical", "TreeHorizontal", "Radial"] },
          "outline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "color": { "type": "string" },
                "shape": { "type": "string" },
                "children": { "type": "array", "items": { "type": "object" } }
              },
              "required": ["label"]
            }
          }
        },
        "required": ["title"]
      },
      "enabled": true
    },
    {
      "name": "manage_mindmap",
      "description": "Rename, change layout_algorithm, or delete (delete: true) a mindmap.",
      "parameters": {
        "type": "object",
        "properties": {
          "mindmap_id": { "type": "string" },
          "rename": { "type": "string" },
          "layout_algorithm": { "type": "string", "enum": ["TreeVertical", "TreeHorizontal", "Radial"] },
          "delete": { "type": "boolean" }
        },
        "required": ["mindmap_id"]
      },
      "enabled": true
    },
    {
      "name": "open_mindmap",
      "description": "Open the mindmap editor UI.",
      "parameters": {
        "type": "object",
        "properties": { "mindmap_id": { "type": "string" } },
        "required": ["mindmap_id"]
      },
      "enabled": true
    }
  ]
}
