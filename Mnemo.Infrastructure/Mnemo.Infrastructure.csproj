<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mnemo.Core\Mnemo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mnemo.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Languages\*.json" />
    <!-- Module translation resources. The resource name is what the module registers a source
         for, so a file moved between folders renames its resource and has to be registered
         under the new name. -->
    <EmbeddedResource Include="Modules\Flashcards\Translations\*.json" />
    <EmbeddedResource Include="Modules\Mindmap\Translations\*.json" />
    <EmbeddedResource Include="Modules\Notes\Translations\*.json" />
    <EmbeddedResource Include="Modules\Overview\Widgets\**\Translations\*.json" />
    <EmbeddedResource Include="Seed\WelcomeNote.json" />
    <EmbeddedResource Include="Seed\welcome-mitochondrion.png" />
    <Content Include="Dictionaries\Spellcheck\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="skills\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>