[
  { "name": "lowercase tag", "markdown": "one<br>two", "rows": ["one\ntwo"] },
  { "name": "uppercase tag", "markdown": "one<BR>two", "rows": ["one\ntwo"] },
  { "name": "self closing tag", "markdown": "one<br/>two", "rows": ["one\ntwo"] },
  { "name": "self closing tag with a space", "markdown": "one<br />two", "rows": ["one\ntwo"] },
  { "name": "several in a row", "markdown": "one<br><br>two", "rows": ["one\n\ntwo"] },
  { "name": "at the start", "markdown": "<br>two", "rows": ["\ntwo"] },
  { "name": "at the end", "markdown": "one<br>", "rows": ["one\n"] },
  { "name": "inside bold", "markdown": "**one<br>two**", "rows": ["one\ntwo|b"] },
  { "name": "inside italic", "markdown": "*one<br>two*", "rows": ["one\ntwo|i"] },
  { "name": "inside a link", "markdown": "[one<br>two](https://example.com)", "rows": ["one\ntwo|link=https://example.com"] },
  { "name": "between formats", "markdown": "**one**<br>*two*", "rows": ["one|b", "\n", "two|i"] },
  { "name": "inside a code span", "markdown": "`one<br>two`", "rows": ["one<br>two|code"] },
  { "name": "in a heading", "markdown": "# one<br>two", "rows": ["one\ntwo"] },
  { "name": "in a list item", "markdown": "- one<br>two", "rows": ["one\ntwo"] },
  { "name": "next to a hard break", "markdown": "one\\\n<br>two", "rows": ["one\n\ntwo"] },
  { "name": "other tags stay dropped", "markdown": "one<span>two</span>", "rows": ["onetwo"] },
  { "name": "a longer tag name is not a break", "markdown": "one<brx>two", "rows": ["onetwo"] },
  { "name": "a break with attributes stays dropped", "markdown": "one<br class=\"x\">two", "rows": ["onetwo"] },
  { "name": "text without a tag is untouched", "markdown": "a < b and b > a", "rows": ["a < b and b > a"] },
  { "name": "at the end of a heading", "markdown": "# T<br>", "rows": ["T\n"] },
  { "name": "at the end of bold", "markdown": "**T<br>**", "rows": ["T\n|b"], "written": "**T**\\\n" },
  { "name": "at the end of italic", "markdown": "*a<br>*", "rows": ["a\n|i"], "written": "*a*\\\n" },
  { "name": "at the end of a link", "markdown": "[x<br>](https://example.com)", "rows": ["x\n|link=https://example.com"], "written": "[x](https://example.com)\\\n" },
  { "name": "an escaped tag is literal text", "markdown": "a \\<br>b", "rows": ["a <br>b"], "written": "a \\<br>b" },
  { "name": "at the start of bold", "markdown": "**<br>T**", "rows": ["\nT|b"], "written": "\\\n**T**" }
]
