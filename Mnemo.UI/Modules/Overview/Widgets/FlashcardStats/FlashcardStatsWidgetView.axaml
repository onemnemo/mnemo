<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Overview.Widgets.FlashcardStats"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="240"
             x:Class="Mnemo.UI.Modules.Overview.Widgets.FlashcardStats.FlashcardStatsWidgetView"
             x:DataType="vm:FlashcardStatsWidgetViewModel">

    <UserControl.Styles>
        <!-- Secondary metrics: muted at zero, accent only when the metric is earned. -->
        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading5}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.metric.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- Main Stats -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    Spacing="8">
            <TextBlock Text="{Binding TotalCardsPracticed}"
                       FontSize="{DynamicResource FontSize.Stat.Hero}"
                       FontFamily="{DynamicResource Font.Bold}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{markup:T Ns=Overview, Key=CardsPracticed}"
                       FontSize="{DynamicResource FontSize.Body.Small}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Secondary Stats -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,24,0,0">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Classes="metric"
                           Classes.active="{Binding !!CardsToday}"
                           Text="{Binding CardsToday}"/>
                <TextBlock Text="{markup:T Ns=Overview, Key=Today}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="metric"
                           Classes.active="{Binding !!StudyStreak}"
                           Text="{Binding StudyStreak}"/>
                <TextBlock Text="{markup:T Ns=Overview, Key=DayStreak}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
