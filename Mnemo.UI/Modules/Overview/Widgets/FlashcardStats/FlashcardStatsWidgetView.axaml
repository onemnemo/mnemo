<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Overview.Widgets.FlashcardStats"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="80"
             x:Class="Mnemo.UI.Modules.Overview.Widgets.FlashcardStats.FlashcardStatsWidgetView"
             x:DataType="vm:FlashcardStatsWidgetViewModel">

    <UserControl.Styles>
        <!-- Stat value: muted at zero, accent only when the metric is earned. -->
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading4}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.stat-value.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="Rectangle.stat-divider">
            <Setter Property="Fill" Value="{DynamicResource DividerSubtleBrush}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="10">
        <!-- Bucket label: this widget counts ALL study modes (Review, Cram, Test alike) — the
             three stat buckets (Memory / Test / Activity) must never be visually ambiguous. -->
        <TextBlock Text="{markup:T Ns=FlashcardStats, Key=Subtitle}"
                   FontSize="{DynamicResource FontSize.Caption}"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   TextWrapping="Wrap"/>

        <Grid>
            <!-- Wide: stat cells split by vertical hairlines -->
            <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*"
                  VerticalAlignment="Top"
                  IsVisible="{Binding !IsNarrow}">
                <StackPanel Grid.Column="0">
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!CardsToday}"
                               Text="{Binding CardsToday}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=Overview, Key=PracticedToday}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Classes="stat-divider" Width="1" Margin="14,2"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!MinutesToday}"
                               Text="{Binding MinutesToday}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=FlashcardStats, Key=MinutesToday}"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Classes="stat-divider" Width="1" Margin="14,2"/>

                <StackPanel Grid.Column="4">
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!SessionsToday}"
                               Text="{Binding SessionsToday}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=FlashcardStats, Key=SessionsToday}"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Classes="stat-divider" Width="1" Margin="14,2"/>

                <StackPanel Grid.Column="6">
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!StudyStreak}"
                               Text="{Binding StudyStreak}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=Overview, Key=Streak}"/>
                </StackPanel>
            </Grid>

            <!-- Narrow (1-column tile): stacked cells with horizontal hairlines -->
            <StackPanel Spacing="10"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsNarrow}">
                <StackPanel>
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!CardsToday}"
                               Text="{Binding CardsToday}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=Overview, Key=PracticedToday}"/>
                </StackPanel>
                <Rectangle Classes="stat-divider" Height="1"/>
                <StackPanel>
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!MinutesToday}"
                               Text="{Binding MinutesToday}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=FlashcardStats, Key=MinutesToday}"/>
                </StackPanel>
                <Rectangle Classes="stat-divider" Height="1"/>
                <StackPanel>
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!SessionsToday}"
                               Text="{Binding SessionsToday}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=FlashcardStats, Key=SessionsToday}"/>
                </StackPanel>
                <Rectangle Classes="stat-divider" Height="1"/>
                <StackPanel>
                    <TextBlock Classes="stat-value"
                               Classes.active="{Binding !!StudyStreak}"
                               Text="{Binding StudyStreak}"/>
                    <TextBlock Classes="stat-label" Text="{markup:T Ns=Overview, Key=Streak}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
