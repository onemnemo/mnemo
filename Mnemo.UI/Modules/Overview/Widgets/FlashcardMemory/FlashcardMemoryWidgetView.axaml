<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Overview.Widgets.FlashcardMemory"
             xmlns:markup="using:Mnemo.UI.Markup"
             xmlns:controls="using:Mnemo.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="90"
             x:Class="Mnemo.UI.Modules.Overview.Widgets.FlashcardMemory.FlashcardMemoryWidgetView"
             x:DataType="vm:FlashcardMemoryWidgetViewModel">

    <Grid>
        <StackPanel Spacing="10" IsVisible="{Binding !IsEmpty}">
            <!-- Bucket label: retention here is Review-only, never mixed with Test or Activity. -->
            <TextBlock Text="{markup:T Ns=FlashcardMemory, Key=Subtitle}"
                       FontSize="{DynamicResource FontSize.Caption}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="{DynamicResource FontSize.Heading3}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding RetentionPercent, StringFormat={}{0}%}"/>
                    <TextBlock FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"
                               Text="{markup:T Ns=FlashcardMemory, Key=RetentionLabel}"/>
                </StackPanel>

                <!-- 2x1+: trend sparkline for the busiest deck, labelled with its name -->
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            IsVisible="{Binding !IsNarrow}"
                            VerticalAlignment="Stretch">
                    <controls:TrendSparkline Values="{Binding TrendValues}"
                                              Height="34"
                                              LineBrush="{DynamicResource AccentBrush}"
                                              DotBrush="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding TrendDeckName}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Empty state: no reviews recorded yet in any deck -->
        <TextBlock IsVisible="{Binding IsEmpty}"
                   Text="{markup:T Ns=FlashcardMemory, Key=EmptyState}"
                   FontSize="{DynamicResource FontSize.Body.Small}"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
    </Grid>
</UserControl>
