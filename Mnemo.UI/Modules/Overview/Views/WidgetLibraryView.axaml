<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Overview.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="720"
             x:Class="Mnemo.UI.Modules.Overview.Views.WidgetLibraryView"
             x:CompileBindings="True"
             x:DataType="vm:WidgetLibraryViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="4,12,0,6"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="WidgetLibraryRowTemplate" DataType="vm:WidgetLibraryItemViewModel">
            <Border Background="Transparent"
                    CornerRadius="{DynamicResource Radius.Lg}"
                    Padding="8"
                    Margin="0,0,0,4">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Tinted icon tile -->
                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            Background="{DynamicResource AccentSubtleBackgroundBrush}"
                            CornerRadius="{DynamicResource Radius.Md}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <controls:SvgIcon SvgPath="{Binding IconUri}"
                                          Width="20" Height="20"
                                          Color="{DynamicResource AccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                       FontFamily="{DynamicResource Font.SemiBold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border IsVisible="{Binding IsExtension}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Sm}"
                                    Padding="4,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="EXT"
                                           FontSize="9"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SizesText}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       FontFamily="{DynamicResource Font.Monospace}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding Byline}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       IsVisible="{Binding IsExtension}"/>
                            <TextBlock Text="{Binding OnGridText}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       IsVisible="{Binding IsOnGrid}"/>
                        </StackPanel>
                    </StackPanel>

                    <controls:AppButton Grid.Column="2"
                                        Classes="outline"
                                        VerticalAlignment="Center"
                                        Padding="12,5"
                                        Content="{markup:T Ns=WidgetLibrary, Key=Add}"
                                        Command="{Binding AddCommand}"
                                        IsLoading="{Binding IsAdding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Width="340"
            Background="{DynamicResource CardBackgroundSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Xl}"
            BoxShadow="{DynamicResource Elevation.3}"
            Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{markup:T Ns=WidgetLibrary, Key=Title}"
                               FontSize="{DynamicResource FontSize.Heading5}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{markup:T Ns=WidgetLibrary, Key=Subtitle}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        CornerRadius="{DynamicResource Radius.Md}"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="{markup:T Ns=WidgetLibrary, Key=Close}">
                    <controls:AppIcon Icon="Common/x"
                                      Width="{DynamicResource IconSize.Sm}"
                                      Height="{DynamicResource IconSize.Sm}"
                                      Color="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- Search -->
            <TextBox Grid.Row="1"
                     Margin="0,12,0,0"
                     Classes="page-search"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="{markup:T Ns=WidgetLibrary, Key=SearchPlaceholder}">
                <TextBox.InnerLeftContent>
                    <controls:AppIcon Icon="Common/search"
                                      Width="14" Height="14" Margin="10,0,0,0"
                                      Color="{DynamicResource TextSecondaryBrush}"/>
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- No results -->
            <TextBlock Grid.Row="2"
                       Margin="4,16,4,0"
                       Text="{markup:T Ns=WidgetLibrary, Key=NoResults}"
                       FontSize="{DynamicResource FontSize.Body.Small}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       IsVisible="{Binding HasNoResults}"/>

            <!-- Widget list -->
            <ScrollViewer Grid.Row="3"
                          Margin="0,4,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Classes="section-header"
                               Text="{markup:T Ns=WidgetLibrary, Key=BuiltInSection}"
                               IsVisible="{Binding HasBuiltInWidgets}"/>
                    <ItemsControl ItemsSource="{Binding BuiltInWidgets}"
                                  ItemTemplate="{StaticResource WidgetLibraryRowTemplate}"/>

                    <TextBlock Classes="section-header"
                               Text="{markup:T Ns=WidgetLibrary, Key=ExtensionsSection}"
                               IsVisible="{Binding HasExtensionWidgets}"/>
                    <ItemsControl ItemsSource="{Binding ExtensionWidgets}"
                                  ItemTemplate="{StaticResource WidgetLibraryRowTemplate}"
                                  IsVisible="{Binding HasExtensionWidgets}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: store + install-from-file (extension runtime not shipped yet) -->
            <StackPanel Grid.Row="4" Spacing="8" Margin="0,12,0,0">
                <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                <TextBlock Text="{markup:T Ns=WidgetLibrary, Key=StoreTeaser}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           ToolTip.Tip="{markup:T Ns=WidgetLibrary, Key=ComingSoon}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
