<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Overview.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="240"
             x:Class="Mnemo.UI.Modules.Overview.Views.WidgetHostView"
             x:CompileBindings="True"
             x:DataType="vm:WidgetHostViewModel">

    <UserControl.Styles>
        <!-- Size chip: compact mono label; selected = accent tint fill + accent text -->
        <Style Selector="Button.size-chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.size-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.size-chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
        </Style>
        <Style Selector="Button.size-chip TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.CaptionButton}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="Button.size-chip.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
        </Style>
        <Style Selector="Button.size-chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.size-chip.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Icon-only chrome buttons (gear, remove) -->
        <Style Selector="Button.chrome-icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chrome-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>

        <!-- Edit mode: accent-tinted border marks every tile as manipulable -->
        <Style Selector="Border#Card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Card.editing">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid VerticalAlignment="Stretch">
        <!-- Card chrome: hidden while this tile marks the drop slot during its own drag -->
        <Border x:Name="Card"
                VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}"
                BoxShadow="{DynamicResource Elevation.1}"
                ClipToBounds="True"
                Classes.editing="{Binding IsEditMode}"
                IsVisible="{Binding !IsDragging}">
            <Grid RowDefinitions="Auto,*">

                <!-- ===== Edit chrome strip: grip · title · size chips · gear · remove ===== -->
                <Grid Grid.Row="0"
                      RowDefinitions="Auto,Auto"
                      IsVisible="{Binding IsEditMode}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Height="30" Margin="8,2,8,0">
                        <!-- Grip + title form the drag surface (matched by name in OverviewView) -->
                        <Border x:Name="DragHandle"
                                Grid.Column="0"
                                Background="Transparent"
                                Cursor="SizeAll"
                                Padding="4,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <controls:AppIcon Icon="Common/grip-vertical"
                                                  Width="{DynamicResource IconSize.Sm}"
                                                  Height="{DynamicResource IconSize.Sm}"
                                                  Color="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock FontSize="{DynamicResource FontSize.Caption}"
                                           FontFamily="{DynamicResource Font.SemiBold}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding !IsUnavailable}"
                                           markup:Localization.Namespace="{Binding TranslationNamespace}"
                                           markup:Localization.TextKey="{Binding DisplayNameKey}"/>
                                <TextBlock FontSize="{DynamicResource FontSize.Caption}"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding IsUnavailable}"
                                           Text="{Binding FallbackTitle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Size chips -->
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding SizeOptions}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:WidgetSizeOptionViewModel">
                                    <Button Classes="size-chip"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding $parent[ItemsControl].((vm:WidgetHostViewModel)DataContext).SelectSizeCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Label}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Configure (configurable widgets only) -->
                        <Button Grid.Column="2"
                                Classes="chrome-icon"
                                VerticalAlignment="Center"
                                Command="{Binding ConfigureCommand}"
                                IsVisible="{Binding IsConfigurable}"
                                ToolTip.Tip="{markup:T Ns=Overview, Key=ConfigureWidget}">
                            <controls:AppIcon Icon="Common/cog"
                                              Width="{DynamicResource IconSize.Sm}"
                                              Height="{DynamicResource IconSize.Sm}"
                                              Color="{DynamicResource TextSecondaryBrush}"/>
                        </Button>

                        <!-- Remove -->
                        <Button Grid.Column="3"
                                Classes="chrome-icon"
                                VerticalAlignment="Center"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="{markup:T Ns=Overview, Key=RemoveWidget}">
                            <controls:AppIcon Icon="Common/x"
                                              Width="{DynamicResource IconSize.Sm}"
                                              Height="{DynamicResource IconSize.Sm}"
                                              Color="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Dashed rule separating chrome from content -->
                    <Rectangle Grid.Row="1"
                               Height="1"
                               Margin="12,2,12,0"
                               StrokeThickness="1"
                               StrokeDashArray="3,3"
                               Stroke="{DynamicResource AccentBorderSubtleBrush}"/>
                </Grid>

                <!-- ===== View-mode header: widget title (+ remove for unavailable tiles) ===== -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="16,10,16,0"
                      IsVisible="{Binding !IsEditMode}">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSize.Body.Small}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding !IsUnavailable}"
                               markup:Localization.Namespace="{Binding TranslationNamespace}"
                               markup:Localization.TextKey="{Binding DisplayNameKey}"/>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSize.Body.Small}"
                               FontFamily="{DynamicResource Font.Monospace}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding IsUnavailable}"
                               Text="{Binding FallbackTitle}"/>
                    <Button Grid.Column="1"
                            Classes="chrome-icon"
                            Command="{Binding RemoveCommand}"
                            IsVisible="{Binding IsUnavailable}"
                            ToolTip.Tip="{markup:T Ns=Overview, Key=RemoveWidget}">
                        <controls:AppIcon Icon="Common/x"
                                          Width="{DynamicResource IconSize.Sm}"
                                          Height="{DynamicResource IconSize.Sm}"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Widget content, resolved from the content ViewModel by the ViewLocator -->
                <ContentControl Grid.Row="1"
                                Margin="16,8,16,16"
                                VerticalAlignment="Top"
                                Content="{Binding Content}"
                                IsVisible="{Binding !IsUnavailable}"/>

                <!-- Unavailable placeholder: never crashes the board -->
                <StackPanel Grid.Row="1"
                            Margin="16,6,16,12"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsUnavailable}">
                    <controls:AppIcon Icon="Common/triangle-alert"
                                      Width="{DynamicResource IconSize.Lg}"
                                      Height="{DynamicResource IconSize.Lg}"
                                      HorizontalAlignment="Center"
                                      Color="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{markup:T Ns=Overview, Key=WidgetUnavailable}"
                               FontSize="{DynamicResource FontSize.Body.Small}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{markup:T Ns=Overview, Key=WidgetUnavailableHint}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Edit-mode input blocker: widget content is inert while editing -->
                <Border Grid.Row="1"
                        Background="Transparent"
                        IsVisible="{Binding IsEditMode}"/>
            </Grid>
        </Border>

        <!-- Drop affordance: rendered in this tile's slot while it is being dragged -->
        <Grid IsVisible="{Binding IsDragging}">
            <Border Background="{DynamicResource AccentSubtleBackgroundBrush}"
                    Opacity="0.55"
                    CornerRadius="{DynamicResource Radius.Lg}"/>
            <Rectangle Stroke="{DynamicResource AccentBorderSubtleBrush}"
                       StrokeThickness="1.5"
                       StrokeDashArray="4,4"
                       RadiusX="12" RadiusY="12"
                       Fill="Transparent"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{markup:T Ns=Overview, Key=DropSlot}"
                           FontSize="{DynamicResource FontSize.Body.Small}"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding SizeLabel}"
                           FontSize="{DynamicResource FontSize.Body.Small}"
                           FontFamily="{DynamicResource Font.Monospace}"
                           Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
