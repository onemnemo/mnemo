<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Overview.ViewModels"
             xmlns:oc="using:Mnemo.UI.Modules.Overview.Controls"
             xmlns:views="using:Mnemo.UI.Modules.Overview.Views"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Mnemo.UI.Modules.Overview.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="40,28,40,28">
        <StackPanel Spacing="22" MaxWidth="1040">
            <!-- Header: greeting + date (view) / editing indicator + hint (edit) | actions -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- View mode: time-of-day greeting over today's date -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="4"
                            IsVisible="{Binding !IsEditMode}">
                    <TextBlock Text="{Binding GreetingText}"
                               FontSize="{DynamicResource FontSize.Heading4}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding DateHeading}"
                               FontSize="{DynamicResource FontSize.Body.Small}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Edit mode: live indicator + interaction hint -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="4"
                            IsVisible="{Binding IsEditMode}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{markup:T Ns=Overview, Key=EditingTitle}"
                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                   FontFamily="{DynamicResource Font.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{markup:T Ns=Overview, Key=EditingHint}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <!-- Normal mode: Customize -->
                    <controls:AppButton Classes="secondary"
                                        IconName="Common/layout-grid"
                                        Content="{markup:T Ns=Overview, Key=Customize}"
                                        Command="{Binding EnterEditCommand}"
                                        IsVisible="{Binding !IsEditMode}"/>

                    <!-- Edit mode: Add widget + Done -->
                    <controls:AppButton Classes="outline"
                                        IconName="Common/plus"
                                        Content="{markup:T Ns=Overview, Key=AddWidget}"
                                        Command="{Binding OpenWidgetLibraryCommand}"
                                        IsVisible="{Binding IsEditMode}"/>
                    <controls:AppButton Classes="accent"
                                        Content="{markup:T Ns=Overview, Key=Done}"
                                        Command="{Binding DoneCommand}"
                                        IsVisible="{Binding IsEditMode}"/>
                </StackPanel>
            </Grid>

            <!-- Widget board -->
            <Grid x:Name="BoardArea" MinHeight="500">
                <!-- Edit-mode grid hints, drawn behind the tiles at the panel's origin -->
                <oc:WidgetBoardHintLayer x:Name="BoardHints"
                                         IsHitTestVisible="False"
                                         Stroke="{DynamicResource BorderBrush}"
                                         Foreground="{DynamicResource TextFadedBrush}"/>

                <ItemsControl x:Name="BoardItems"
                              ItemsSource="{Binding Widgets}"
                              Classes="widget-board">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <oc:WidgetBoardPanel LayoutEngine="{Binding $parent[ItemsControl].((vm:OverviewViewModel)DataContext).LayoutEngine}"
                                                 ShowEmptyCells="{Binding $parent[ItemsControl].((vm:OverviewViewModel)DataContext).IsEditMode}"
                                                 AnchorIndex="{Binding $parent[ItemsControl].((vm:OverviewViewModel)DataContext).DragAnchorIndex}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- ItemContainerTheme (not a child-combinator style) — the generated
                         ContentPresenter is not a direct visual child of the ItemsControl. -->
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter" x:DataType="vm:WidgetHostViewModel">
                            <Setter Property="oc:WidgetBoardPanel.ColumnSpan" Value="{Binding Size.Columns}"/>
                            <Setter Property="oc:WidgetBoardPanel.RowSpan" Value="{Binding Size.Rows}"/>
                            <Setter Property="oc:WidgetBoardPanel.Column" Value="{Binding Column}"/>
                            <Setter Property="oc:WidgetBoardPanel.Row" Value="{Binding Row}"/>
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:WidgetHostViewModel">
                            <views:WidgetHostView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Drag ghost: a tile-like floating proxy that follows the pointer, so the drag
                     reads as carrying the widget itself -->
                <Canvas IsHitTestVisible="False" IsVisible="{Binding IsGhostVisible}">
                    <Border Canvas.Left="{Binding GhostX}"
                            Canvas.Top="{Binding GhostY}"
                            Background="{DynamicResource FloatingChromeBackgroundBrush}"
                            CornerRadius="{DynamicResource Radius.Lg}"
                            BoxShadow="{DynamicResource Elevation.3}"
                            Opacity="0.94"
                            Padding="12,9"
                            RenderTransform="scale(1.02)">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <controls:AppIcon Icon="Common/grip-vertical"
                                              Width="{DynamicResource IconSize.Sm}"
                                              Height="{DynamicResource IconSize.Sm}"
                                              Color="{DynamicResource FloatingChromeForegroundMutedBrush}"/>
                            <TextBlock Text="{Binding GhostTitle}"
                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                       FontFamily="{DynamicResource Font.SemiBold}"
                                       Foreground="{DynamicResource FloatingChromeForegroundStrongBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource FloatingChromeHoverBrush}"
                                    CornerRadius="{DynamicResource Radius.Sm}"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding GhostSizeLabel}"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           Foreground="{DynamicResource FloatingChromeForegroundMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- First-run empty state -->
                <components:EmptyState IsVisible="{Binding ShowEmptyState}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IconPath="avares://Mnemo.UI/Icons/Common/layout-grid.svg"
                                       Title="{markup:T Ns=Overview, Key=DashboardEmpty}"
                                       Description="{markup:T Ns=Overview, Key=DashboardEmptyHint}"
                                       ActionText="{markup:T Ns=Overview, Key=AddFirstWidget}"
                                       ActionCommand="{Binding OpenWidgetLibraryCommand}"/>

                <!-- Loading state -->
                <TextBlock IsVisible="{Binding !IsLayoutLoaded}"
                           Text="{markup:T Ns=Overview, Key=Loading}"
                           FontSize="{DynamicResource FontSize.Body.Medium}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
