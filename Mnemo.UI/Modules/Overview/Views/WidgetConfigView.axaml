<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Overview.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="420"
             x:Class="Mnemo.UI.Modules.Overview.Views.WidgetConfigView"
             x:CompileBindings="True"
             x:DataType="vm:WidgetConfigViewModel">

    <Border Width="440"
            Background="{DynamicResource CardBackgroundSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Xl}"
            BoxShadow="{DynamicResource Elevation.3}"
            Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
                <TextBlock Text="{Binding WidgetTitle}"
                           FontSize="{DynamicResource FontSize.Heading5}"
                           FontFamily="{DynamicResource Font.SemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{markup:T Ns=WidgetConfig, Key=Subtitle}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Settings, generated from the widget's schema -->
            <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:WidgetConfigEntryViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    <!-- Range: slider below the label, value readout to the right -->
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsRange}">
                                        <Slider Grid.Column="0"
                                                Minimum="{Binding Minimum}"
                                                Maximum="{Binding Maximum}"
                                                TickFrequency="{Binding Step}"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding RangeValue}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RangeValueText}"
                                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                                   FontFamily="{DynamicResource Font.Monospace}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   MinWidth="24"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Toggle -->
                                <ToggleSwitch Grid.Column="1"
                                              VerticalAlignment="Center"
                                              OnContent="{x:Null}" OffContent="{x:Null}"
                                              IsChecked="{Binding BoolValue}"
                                              IsVisible="{Binding IsToggle}"/>

                                <!-- Choice -->
                                <controls:ModernComboBox Grid.Column="1"
                                                         Classes="compact"
                                                         VerticalAlignment="Center"
                                                         MinWidth="150"
                                                         ItemsSource="{Binding Options}"
                                                         SelectedItem="{Binding SelectedOption}"
                                                         IsVisible="{Binding IsChoice}">
                                    <controls:ModernComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:WidgetConfigChoiceOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </controls:ModernComboBox.ItemTemplate>
                                </controls:ModernComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,16,0,0">
                <controls:AppButton Classes="ghost"
                                    Content="{markup:T Ns=WidgetConfig, Key=Cancel}"
                                    Command="{Binding CancelCommand}"/>
                <controls:AppButton Classes="accent"
                                    Content="{markup:T Ns=WidgetConfig, Key=Save}"
                                    Command="{Binding SaveCommand}"
                                    IsLoading="{Binding IsSaving}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
