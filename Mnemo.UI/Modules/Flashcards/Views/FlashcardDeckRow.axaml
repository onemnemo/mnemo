<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:converters="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             xmlns:vm="using:Mnemo.UI.Modules.Flashcards.ViewModels"
             x:Class="Mnemo.UI.Modules.Flashcards.Views.FlashcardDeckRow"
             x:DataType="vm:FlashcardDeckRowViewModel"
             x:CompileBindings="True"
             HorizontalAlignment="Stretch">

    <Border x:Name="RowBorder"
            Classes="tree-row deck-row"
            Classes.uptodate="{Binding IsUpToDate}"
            Cursor="Hand"
            HorizontalAlignment="Stretch"
            MinWidth="0">
        <Grid ColumnDefinitions="*,56,56,56,96,32" MinWidth="0">
            <!-- Deck name + card count -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Margin="{Binding Depth, Converter={x:Static converters:IntToLeftIndentConverter.Instance}}">
                <TextBlock Text="{Binding Name}"
                           Classes="deck-name"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Name}"
                           VerticalAlignment="Center"
                           MinWidth="0" />
                <TextBlock Text="{Binding CardCountLine}"
                           Classes="row-sub"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Metric columns -->
            <TextBlock Grid.Column="1" Classes="metric new" Classes.zero="{Binding !HasNew}"
                       Text="{Binding NewCount}" IsVisible="{Binding !IsUpToDate}" />
            <TextBlock Grid.Column="2" Classes="metric learn" Classes.zero="{Binding !HasLearn}"
                       Text="{Binding LearnCount}" IsVisible="{Binding !IsUpToDate}" />
            <TextBlock Grid.Column="3" Classes="metric due" Classes.zero="{Binding !HasDue}"
                       Text="{Binding ReviewDueCount}" IsVisible="{Binding !IsUpToDate}" />

            <!-- Up-to-date replaces the metric cells -->
            <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                       Classes="up-to-date"
                       Text="{markup:T Ns=Flashcards, Key=UpToDate}"
                       IsVisible="{Binding IsUpToDate}" />

            <!-- Retention -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Width="34" Height="3" CornerRadius="2" ClipToBounds="True"
                        Background="{DynamicResource WidgetBackgroundPrimaryBrush}"
                        VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left"
                            CornerRadius="2"
                            Width="{Binding RetentionFillWidth}"
                            Classes="retfill"
                            Classes.high="{Binding RetentionIsHigh}"
                            Classes.low="{Binding !RetentionIsHigh}" />
                </Border>
                <TextBlock Text="{Binding RetentionText}" Classes="retention-text" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Row actions (revealed on hover), overlays the retention column so the compact split
                 button + ⋯ have room without widening every row. -->
            <Border Grid.Column="4" Grid.ColumnSpan="2"
                    Classes="row-actions-scrim"
                    Background="{DynamicResource WidgetBackgroundHoverBrush}">
                <StackPanel x:Name="Actions"
                            Classes="row-actions"
                            Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <Button x:Name="MoreButton" Classes="row-more"
                            ToolTip.Tip="{markup:T Ns=Flashcards, Key=DeckMenu}">
                        <controls:AppIcon Icon="Common/dots-vertical" Width="16" Height="16"
                                          Color="{DynamicResource TextFadedBrush}" />
                        <Button.Flyout>
                            <!-- Study submenu mirrors FlashcardStudySplitButton's mode picker. Counts/pre-highlight
                                 are pushed in from code-behind on Opening - cross-popup bindings into MenuItems
                                 don't resolve here (same established gotcha as the split button). -->
                            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMenuFlyoutOpening">
                                <MenuItem Header="{markup:T Ns=Flashcards, Key=Study}">
                                    <MenuItem.Icon>
                                        <controls:AppIcon Icon="Common/play-filled" Width="16" Height="16" />
                                    </MenuItem.Icon>

                                    <MenuItem x:Name="ReviewMenuItem"
                                              Header="{markup:T Ns=Flashcards, Key=SessionReview}"
                                              Click="OnReviewClick"
                                              controls:MenuItemGestureHint.GestureHint="{markup:T Ns=Flashcards, Key=StudyMenuHintReview}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/play" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <Separator />

                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=StudyPracticeSectionHeader}" Classes="section-header" />

                                    <MenuItem x:Name="CramMenuItem"
                                              Header="{markup:T Ns=Flashcards, Key=SessionCram}"
                                              controls:MenuItemGestureHint.GestureHint="{markup:T Ns=Flashcards, Key=StudyMenuHintCram}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/repeat" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="{markup:T Ns=Flashcards, Key=StudyCramSectionHeader}" Classes="section-header" />
                                        <MenuItem x:Name="CramDueMenuItem"
                                                  Header="{markup:T Ns=Flashcards, Key=StudyCramDueCards}"
                                                  Click="OnCramDueClick" />
                                        <MenuItem x:Name="CramAllMenuItem"
                                                  Header="{markup:T Ns=Flashcards, Key=StudyCramAllCards}"
                                                  Click="OnCramAllClick" />
                                    </MenuItem>

                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=SessionTest}"
                                              Click="OnTestClick"
                                              controls:MenuItemGestureHint.GestureHint="{markup:T Ns=Flashcards, Key=StudyMenuHintTest}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/pencil" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{markup:T Ns=Flashcards, Key=OpenDeck}" Click="OnOpenClick">
                                    <MenuItem.Icon>
                                        <controls:AppIcon Icon="Flyout/open" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{markup:T Ns=Flashcards, Key=RenameDeck}" Click="OnRenameClick">
                                    <MenuItem.Icon>
                                        <controls:AppIcon Icon="Flyout/rename" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{markup:T Ns=Flashcards, Key=Export}" Click="OnExportClick">
                                    <MenuItem.Icon>
                                        <controls:AppIcon Icon="Flyout/export" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=ExportFormatMnemo}" CommandParameter="flashcards.mnemo" Click="OnExportClick" />
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=ExportFormatAnki}" CommandParameter="flashcards.anki" Click="OnExportClick" />
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=ExportFormatCsv}" CommandParameter="flashcards.csv" Click="OnExportClick" />
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=ChooseFormat}" Click="OnExportClick" />
                                </MenuItem>
                                <MenuItem Header="{markup:T Ns=Flashcards, Key=ReviewSettingsMenu}" Click="OnSettingsClick">
                                    <MenuItem.Icon>
                                        <controls:AppIcon Icon="Flyout/settings" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Classes="danger" Header="{markup:T Ns=Flashcards, Key=DeleteDeck}" Click="OnDeleteClick">
                                    <MenuItem.Icon>
                                        <controls:AppIcon Icon="Common/trash" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
