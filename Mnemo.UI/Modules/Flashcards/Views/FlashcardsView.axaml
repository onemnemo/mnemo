<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mnemo.UI.Modules.Flashcards.ViewModels"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:markup="using:Mnemo.UI.Markup"
             xmlns:views="using:Mnemo.UI.Modules.Flashcards.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Mnemo.UI.Modules.Flashcards.Views.FlashcardsView"
             x:DataType="vm:FlashcardsViewModel"
             x:CompileBindings="True"
             Foreground="{DynamicResource TextPrimaryBrush}"
             x:Name="root"
             ClipToBounds="False">

    <UserControl.Styles>
        <!-- Surface cards (study bar, tree) -->
        <Style Selector="Border.surface-card">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
        </Style>

        <!-- Tree rows (shared by folder + deck rows) -->
        <Style Selector="Border.tree-row">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.tree-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundHoverBrush}" />
        </Style>
        <Style Selector="Border.deck-row.uptodate">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Names -->
        <Style Selector="TextBlock.folder-name">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.deck-name">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.row-sub">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}" />
        </Style>

        <!-- Metric cells (New / Learn / Due) -->
        <Style Selector="TextBlock.metric">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.metric.new">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateNewBrush}" />
        </Style>
        <Style Selector="TextBlock.metric.learn">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="TextBlock.metric.due">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- zero last so it overrides the colored states -->
        <Style Selector="TextBlock.metric.zero">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        </Style>

        <Style Selector="TextBlock.up-to-date">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource FlashcardRetentionHighBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Retention bar -->
        <Style Selector="Border.retfill.high">
            <Setter Property="Background" Value="{DynamicResource FlashcardRetentionHighBrush}" />
        </Style>
        <Style Selector="Border.retfill.low">
            <Setter Property="Background" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="TextBlock.retention-text">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Row actions revealed on hover -->
        <Style Selector="StackPanel.row-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tree-row:pointerover StackPanel.row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Scrim behind the row actions: occludes the retention column while the study split
             button + ⋯ are revealed, so they don't have to squeeze into the 32px menu-only slot. -->
        <Style Selector="Border.row-actions-scrim">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tree-row:pointerover Border.row-actions-scrim">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.row-more">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
        </Style>
        <Style Selector="Button.row-more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>

        <!-- Column header labels -->
        <Style Selector="TextBlock.col-head">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.col-head.num">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Footer totals -->
        <Style Selector="TextBlock.total-metric">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Study-bar breakdown segments -->
        <Style Selector="TextBlock.due-context">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style Selector="TextBlock.due-seg">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
        </Style>
        <Style Selector="TextBlock.due-seg.new">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateNewBrush}" />
        </Style>
        <Style Selector="TextBlock.due-seg.learn">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="TextBlock.due-seg.review">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Toolbar buttons -->
        <Style Selector="Button.toolbar-ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolbar-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>
        <Style Selector="Button.toolbar-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolbar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      ClipToBounds="False">
            <StackPanel MaxWidth="900" MinWidth="0" HorizontalAlignment="Stretch"
                        Margin="40,26,40,32" Spacing="16" ClipToBounds="False">

                <!-- Page head -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{markup:T Ns=Flashcards, Key=Title}"
                                   FontSize="{DynamicResource FontSize.Heading4}"
                                   FontFamily="{DynamicResource Font.SemiBold}" />
                        <TextBlock Text="{Binding HeaderSummaryText}"
                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <controls:AppButton Classes="outline"
                                            IconName="Common/download"
                                            IconSize="14"
                                            Tag="transfer"
                                            Click="OnTransferClick"
                                            Content="{markup:T Ns=Flashcards, Key=Import}" />
                        <controls:AppButton x:Name="NewButton"
                                            Classes="accent"
                                            IconName="Common/plus"
                                            IconSize="16"
                                            Content="{markup:T Ns=Flashcards, Key=NewButton}">
                            <controls:AppButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=NewMenuDeck}"
                                              Command="{Binding CreateDeckCommand}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/file-text" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=NewMenuFolder}"
                                              Command="{Binding CreateFolderCommand}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/folder" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </controls:AppButton.Flyout>
                        </controls:AppButton>
                    </StackPanel>
                </Grid>

                <!-- Study bar (informational: due-today summary only, no session actions) -->
                <Border Classes="surface-card" Padding="18,13" IsVisible="{Binding HasDueToday}">
                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DueHeadlineText}"
                                   FontFamily="{DynamicResource Font.SemiBold}"
                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                   HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Classes="due-context" Text="{Binding DueDecksText}" />
                            <TextBlock Classes="due-context" Text="  ·  " />
                            <TextBlock Classes="due-context" Text="{Binding DueMinutesText}" />
                            <TextBlock Classes="due-context" Text="  ·  " />
                            <TextBlock Classes="due-seg new" Text="{Binding DueNewText}" />
                            <TextBlock Classes="due-context" Text=", " />
                            <TextBlock Classes="due-seg learn" Text="{Binding DueLearnText}" />
                            <TextBlock Classes="due-context" Text=", " />
                            <TextBlock Classes="due-seg review" Text="{Binding DueReviewText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tree toolbar -->
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !ShowEmptyState}">
                    <TextBox Grid.Column="0"
                             Classes="page-search"
                             Width="200" Height="28"
                             Text="{Binding SearchText}"
                             PlaceholderText="{markup:T Ns=Flashcards, Key=FilterDecks}">
                        <TextBox.InnerLeftContent>
                            <controls:AppIcon Icon="Common/search" Width="12" Height="12"
                                              Margin="9,0,0,0"
                                              Color="{DynamicResource TextFadedBrush}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Classes="toolbar-ghost" ToolTip.Tip="{markup:T Ns=Flashcards, Key=SortLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SortModeLabel}" VerticalAlignment="Center" />
                                <controls:AppIcon Icon="Common/chevron-down" Width="10" Height="10"
                                                  Color="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=SortDue}" Command="{Binding SetSortCommand}" CommandParameter="Due" />
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=SortName}" Command="{Binding SetSortCommand}" CommandParameter="Name" />
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=SortRetention}" Command="{Binding SetSortCommand}" CommandParameter="Retention" />
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=SortCards}" Command="{Binding SetSortCommand}" CommandParameter="Cards" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="toolbar-icon"
                                Command="{Binding ToggleExpandCollapseAllCommand}"
                                ToolTip.Tip="{markup:T Ns=Flashcards, Key=ExpandCollapseAll}">
                            <controls:AppIcon Icon="Common/chevrons-up-down" Width="12" Height="12"
                                              Color="{DynamicResource TextTertiaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Deck tree -->
                <Border Classes="surface-card" ClipToBounds="True" IsVisible="{Binding ShowTree}"
                        HorizontalAlignment="Stretch" MinWidth="0">
                    <StackPanel>
                        <!-- Column header -->
                        <Border Height="32" Padding="18,0"
                                BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,56,56,56,96,32" MinWidth="0">
                                <TextBlock Grid.Column="0" Classes="col-head" Text="{markup:T Ns=Flashcards, Key=ColDeck}" />
                                <TextBlock Grid.Column="1" Classes="col-head num" Text="{markup:T Ns=Flashcards, Key=ColNew}" />
                                <TextBlock Grid.Column="2" Classes="col-head num" Text="{markup:T Ns=Flashcards, Key=ColLearn}" />
                                <TextBlock Grid.Column="3" Classes="col-head num" Text="{markup:T Ns=Flashcards, Key=ColDue}" />
                                <TextBlock Grid.Column="4" Classes="col-head num" Text="{markup:T Ns=Flashcards, Key=ColRetention}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding LibraryRows}" HorizontalAlignment="Stretch">
                            <ItemsControl.Styles>
                                <Style Selector="ItemsControl > /template/ ItemsPresenter > ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:FlashcardFolderItemViewModel">
                                    <views:FlashcardFolderRow />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FlashcardDeckRowViewModel">
                                    <views:FlashcardDeckRow />
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>

                        <!-- Totals footer -->
                        <Border Height="34" Padding="18,0" Background="{DynamicResource WidgetBackgroundHoverBrush}">
                            <Grid ColumnDefinitions="*,56,56,56,96,32" MinWidth="0">
                                <TextBlock Grid.Column="0" Classes="col-head" Text="{markup:T Ns=Flashcards, Key=Total}" />
                                <TextBlock Grid.Column="1" Classes="total-metric" Foreground="{DynamicResource FlashcardStateNewBrush}" Text="{Binding TotalNew}" />
                                <TextBlock Grid.Column="2" Classes="total-metric" Foreground="{DynamicResource FlashcardStateLearningBrush}" Text="{Binding TotalLearn}" />
                                <TextBlock Grid.Column="3" Classes="total-metric" Foreground="{DynamicResource AccentBrush}" Text="{Binding TotalDue}" />
                                <TextBlock Grid.Column="4" Classes="total-metric" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TotalRetentionText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- First-run: no decks exist anywhere -->
                <components:EmptyState IsVisible="{Binding ShowEmptyState}"
                                       IconPath="avares://Mnemo.UI/Icons/Common/book.svg"
                                       Title="{markup:T Ns=Flashcards, Key=LibraryEmptyTitle}"
                                       Description="{markup:T Ns=Flashcards, Key=LibraryEmptyDescription}"
                                       ActionText="{markup:T Ns=Flashcards, Key=NewDeck}"
                                       ActionCommand="{Binding CreateDeckCommand}"
                                       Margin="0,48,0,0" />

                <!-- Decks exist but the filter matches none -->
                <components:EmptyState IsVisible="{Binding ShowNoResultsState}"
                                       IconPath="avares://Mnemo.UI/Icons/Common/search.svg"
                                       Title="{markup:T Ns=Flashcards, Key=NoResultsTitle}"
                                       Description="{markup:T Ns=Flashcards, Key=NoResultsDescription}"
                                       Margin="0,48,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Canvas x:Name="DragOverlayCanvas" IsHitTestVisible="False" ZIndex="999" />
    </Panel>
</UserControl>
