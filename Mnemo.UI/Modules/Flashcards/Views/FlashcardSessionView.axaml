<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mnemo.UI.Modules.Flashcards.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:conv="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Mnemo.UI.Modules.Flashcards.Views.FlashcardSessionView"
             x:DataType="vm:FlashcardSessionViewModel"
             x:CompileBindings="True"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Focusable="True"
             x:Name="root">

    <UserControl.Resources>
        <conv:LocalPathToBitmapConverter x:Key="LocalPathToBitmapConverter" />
        <conv:BoolToBrushConverter x:Key="FlagColorConverter"
                                   TrueBrush="{DynamicResource AccentBrush}"
                                   FalseBrush="{DynamicResource TextTertiaryBrush}" />

        <!-- Framed attachment figure / carousel (single figure or compact prev/next) -->
        <DataTemplate x:Key="FigureTemplate" DataType="vm:FlashcardAttachmentCarousel">
            <StackPanel Spacing="6" Width="230">
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasMultiple}">
                    <Button Grid.Column="0" Classes="carousel-nav" Command="{Binding PreviousCommand}">
                        <controls:AppIcon Icon="Common/chevron-left" Width="14" Height="14"
                                          Color="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding PositionLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Monospace}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Grid.Column="2" Classes="carousel-nav" Command="{Binding NextCommand}">
                        <controls:AppIcon Icon="Common/chevron-right" Width="14" Height="14"
                                          Color="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
                <Border Classes="figure" Tapped="OnFigureTapped">
                    <Image MaxHeight="220" Stretch="Uniform"
                           Source="{Binding CurrentPath, Converter={StaticResource LocalPathToBitmapConverter}}" />
                </Border>
                <TextBlock Text="{Binding CurrentCaption}" IsVisible="{Binding HasCaption}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Top bar surface -->
        <Style Selector="Border.topbar">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- Icon button (close, session-settings, card actions) -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>
        <Style Selector="Button.icon-btn:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Mode chip -->
        <Style Selector="Border.mode-chip">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.mode-chip.review">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}" />
        </Style>
        <Style Selector="Border.mode-chip.cram">
            <Setter Property="Background" Value="{DynamicResource ToastIconBadgeWarningBrush}" />
        </Style>
        <Style Selector="Border.mode-chip.review TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.mode-chip.cram TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="Border.mode-chip TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        </Style>

        <!-- Live counters (mono) -->
        <Style Selector="TextBlock.counter">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.counter.new">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateNewBrush}" />
        </Style>
        <Style Selector="TextBlock.counter.learn">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="TextBlock.counter.due">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.progress-count">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Card surface -->
        <Style Selector="Border.card-surface">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
            <Setter Property="Width" Value="780" />
            <Setter Property="MinHeight" Value="320" />
            <Setter Property="MaxHeight" Value="560" />
            <Setter Property="BoxShadow" Value="0 16 40 -24 #40000000" />
        </Style>

        <!-- Micro label ("ANSWER") flanked by hairlines -->
        <Style Selector="TextBlock.answer-label">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
        </Style>

        <!-- Card action icon buttons (edit / flag / undo) -->
        <Style Selector="Button.card-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.card-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>
        <Style Selector="Button.card-action:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>

        <!-- Grade buttons -->
        <Style Selector="Button.grade">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.grade.again:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.grade.hard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="Button.grade.good">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.grade.easy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardRetentionHighBrush}" />
        </Style>
        <Style Selector="Button.grade TextBlock.grade-label">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.grade TextBlock.grade-interval">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.grade.good TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
        </Style>

        <!-- Keyboard hint chips -->
        <Style Selector="Border.kbd">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.kbd TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint-text">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Attachment figure -->
        <Style Selector="Border.figure">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="Button.carousel-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Top bar ===== -->
        <Border Grid.Row="0" Classes="topbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <!-- Close -->
                <Button Grid.Column="0" Classes="icon-btn"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyClose}">
                    <controls:AppIcon Icon="Common/x" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <!-- Deck name -->
                <TextBlock Grid.Column="1" Text="{Binding DeckName}"
                           FontFamily="{DynamicResource Font.Medium}"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240" />

                <!-- Mode chip -->
                <Border Grid.Column="2" Classes="mode-chip"
                        Classes.review="{Binding !IsCram}"
                        Classes.cram="{Binding IsCram}">
                    <TextBlock Text="{Binding ModeChipText}" />
                </Border>

                <!-- Live counters -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsActive}">
                    <TextBlock Classes="counter new" Text="{Binding NewCount}" IsVisible="{Binding HasNew}"
                               ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyCounterNew}" />
                    <TextBlock Classes="counter learn" Text="{Binding LearningCount}" IsVisible="{Binding HasLearning}"
                               ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyCounterLearning}" />
                    <TextBlock Classes="counter due" Text="{Binding DueCount}" IsVisible="{Binding HasDue}"
                               ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyCounterDue}" />
                </StackPanel>

                <!-- Progress bar (amber fill for Cram, accent for Review) -->
                <Border Grid.Column="5" Width="160" Height="4" CornerRadius="2" ClipToBounds="True"
                        Background="{DynamicResource WidgetBackgroundPrimaryBrush}"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsActive}">
                    <Border HorizontalAlignment="Left" CornerRadius="2"
                            Classes.review="{Binding !IsCram}"
                            Classes.cram="{Binding IsCram}"
                            Width="{Binding ProgressFillWidth}">
                        <Border.Styles>
                            <Style Selector="Border.review">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Style>
                            <Style Selector="Border.cram">
                                <Setter Property="Background" Value="{DynamicResource FlashcardStateLearningBrush}" />
                            </Style>
                        </Border.Styles>
                    </Border>
                </Border>

                <!-- Done / total -->
                <TextBlock Grid.Column="6" Classes="progress-count" Text="{Binding ProgressText}"
                           IsVisible="{Binding IsActive}" />

                <!-- Session settings -->
                <Button Grid.Column="7" Classes="icon-btn"
                        Click="OnSessionSettingsClick"
                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=ReviewSettingsMenu}">
                    <controls:AppIcon Icon="Flyout/settings" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Panel Grid.Row="1">

            <!-- Loading -->
            <TextBlock IsVisible="{Binding IsLoading}"
                       Text="{markup:T Ns=Flashcards, Key=StudyLoading}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- All caught up (0-due Review) -->
            <StackPanel IsVisible="{Binding IsAllCaughtUp}" Spacing="16" MaxWidth="420"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:AppIcon Icon="Common/check-circle" Width="52" Height="52"
                                  Color="{DynamicResource FlashcardRetentionHighBrush}"
                                  HorizontalAlignment="Center" />
                <TextBlock Text="{markup:T Ns=Flashcards, Key=StudyAllCaughtUpTitle}"
                           FontSize="{DynamicResource FontSize.Heading3}"
                           FontFamily="{DynamicResource Font.SemiBold}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{markup:T Ns=Flashcards, Key=StudyAllCaughtUpDesc}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <controls:AppButton Classes="accent" HorizontalAlignment="Center"
                                    Command="{Binding BackToDeckCommand}"
                                    Content="{markup:T Ns=Flashcards, Key=BackToDeck}" />
            </StackPanel>

            <!-- Session complete -->
            <StackPanel IsVisible="{Binding IsComplete}" Spacing="16" MaxWidth="420"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:AppIcon Icon="Common/check-circle" Width="52" Height="52"
                                  Color="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Center" />
                <TextBlock Text="{markup:T Ns=Flashcards, Key=StudyCompleteTitle}"
                           FontSize="{DynamicResource FontSize.Heading3}"
                           FontFamily="{DynamicResource Font.SemiBold}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SummaryText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <controls:AppButton Classes="accent" HorizontalAlignment="Center"
                                    Command="{Binding BackToDeckCommand}"
                                    Content="{markup:T Ns=Flashcards, Key=BackToDeck}" />
            </StackPanel>

            <!-- Active card -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsActive}">
                <StackPanel Margin="24" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Card -->
                    <Border Classes="card-surface" x:Name="CardSurface"
                            Tapped="OnCardTapped">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Top-right actions -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2"
                                        HorizontalAlignment="Right" Margin="0,10,10,0">
                                <Button Classes="card-action"
                                        Command="{Binding EditCommand}"
                                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyEdit}">
                                    <controls:AppIcon Icon="Flyout/rename" Width="15" Height="15"
                                                      Color="{DynamicResource TextTertiaryBrush}" />
                                </Button>
                                <Button Classes="card-action"
                                        Command="{Binding FlagCommand}"
                                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyFlag}">
                                    <controls:AppIcon Icon="Common/flag" Width="15" Height="15"
                                                      Color="{Binding IsFlagged, Converter={StaticResource FlagColorConverter}}" />
                                </Button>
                                <Button Classes="card-action"
                                        Command="{Binding UndoCommand}"
                                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyUndo}">
                                    <controls:AppIcon Icon="Common/undo" Width="15" Height="15"
                                                      Color="{DynamicResource TextTertiaryBrush}" />
                                </Button>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto" Padding="34,4,34,30">
                                <StackPanel Spacing="0">
                                    <!-- Front -->
                                    <StackPanel Spacing="14">
                                        <!-- Renders markdown bold/italic; cloze deletions are masked to […]
                                             upstream in the VM. Font size follows the global Markdown.FontSize
                                             setting (the renderer ignores the control's FontSize). -->
                                        <components:MarkdownView Source="{Binding FrontText}"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <!-- Front attachments -->
                                        <ContentControl Content="{Binding FrontAttachments}"
                                                        IsVisible="{Binding FrontAttachments.HasAny}"
                                                        HorizontalAlignment="Left"
                                                        ContentTemplate="{StaticResource FigureTemplate}" />
                                    </StackPanel>

                                    <!-- Answer -->
                                    <StackPanel Spacing="14" IsVisible="{Binding IsRevealed}">
                                        <!-- Divider row "ANSWER" -->
                                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,22,0,4">
                                            <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                                                    Background="{DynamicResource BorderBrush}" />
                                            <TextBlock Grid.Column="1" Classes="answer-label"
                                                       Text="{markup:T Ns=Flashcards, Key=StudyAnswerLabel}" />
                                            <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                                    Background="{DynamicResource BorderBrush}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <components:MarkdownView Grid.Column="0"
                                                                     Source="{Binding AnswerText}"
                                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                                     Margin="0,0,14,0" />
                                            <ContentControl Grid.Column="1"
                                                            Content="{Binding BackAttachments}"
                                                            IsVisible="{Binding BackAttachments.HasAny}"
                                                            VerticalAlignment="Top"
                                                            ContentTemplate="{StaticResource FigureTemplate}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Reveal affordance (before answer) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                IsVisible="{Binding !IsRevealed}">
                        <TextBlock Classes="hint-text"
                                   Text="{markup:T Ns=Flashcards, Key=StudyShowAnswerPrefix}" />
                        <Border Classes="kbd">
                            <TextBlock Text="{markup:T Ns=Flashcards, Key=StudyKeySpace}" />
                        </Border>
                    </StackPanel>

                    <!-- Grade row (after reveal) -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsRevealed}">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Classes="grade again" Command="{Binding GradeAgainCommand}">
                                <StackPanel>
                                    <TextBlock Classes="grade-label" Text="{markup:T Ns=Flashcards, Key=GradeAgain}" />
                                    <TextBlock Classes="grade-interval" Text="{Binding AgainInterval}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="grade hard" Command="{Binding GradeHardCommand}">
                                <StackPanel>
                                    <TextBlock Classes="grade-label" Text="{markup:T Ns=Flashcards, Key=GradeHard}" />
                                    <TextBlock Classes="grade-interval" Text="{Binding HardInterval}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="grade good" Command="{Binding GradeGoodCommand}">
                                <StackPanel>
                                    <TextBlock Classes="grade-label" Text="{markup:T Ns=Flashcards, Key=GradeGood}" />
                                    <TextBlock Classes="grade-interval" Text="{Binding GoodInterval}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="grade easy" Command="{Binding GradeEasyCommand}">
                                <StackPanel>
                                    <TextBlock Classes="grade-label" Text="{markup:T Ns=Flashcards, Key=GradeEasy}" />
                                    <TextBlock Classes="grade-interval" Text="{Binding EasyInterval}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer keyboard hints -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Border Classes="kbd"><TextBlock Text="{markup:T Ns=Flashcards, Key=StudyKeyGradeRange}" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=StudyHintGrade}" />
                        <TextBlock Classes="hint-text" Text="·" />
                        <Border Classes="kbd"><TextBlock Text="{markup:T Ns=Flashcards, Key=StudyKeySpace}" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=StudyHintGood}" />
                        <TextBlock Classes="hint-text" Text="·" />
                        <Border Classes="kbd"><TextBlock Text="E" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=StudyHintEdit}" />
                        <TextBlock Classes="hint-text" Text="·" />
                        <Border Classes="kbd"><TextBlock Text="{Binding UndoKeyLabel}" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=StudyHintUndo}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
