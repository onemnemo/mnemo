<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mnemo.UI.Modules.Flashcards.ViewModels"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:markup="using:Mnemo.UI.Markup"
             xmlns:views="using:Mnemo.UI.Modules.Flashcards.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Mnemo.UI.Modules.Flashcards.Views.FlashcardDeckView"
             x:DataType="vm:FlashcardDeckViewModel"
             x:CompileBindings="True"
             Foreground="{DynamicResource TextPrimaryBrush}"
             x:Name="root"
             ClipToBounds="False">

    <UserControl.Styles>
        <!-- Surface card (the card table shell) -->
        <Style Selector="Border.surface-card">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
        </Style>

        <!-- Header sub-stat segments -->
        <Style Selector="TextBlock.substat">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.substat.learn">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="TextBlock.substat.due">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.substat-mono">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Icon button (back chevron, ⋯ menu) topbar-style -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>

        <!-- Column header labels -->
        <Style Selector="TextBlock.col-head">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.col-head.num">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.col-sort">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Card rows -->
        <Style Selector="Border.card-row">
            <Setter Property="Height" Value="37" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.card-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundHoverBrush}" />
        </Style>
        <Style Selector="Border.card-row.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}" />
        </Style>
        <Style Selector="Border.card-row.suspended TextBlock.front-text">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        </Style>
        <Style Selector="Border.card-row.suspended">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="TextBlock.front-text">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.cell-muted">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cell-mono">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cell-mono.due">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Cloze [...] inline chip (blue text carries the signal; neutral tile) -->
        <Style Selector="Border.cloze-chip">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="TextBlock.cloze-chip-text">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateNewBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Tag chip -->
        <Style Selector="Border.tag-chip">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.tag-chip-text">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style Selector="Border.tag-chip.suspended TextBlock.tag-chip-text">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>

        <!-- Filter chips -->
        <Style Selector="Border.filter-chip">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.filter-chip-text">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip-close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
        </Style>
        <!-- Dashed pill outline (Border has no dash support; Rectangle carries the stroke) -->
        <Style Selector="Rectangle.add-filter-dash">
            <Setter Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="3,3" />
            <Setter Property="RadiusX" Value="13" />
            <Setter Property="RadiusY" Value="13" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button.add-filter-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        </Style>
        <Style Selector="Button.add-filter-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>

        <!-- Pagination (table footer strip pinned to the bottom of the card) -->
        <Style Selector="Border.pager-footer">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Button.pager">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pager:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>
        <Style Selector="Button.pager:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Multi-select floating action bar (dark floating chrome) -->
        <Style Selector="Border.multi-bar">
            <Setter Property="Background" Value="{DynamicResource FloatingChromeBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BoxShadow" Value="0 16 44 0 #66000000" />
        </Style>
        <Style Selector="TextBlock.multi-count">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingChromeForegroundStrongBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Rectangle.multi-divider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="{DynamicResource FloatingChromeDividerBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.multi-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingChromeRowTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
        </Style>
        <Style Selector="Button.multi-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FloatingChromeHoverBrush}" />
        </Style>
        <Style Selector="Button.multi-action.danger">
            <Setter Property="Foreground" Value="{DynamicResource FloatingChromeDangerBrush}" />
        </Style>
        <Style Selector="Button.multi-action.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FloatingChromeDangerHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,*">

            <!-- ===== Header ===== -->
            <StackPanel Grid.Row="0" Margin="40,26,40,0" Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Back chevron -->
                    <Button Grid.Column="0" Classes="icon-btn"
                            Command="{Binding GoBackCommand}"
                            VerticalAlignment="Top"
                            Margin="-6,2,10,0"
                            ToolTip.Tip="{markup:T Ns=Flashcards, Key=BackToLibrary}">
                        <controls:AppIcon Icon="Common/chevron-left" Width="18" Height="18"
                                          Color="{DynamicResource TextSecondaryBrush}" />
                    </Button>

                    <!-- Title + sub-stats -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{Binding DeckName}"
                                   FontSize="{DynamicResource FontSize.Heading3}"
                                   FontFamily="{DynamicResource Font.SemiBold}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Classes="substat" Text="{Binding TotalCardsText}" />

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding HasLearning}">
                                <TextBlock Classes="substat learn" Text="{Binding LearningCount}" />
                                <TextBlock Classes="substat learn" Text="{markup:T Ns=Flashcards, Key=DeckStatLearningSuffix}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding HasDue}">
                                <TextBlock Classes="substat due" Text="{Binding DueCount}" />
                                <TextBlock Classes="substat due" Text="{markup:T Ns=Flashcards, Key=DeckStatDueSuffix}" />
                            </StackPanel>

                            <!-- Retention: label + mini bar + percent -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Classes="substat" Text="{markup:T Ns=Flashcards, Key=DeckRetentionLabel}" />
                                <Border Width="30" Height="3" CornerRadius="2" ClipToBounds="True"
                                        Background="{DynamicResource WidgetBackgroundPrimaryBrush}" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Left" CornerRadius="2"
                                            Background="{DynamicResource FlashcardRetentionHighBrush}"
                                            Width="{Binding RetentionFillWidth}" />
                                </Border>
                                <TextBlock Classes="substat-mono" Text="{Binding RetentionText}" />
                            </StackPanel>

                            <TextBlock Classes="substat" Text="{Binding LastStudiedText}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Top" Margin="0,2,0,0">
                        <controls:AppButton Classes="outline"
                                            IconName="Common/plus"
                                            IconSize="14"
                                            Command="{Binding AddCardsCommand}"
                                            Content="{markup:T Ns=Flashcards, Key=DeckAddCards}" />
                        <views:FlashcardStudySplitButton DeckId="{Binding DeckId}"
                                                          DueCount="{Binding DueTodayCount}"
                                                          AllCount="{Binding ActiveCards}" />
                        <controls:AppButton Classes="outline"
                                            IconName="Common/ellipsis"
                                            IconSize="16"
                                            Width="32" Height="32" Padding="0"
                                            ToolTip.Tip="{markup:T Ns=Flashcards, Key=DeckMenu}">
                            <controls:AppButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=RenameDeck}"
                                              Command="{Binding RenameDeckCommand}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Flyout/rename" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=MoveToFolder}"
                                              ItemsSource="{Binding FolderMenuItems}"
                                              Click="OnMoveToFolderClick">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/folder" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                        <MenuItem.ItemContainerTheme>
                                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                          x:DataType="vm:FlashcardFolderMenuItem">
                                                <Setter Property="Header" Value="{Binding Name}" />
                                            </ControlTheme>
                                        </MenuItem.ItemContainerTheme>
                                    </MenuItem>
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=ReviewSettingsMenu}"
                                              Command="{Binding OpenReviewSettingsCommand}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Flyout/settings" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=Export}"
                                              Command="{Binding ExportDeckCommand}"
                                              controls:MenuItemGestureHint.GestureHint=".apkg · .csv">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Flyout/export" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{markup:T Ns=Flashcards, Key=SuspendAllCards}"
                                              Command="{Binding SuspendAllCommand}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/pause" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Classes="danger"
                                              Header="{markup:T Ns=Flashcards, Key=DeleteDeck}"
                                              Command="{Binding DeleteDeckCommand}">
                                        <MenuItem.Icon>
                                            <controls:AppIcon Icon="Common/trash" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </controls:AppButton.Flyout>
                        </controls:AppButton>
                    </StackPanel>
                </Grid>

                <!-- ===== Toolbar ===== -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <TextBox Grid.Column="0"
                             Classes="page-search"
                             Width="220" Height="32"
                             Text="{Binding SearchQuery}"
                             PlaceholderText="{markup:T Ns=Flashcards, Key=SearchCardsPlaceholder}">
                        <TextBox.InnerLeftContent>
                            <controls:AppIcon Icon="Common/search" Width="13" Height="13"
                                              Margin="10,0,0,0"
                                              Color="{DynamicResource TextFadedBrush}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <!-- Active filter chips + add-filter -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding ActiveFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FlashcardFilterChipViewModel">
                                    <Border Classes="filter-chip">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Classes="filter-chip-text" Text="{Binding Label}" />
                                            <Button Classes="chip-close"
                                                    Command="{Binding #root.((vm:FlashcardDeckViewModel)DataContext).RemoveFilterCommand}"
                                                    CommandParameter="{Binding}">
                                                <controls:AppIcon Icon="Common/x" Width="10" Height="10"
                                                                  Color="{DynamicResource AccentBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Panel Height="26" VerticalAlignment="Center">
                            <Rectangle Classes="add-filter-dash" />
                            <Button Classes="add-filter-btn">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <controls:AppIcon Icon="Common/plus" Width="11" Height="11"
                                                      Color="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{markup:T Ns=Flashcards, Key=AddFilter}"
                                               FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="{markup:T Ns=Flashcards, Key=FilterByState}">
                                            <MenuItem Header="{markup:T Ns=Flashcards, Key=StateFilterDue}"
                                                      Command="{Binding AddStateFilterCommand}" CommandParameter="Due" />
                                            <MenuItem Header="{markup:T Ns=Flashcards, Key=StateFilterNew}"
                                                      Command="{Binding AddStateFilterCommand}" CommandParameter="New" />
                                            <MenuItem Header="{markup:T Ns=Flashcards, Key=StateFilterLearning}"
                                                      Command="{Binding AddStateFilterCommand}" CommandParameter="Learning" />
                                            <MenuItem Header="{markup:T Ns=Flashcards, Key=StateFilterSuspended}"
                                                      Command="{Binding AddStateFilterCommand}" CommandParameter="Suspended" />
                                            <MenuItem Header="{markup:T Ns=Flashcards, Key=StateFilterFlagged}"
                                                      Command="{Binding AddStateFilterCommand}" CommandParameter="Flagged" />
                                        </MenuItem>
                                        <MenuItem Header="{markup:T Ns=Flashcards, Key=FilterByTag}"
                                                  ItemsSource="{Binding KnownTags}"
                                                  IsVisible="{Binding HasKnownTags}"
                                                  Click="OnTagFilterClick">
                                            <MenuItem.ItemContainerTheme>
                                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                              x:DataType="x:String">
                                                    <Setter Property="Header" Value="{Binding}" />
                                                </ControlTheme>
                                            </MenuItem.ItemContainerTheme>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Panel>
                    </StackPanel>

                    <!-- N of M cards (filtered) -->
                    <TextBlock Grid.Column="3"
                               Classes="cell-muted"
                               Text="{Binding FilteredCountText}"
                               IsVisible="{Binding ShowFilteredCount}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1" Margin="40,14,40,24">

                <!-- Card table fills the body height: header pinned top, rows scroll, pager pinned bottom -->
                <Border Classes="surface-card" ClipToBounds="True" IsVisible="{Binding ShowTable}">
                    <Grid RowDefinitions="Auto,*,Auto">
                                <!-- Column header -->
                                <Border Grid.Row="0" Height="34" Padding="14,0"
                                        BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="28,*,90,140,80,64" MinWidth="0">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding SelectAllState, Mode=OneWay}"
                                                  IsThreeState="True"
                                                  Command="{Binding SetSelectAllCommand}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="col-head" Text="{markup:T Ns=Flashcards, Key=ColFront}" />
                                        <TextBlock Grid.Column="2" Classes="col-head" Text="{markup:T Ns=Flashcards, Key=ColType}" />
                                        <TextBlock Grid.Column="3" Classes="col-head" Text="{markup:T Ns=Flashcards, Key=ColTags}" />
                                        <Button Grid.Column="4" Classes="col-sort" Command="{Binding ToggleDueSortCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <TextBlock Classes="col-head num" Text="{markup:T Ns=Flashcards, Key=ColDue}" />
                                                <controls:AppIcon Icon="Common/chevron-up" Width="10" Height="10"
                                                                  Color="{DynamicResource TextFadedBrush}"
                                                                  IsVisible="{Binding DueSortAscending}" VerticalAlignment="Center" />
                                                <controls:AppIcon Icon="Common/chevron-down" Width="10" Height="10"
                                                                  Color="{DynamicResource TextFadedBrush}"
                                                                  IsVisible="{Binding DueSortDescending}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="5" Classes="col-head num" Text="{markup:T Ns=Flashcards, Key=ColLapses}" />
                                    </Grid>
                                </Border>

                                <!-- Rows scroll within the card so header + pager stay pinned -->
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FlashcardCardRowViewModel">
                                            <Border Classes="card-row"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Classes.suspended="{Binding IsSuspended}"
                                                    Tag="{Binding Id}"
                                                    DoubleTapped="OnRowDoubleTapped">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="{markup:T Ns=Flashcards, Key=EditCard}"
                                                                  Click="OnRowEditClick" Tag="{Binding Id}">
                                                            <MenuItem.Icon>
                                                                <controls:AppIcon Icon="Flyout/rename" Width="16" Height="16" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{markup:T Ns=Flashcards, Key=RowFlagToggle}"
                                                                  Click="OnRowFlagClick" Tag="{Binding Id}">
                                                            <MenuItem.Icon>
                                                                <controls:AppIcon Icon="Common/flag" Width="16" Height="16" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{markup:T Ns=Flashcards, Key=RowSuspendToggle}"
                                                                  Click="OnRowSuspendClick" Tag="{Binding Id}">
                                                            <MenuItem.Icon>
                                                                <controls:AppIcon Icon="Common/pause" Width="16" Height="16" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{markup:T Ns=Flashcards, Key=MoveToDeck}"
                                                                  ItemsSource="{Binding MoveTargets}"
                                                                  Click="OnRowMoveMenuClick"
                                                                  Tag="{Binding Id}">
                                                            <MenuItem.Icon>
                                                                <controls:AppIcon Icon="Common/folder" Width="16" Height="16" />
                                                            </MenuItem.Icon>
                                                            <MenuItem.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                              x:DataType="vm:FlashcardDeckMenuItem">
                                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                                </ControlTheme>
                                                            </MenuItem.ItemContainerTheme>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Classes="danger"
                                                                  Header="{markup:T Ns=Flashcards, Key=DeleteCard}"
                                                                  Click="OnRowDeleteClick" Tag="{Binding Id}">
                                                            <MenuItem.Icon>
                                                                <controls:AppIcon Icon="Common/trash" Width="16" Height="16" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>

                                                <Grid ColumnDefinitions="28,*,90,140,80,64" MinWidth="0">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center" />

                                                    <!-- Front: glyphs + cloze chip + text -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                MinWidth="0" VerticalAlignment="Center">
                                                        <controls:AppIcon Icon="Common/image" Width="13" Height="13"
                                                                          Color="{DynamicResource TextFadedBrush}"
                                                                          VerticalAlignment="Center"
                                                                          IsVisible="{Binding HasAttachments}" />
                                                        <controls:AppIcon Icon="Common/flag" Width="13" Height="13"
                                                                          Color="{DynamicResource FlashcardStateLearningBrush}"
                                                                          VerticalAlignment="Center"
                                                                          IsVisible="{Binding IsFlagged}" />
                                                        <Border Classes="cloze-chip" IsVisible="{Binding IsCloze}">
                                                            <TextBlock Classes="cloze-chip-text" Text="[…]" />
                                                        </Border>
                                                        <TextBlock Classes="front-text" Text="{Binding FrontPreview}"
                                                                   MinWidth="0" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Classes="cell-muted" Text="{Binding TypeLabel}" />

                                                    <!-- Tags: first tag chip, or 'suspended' chip -->
                                                    <Panel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Border Classes="tag-chip suspended" IsVisible="{Binding IsSuspended}">
                                                            <TextBlock Classes="tag-chip-text"
                                                                       Text="{markup:T Ns=Flashcards, Key=SuspendedChip}" />
                                                        </Border>
                                                        <Border Classes="tag-chip"
                                                                IsVisible="{Binding HasTag}">
                                                            <Border.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="HasTag" />
                                                                    <Binding Path="!IsSuspended" />
                                                                </MultiBinding>
                                                            </Border.IsVisible>
                                                            <TextBlock Classes="tag-chip-text" Text="{Binding FirstTag}" />
                                                        </Border>
                                                    </Panel>

                                                    <TextBlock Grid.Column="4" Classes="cell-mono"
                                                               Classes.due="{Binding IsDueNow}"
                                                               Text="{Binding DueText}" />
                                                    <TextBlock Grid.Column="5" Classes="cell-mono" Text="{Binding LapsesText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>

                                <!-- Pagination footer pinned to the bottom of the card -->
                                <Border Grid.Row="2" Classes="pager-footer" IsVisible="{Binding ShowPagination}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="cell-muted" Text="{Binding PageRangeText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Classes="pager" Command="{Binding PreviousPageCommand}">
                                                <controls:AppIcon Icon="Common/chevron-left" Width="14" Height="14"
                                                                  Color="{DynamicResource TextSecondaryBrush}" />
                                            </Button>
                                            <Button Classes="pager" Command="{Binding NextPageCommand}">
                                                <controls:AppIcon Icon="Common/chevron-right" Width="14" Height="14"
                                                                  Color="{DynamicResource TextSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                    </Grid>
                </Border>

                <!-- First-run empty -->
                <components:EmptyState IsVisible="{Binding ShowEmptyState}"
                                       IconPath="avares://Mnemo.UI/Icons/Common/book.svg"
                                       Title="{markup:T Ns=Flashcards, Key=DeckEmptyTitle}"
                                       Description="{markup:T Ns=Flashcards, Key=DeckEmptyDescription}"
                                       ActionText="{markup:T Ns=Flashcards, Key=DeckAddCards}"
                                       ActionCommand="{Binding AddCardsCommand}"
                                       VerticalAlignment="Center" />

                <!-- No results -->
                <components:EmptyState IsVisible="{Binding ShowNoResultsState}"
                                       IconPath="avares://Mnemo.UI/Icons/Common/search.svg"
                                       Title="{markup:T Ns=Flashcards, Key=NoResultsTitle}"
                                       Description="{markup:T Ns=Flashcards, Key=DeckNoResultsDescription}"
                                       VerticalAlignment="Center" />

                <!-- Loading overlay -->
                <Border IsVisible="{Binding IsLoading}"
                        Background="{DynamicResource WorkspaceBackgroundBrush}"
                        Opacity="0.6" IsHitTestVisible="False" />

                <!-- ===== Multi-select floating action bar ===== -->
                <Border Classes="multi-bar"
                        IsVisible="{Binding HasSelection}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Classes="multi-count" Text="{Binding SelectionCountText}" />
                        <Rectangle Classes="multi-divider" />

                        <!-- Move to ▾ -->
                        <Button Classes="multi-action">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{markup:T Ns=Flashcards, Key=BatchMove}" VerticalAlignment="Center" />
                                <controls:AppIcon Icon="Common/chevron-down" Width="10" Height="10"
                                                  Color="{DynamicResource FloatingChromeRowTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedLeft"
                                            ItemsSource="{Binding MoveTargetDecks}">
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                      x:DataType="vm:FlashcardDeckMenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding Invoke}" />
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Tag -->
                        <Button Classes="multi-action" Content="{markup:T Ns=Flashcards, Key=BatchTag}">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Width="220">
                                        <TextBox Width="150"
                                                 Text="{Binding BatchTagInput}"
                                                 PlaceholderText="{markup:T Ns=Flashcards, Key=TagAddPlaceholder}"
                                                 KeyDown="OnBatchTagKeyDown" />
                                        <controls:AppButton Classes="accent"
                                                            Content="{markup:T Ns=Flashcards, Key=CardEditorAddTag}"
                                                            Command="{Binding CommitBatchTagCommand}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Suspend / Unsuspend -->
                        <Button Classes="multi-action" Command="{Binding BatchSuspendCommand}"
                                Content="{Binding SuspendActionLabel}" />

                        <!-- Flag / Unflag -->
                        <Button Classes="multi-action" Command="{Binding BatchFlagCommand}"
                                Content="{Binding FlagActionLabel}" />

                        <Rectangle Classes="multi-divider" />

                        <!-- Delete -->
                        <Button Classes="multi-action danger" Command="{Binding BatchDeleteCommand}"
                                Content="{markup:T Ns=Common, Key=Delete}" />

                        <!-- Clear -->
                        <Button Classes="multi-action" Command="{Binding ClearSelectionCommand}"
                                ToolTip.Tip="{markup:T Ns=Flashcards, Key=ClearSelection}">
                            <controls:AppIcon Icon="Common/x" Width="12" Height="12"
                                              Color="{DynamicResource FloatingChromeRowTextBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Panel>
</UserControl>
