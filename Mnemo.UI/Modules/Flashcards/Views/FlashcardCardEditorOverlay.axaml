<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Flashcards.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:conv="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="724" d:DesignHeight="620"
             x:Class="Mnemo.UI.Modules.Flashcards.Views.FlashcardCardEditorOverlay"
             x:DataType="vm:FlashcardCardEditorViewModel"
             x:CompileBindings="True"
             Focusable="True"
             Width="724"
             x:Name="Root">

    <UserControl.Resources>
        <conv:LocalPathToBitmapConverter x:Key="LocalPathToBitmapConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Uppercase micro-label above each side -->
        <Style Selector="TextBlock.ce-micro-label">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        </Style>

        <!-- Field container: bordered card holding the text field + its attachments -->
        <Style Selector="Border.ce-field">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Focused side: accent border + soft ring -->
        <Style Selector="Border.ce-field.focused">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 0 0 3 #26C64F33"/>
        </Style>

        <!-- Multiline text field, chromeless (border lives on the container) -->
        <Style Selector="TextBox.ce-input">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}"/>
        </Style>
        <Style Selector="TextBox.ce-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Quiet format-bar button -->
        <Style Selector="Button.ce-fmt">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ce-fmt:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavigationButtonBackgroundHoverBrush}"/>
        </Style>

        <!-- Tag chip -->
        <Style Selector="Border.ce-tag">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Border.ce-tag-add">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Attachment figure -->
        <Style Selector="Border.ce-figure">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Button.ce-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.ce-link.destructive">
            <Setter Property="Foreground" Value="{DynamicResource DestructiveButtonColorBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="{DynamicResource Radius.Lg}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource OverlayBackgroundBrush}"
            BoxShadow="0 16 40 0 #38000000"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header: title · deck picker · spacer · type toggle · close -->
            <Border Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                    Padding="20,14">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding TitleText}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSize.Body.Small}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <controls:ModernComboBox Grid.Column="1"
                                             Classes="compact"
                                             Margin="14,0,0,0"
                                             MinWidth="180"
                                             ItemsSource="{Binding Decks}"
                                             SelectedItem="{Binding SelectedDeck}">
                        <controls:ModernComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FlashcardDeckPickerItem">
                                <TextBlock Text="{Binding PathLabel}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </controls:ModernComboBox.ItemTemplate>
                    </controls:ModernComboBox>

                    <!-- Classic | Cloze segmented toggle -->
                    <Border Grid.Column="3" Classes="segment-track" VerticalAlignment="Center">
                        <UniformGrid Columns="2" Width="150">
                            <Button Classes="segment"
                                    Classes.selected="{Binding IsClassic}"
                                    Content="{Binding ClassicLabel}"
                                    Command="{Binding SetClassicCommand}"/>
                            <Button Classes="segment"
                                    Classes.selected="{Binding IsCloze}"
                                    Content="{Binding ClozeLabel}"
                                    Command="{Binding SetClozeCommand}"/>
                        </UniformGrid>
                    </Border>

                    <controls:AppButton Grid.Column="4"
                                        Classes="ghost"
                                        IconName="Common/x"
                                        IconSize="14"
                                        Width="28" Height="28"
                                        Padding="0"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16,20,16" Spacing="14">

                    <!-- FRONT -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="ce-micro-label" Text="{Binding FrontLabel}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                        IsVisible="{Binding IsFrontFocused}">
                                <Button Classes="ce-fmt" Content="B" FontFamily="{DynamicResource Font.SemiBold}"
                                        ToolTip.Tip="{Binding BoldTooltip}"
                                        Click="OnFrontBoldClick"/>
                                <Button Classes="ce-fmt" Content="I" FontStyle="Italic"
                                        ToolTip.Tip="{Binding ItalicTooltip}"
                                        Click="OnFrontItalicClick"/>
                                <Button Classes="ce-fmt" Content="[…]"
                                        IsVisible="{Binding IsCloze}"
                                        ToolTip.Tip="{Binding ClozeWrapTooltip}"
                                        Click="OnFrontClozeClick"/>
                                <Border Width="1" Height="16" Margin="4,0"
                                        Background="{DynamicResource DividerSubtleBrush}"
                                        VerticalAlignment="Center"/>
                                <Button Classes="ce-fmt"
                                        IsVisible="{Binding CanAddFrontAttachment}"
                                        ToolTip.Tip="{Binding ImageTooltip}"
                                        Click="OnFrontImageClick">
                                    <controls:AppIcon Icon="FormattingToolbar/polaroid" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Classes="ce-field" Classes.focused="{Binding IsFrontFocused}"
                                DragDrop.AllowDrop="True">
                            <StackPanel Spacing="10">
                                <TextBox x:Name="FrontInput" Classes="ce-input"
                                         Text="{Binding Front, Mode=TwoWay}"
                                         GotFocus="OnFrontGotFocus"/>
                                <ItemsControl ItemsSource="{Binding FrontAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FlashcardAttachmentItemViewModel">
                                            <Border Classes="ce-figure">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0"
                                                            Width="170" Height="104"
                                                            CornerRadius="{DynamicResource Radius.Md}"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding FilePath, Converter={StaticResource LocalPathToBitmapConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SizeLabel}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding #Root.((vm:FlashcardCardEditorViewModel)DataContext).AttachmentFigureHint}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFadedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="15"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                                                            <Button Classes="ce-link"
                                                                    Content="{Binding #Root.((vm:FlashcardCardEditorViewModel)DataContext).ReplaceText}"
                                                                    Command="{Binding ReplaceCommand}"/>
                                                            <Button Classes="ce-link destructive"
                                                                    Content="{Binding #Root.((vm:FlashcardCardEditorViewModel)DataContext).RemoveText}"
                                                                    Command="{Binding RemoveCommand}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- BACK -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="ce-micro-label" Text="{Binding BackLabel}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                        IsVisible="{Binding IsBackFocused}">
                                <Button Classes="ce-fmt" Content="B" FontFamily="{DynamicResource Font.SemiBold}"
                                        ToolTip.Tip="{Binding BoldTooltip}"
                                        Click="OnBackBoldClick"/>
                                <Button Classes="ce-fmt" Content="I" FontStyle="Italic"
                                        ToolTip.Tip="{Binding ItalicTooltip}"
                                        Click="OnBackItalicClick"/>
                                <Button Classes="ce-fmt" Content="[…]"
                                        IsVisible="{Binding IsCloze}"
                                        ToolTip.Tip="{Binding ClozeWrapTooltip}"
                                        Click="OnBackClozeClick"/>
                                <Border Width="1" Height="16" Margin="4,0"
                                        Background="{DynamicResource DividerSubtleBrush}"
                                        VerticalAlignment="Center"/>
                                <Button Classes="ce-fmt"
                                        IsVisible="{Binding CanAddBackAttachment}"
                                        ToolTip.Tip="{Binding ImageTooltip}"
                                        Click="OnBackImageClick">
                                    <controls:AppIcon Icon="FormattingToolbar/polaroid" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Classes="ce-field" Classes.focused="{Binding IsBackFocused}"
                                DragDrop.AllowDrop="True">
                            <StackPanel Spacing="10">
                                <TextBox x:Name="BackInput" Classes="ce-input"
                                         Text="{Binding Back, Mode=TwoWay}"
                                         GotFocus="OnBackGotFocus"/>
                                <ItemsControl ItemsSource="{Binding BackAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FlashcardAttachmentItemViewModel">
                                            <Border Classes="ce-figure">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0"
                                                            Width="170" Height="104"
                                                            CornerRadius="{DynamicResource Radius.Md}"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding FilePath, Converter={StaticResource LocalPathToBitmapConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SizeLabel}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding #Root.((vm:FlashcardCardEditorViewModel)DataContext).AttachmentFigureHint}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFadedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="15"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                                                            <Button Classes="ce-link"
                                                                    Content="{Binding #Root.((vm:FlashcardCardEditorViewModel)DataContext).ReplaceText}"
                                                                    Command="{Binding ReplaceCommand}"/>
                                                            <Button Classes="ce-link destructive"
                                                                    Content="{Binding #Root.((vm:FlashcardCardEditorViewModel)DataContext).RemoveText}"
                                                                    Command="{Binding RemoveCommand}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding AttachmentsHint}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextFadedBrush}"/>

                    <!-- TAGS -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="ce-micro-label" Text="{Binding TagsLabel}"/>
                        <WrapPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FlashcardTagChipViewModel">
                                        <Border Classes="ce-tag" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Text}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Classes="ce-fmt" Width="16" Height="16" MinWidth="16" Padding="0"
                                                        Command="{Binding RemoveCommand}">
                                                    <controls:AppIcon Icon="Common/x" Width="10" Height="10"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- + Add dashed chip / inline input -->
                            <Border Classes="ce-tag-add" Margin="0,0,6,6"
                                    IsVisible="{Binding !IsAddingTag}"
                                    PointerPressed="OnAddTagPressed">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <controls:AppIcon Icon="Common/plus" Width="11" Height="11" Color="{DynamicResource TextFadedBrush}"/>
                                    <TextBlock Text="{Binding AddTagText}" FontSize="12"
                                               Foreground="{DynamicResource TextFadedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="TagInput"
                                     IsVisible="{Binding IsAddingTag}"
                                     Text="{Binding NewTagText, Mode=TwoWay}"
                                     PlaceholderText="{Binding TagPlaceholder}"
                                     Width="150" Height="26" MinHeight="26"
                                     Padding="8,0"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,6,6"
                                     KeyDown="OnTagInputKeyDown"
                                     LostFocus="OnTagInputLostFocus"/>
                        </WrapPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                    Padding="20,12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding SessionAddedText}"
                               IsVisible="{Binding IsAddMode}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFadedBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <controls:AppButton Classes="outline"
                                            Content="{Binding CloseText}"
                                            Height="34"
                                            Padding="16,0"
                                            Command="{Binding CloseCommand}"/>
                        <controls:AppButton Classes="accent"
                                            Height="34"
                                            Padding="16,0"
                                            Command="{Binding PrimaryCommand}"
                                            IsEnabled="{Binding CanSave}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PrimaryShortcutHint}"
                                           IsVisible="{Binding IsAddMode}"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           FontSize="11"
                                           Opacity="0.75"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </controls:AppButton>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
