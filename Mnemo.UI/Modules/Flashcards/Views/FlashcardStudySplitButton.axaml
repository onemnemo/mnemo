<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:markup="using:Mnemo.UI.Markup"
             xmlns:views="using:Mnemo.UI.Modules.Flashcards.Views"
             x:Class="Mnemo.UI.Modules.Flashcards.Views.FlashcardStudySplitButton"
             x:CompileBindings="True"
             x:DataType="views:FlashcardStudySplitButton"
             x:Name="root"
             Classes.study-full="{Binding !Compact, ElementName=root}"
             Classes.study-compact="{Binding Compact, ElementName=root}"
             HorizontalAlignment="Left"
             VerticalAlignment="Center">

    <UserControl.Resources>
        <!-- Divider between the primary/chevron segments: fixed white-alpha on the accent block,
             identical across all four themes (same category as FloatingChrome's theme-independent
             white overlays) - no semantic ramp token exists for "divider on an accent surface". -->
        <SolidColorBrush x:Key="StudySplitButtonDividerBrush" Color="#40FFFFFF" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Segments share a flat, borderless accent block; only corner radii differ per side -->
        <Style Selector="Button.study-segment">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.study-segment:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOverBrush}" />
        </Style>
        <Style Selector="Button.study-segment:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
        </Style>

        <!-- Chevron segment sits a shade darker than the primary segment at rest, so the two
             segments read as a single split button instead of one flat block. -->
        <Style Selector="Button.study-chevron /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
        </Style>
        <Style Selector="Button.study-chevron:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
        </Style>

        <!-- Only the outer corners round (6 = Radius.Sm); the shared edge between segments stays
             square so the pill reads as one continuous shape, not two overlapping rounded rects. -->
        <Style Selector="Button.study-primary /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="6,0,0,6" />
        </Style>
        <Style Selector="Button.study-chevron /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="0,6,6,0" />
        </Style>

        <!-- Full (deck header) sizing -->
        <Style Selector=":is(UserControl).study-full Button.study-primary">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector=":is(UserControl).study-full Button.study-chevron">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector=":is(UserControl).study-full controls|AppIcon.study-icon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>

        <!-- Compact (library row hover) sizing - 28px tall -->
        <Style Selector=":is(UserControl).study-compact Button.study-primary">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector=":is(UserControl).study-compact Button.study-chevron">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style Selector=":is(UserControl).study-compact controls|AppIcon.study-icon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector=":is(UserControl).study-compact TextBlock.study-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="{DynamicResource Radius.Sm}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,Auto,Auto">

            <!-- Primary: always starts Review immediately -->
            <Button Grid.Column="0"
                    Classes="study-segment study-primary"
                    Click="OnPrimaryClick"
                    ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyStartReviewTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <controls:AppIcon Icon="Common/play" Classes="study-icon" Color="{DynamicResource AccentButtonForegroundBrush}" />
                    <TextBlock Classes="study-label" Text="{markup:T Ns=Flashcards, Key=Study}"
                               Foreground="{DynamicResource AccentButtonForegroundBrush}"
                               FontFamily="{DynamicResource Font.Medium}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 1px divider between segments -->
            <Border Grid.Column="1" Width="1" Background="{StaticResource StudySplitButtonDividerBrush}" Margin="0,5" />

            <!-- Chevron: opens the 12b flyout -->
            <Button x:Name="ChevronButton"
                    Grid.Column="2"
                    Classes="study-segment study-chevron"
                    ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyModesTooltip}">
                <controls:AppIcon Icon="Common/chevron-down" Classes="study-icon" Color="{DynamicResource AccentButtonForegroundBrush}" />

                <Button.Flyout>
                    <!-- Counts/pre-highlight are pushed in from code-behind on Opening - cross-popup
                         bindings into MenuItems don't resolve here (established gotcha), so this flyout
                         carries no bindings at all, only static structure synced imperatively. -->
                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnFlyoutOpening">
                        <MenuItem x:Name="ReviewMenuItem"
                                  Header="{markup:T Ns=Flashcards, Key=SessionReview}"
                                  Click="OnReviewClick"
                                  controls:MenuItemGestureHint.GestureHint="{markup:T Ns=Flashcards, Key=StudyMenuHintReview}">
                            <MenuItem.Icon>
                                <controls:AppIcon Icon="Common/play" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator />

                        <MenuItem Header="{markup:T Ns=Flashcards, Key=StudyPracticeSectionHeader}" Classes="section-header" />

                        <MenuItem x:Name="CramMenuItem"
                                  Header="{markup:T Ns=Flashcards, Key=SessionCram}"
                                  controls:MenuItemGestureHint.GestureHint="{markup:T Ns=Flashcards, Key=StudyMenuHintCram}">
                            <MenuItem.Icon>
                                <controls:AppIcon Icon="Common/repeat" Width="16" Height="16" />
                            </MenuItem.Icon>
                            <MenuItem Header="{markup:T Ns=Flashcards, Key=StudyCramSectionHeader}" Classes="section-header" />
                            <MenuItem x:Name="CramDueMenuItem"
                                      Header="{markup:T Ns=Flashcards, Key=StudyCramDueCards}"
                                      Click="OnCramDueClick" />
                            <MenuItem x:Name="CramAllMenuItem"
                                      Header="{markup:T Ns=Flashcards, Key=StudyCramAllCards}"
                                      Click="OnCramAllClick" />
                        </MenuItem>

                        <MenuItem Header="{markup:T Ns=Flashcards, Key=SessionTest}"
                                  Click="OnTestClick"
                                  controls:MenuItemGestureHint.GestureHint="{markup:T Ns=Flashcards, Key=StudyMenuHintTest}">
                            <MenuItem.Icon>
                                <controls:AppIcon Icon="Common/pencil" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Border>
</UserControl>
