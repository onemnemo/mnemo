<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mnemo.UI.Modules.Flashcards.ViewModels"
             xmlns:views="using:Mnemo.UI.Modules.Flashcards.Views"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:conv="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="Mnemo.UI.Modules.Flashcards.Views.FlashcardTestView"
             x:DataType="vm:FlashcardTestViewModel"
             x:CompileBindings="True"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Focusable="True"
             x:Name="root">

    <UserControl.Resources>
        <conv:LocalPathToBitmapConverter x:Key="LocalPathToBitmapConverter" />
        <conv:BoolToBrushConverter x:Key="FlagColorConverter"
                                   TrueBrush="{DynamicResource AccentBrush}"
                                   FalseBrush="{DynamicResource TextTertiaryBrush}" />

        <!-- Framed attachment figure / carousel (single figure or compact prev/next) -->
        <DataTemplate x:Key="FigureTemplate" DataType="vm:FlashcardAttachmentCarousel">
            <StackPanel Spacing="6" Width="230">
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasMultiple}">
                    <Button Grid.Column="0" Classes="carousel-nav" Command="{Binding PreviousCommand}">
                        <controls:AppIcon Icon="Common/chevron-left" Width="14" Height="14"
                                          Color="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding PositionLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Monospace}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Grid.Column="2" Classes="carousel-nav" Command="{Binding NextCommand}">
                        <controls:AppIcon Icon="Common/chevron-right" Width="14" Height="14"
                                          Color="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
                <Border Classes="figure" Tapped="OnFigureTapped">
                    <Image MaxHeight="220" Stretch="Uniform"
                           Source="{Binding CurrentPath, Converter={StaticResource LocalPathToBitmapConverter}}" />
                </Border>
                <TextBlock Text="{Binding CurrentCaption}" IsVisible="{Binding HasCaption}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Top bar surface -->
        <Style Selector="Border.topbar">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- Icon button (close, session-settings, card actions) -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>
        <Style Selector="Button.icon-btn:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Amber "Test · practice only" chip -->
        <Style Selector="Border.mode-chip">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ToastIconBadgeWarningBrush}" />
        </Style>
        <Style Selector="Border.mode-chip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        </Style>

        <!-- Live counters (mono; green/amber/red) -->
        <Style Selector="TextBlock.counter">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.counter.gotit">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardRetentionHighBrush}" />
        </Style>
        <Style Selector="TextBlock.counter.close">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="TextBlock.counter.missed">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.progress-count">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Card surface -->
        <Style Selector="Border.card-surface">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}" />
            <Setter Property="Width" Value="780" />
            <Setter Property="MinHeight" Value="320" />
            <Setter Property="MaxHeight" Value="600" />
            <Setter Property="BoxShadow" Value="0 16 40 -24 #40000000" />
        </Style>

        <!-- Micro label between hairlines ("— YOUR ANSWER —") -->
        <Style Selector="TextBlock.answer-label">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
        </Style>

        <!-- Card action icon buttons (edit / flag / undo) -->
        <Style Selector="Button.card-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.card-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        </Style>
        <Style Selector="Button.card-action:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>

        <!-- Typed answer input (before reveal) -->
        <Style Selector="TextBox.answer-input">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        </Style>

        <!-- Read-only typed answer (after reveal): soft-tinted box in the same slot -->
        <Style Selector="Border.answer-echo">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!-- Grade buttons (Missed / Close / Got it) -->
        <Style Selector="Button.grade">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Missed: red-tint outline -->
        <Style Selector="Button.grade.missed">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.grade.missed TextBlock.grade-label">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.grade.missed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}" />
        </Style>
        <!-- Close: amber-tint outline -->
        <Style Selector="Button.grade.close">
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="Button.grade.close TextBlock.grade-label">
            <Setter Property="Foreground" Value="{DynamicResource FlashcardStateLearningBrush}" />
        </Style>
        <Style Selector="Button.grade.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToastIconBadgeWarningBrush}" />
        </Style>
        <!-- Got it: green filled -->
        <Style Selector="Button.grade.gotit">
            <Setter Property="Background" Value="{DynamicResource FlashcardRetentionHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardRetentionHighBrush}" />
        </Style>
        <Style Selector="Button.grade.gotit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FlashcardRetentionHighHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardRetentionHighHoverBrush}" />
        </Style>
        <Style Selector="Button.grade.gotit TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.grade TextBlock.grade-label">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.grade TextBlock.grade-key">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Keyboard hint chips -->
        <Style Selector="Border.kbd">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.kbd TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint-text">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Attachment figure -->
        <Style Selector="Border.figure">
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="Button.carousel-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
        </Style>

        <!-- Score screen -->
        <Style Selector="TextBlock.score-big">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="FontSize" Value="64" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.score-count">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource WidgetBackgroundPrimaryBrush}" />
        </Style>
        <Style Selector="Border.score-count TextBlock.num">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        </Style>
        <Style Selector="Border.score-count TextBlock.lbl">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Top bar ===== -->
        <Border Grid.Row="0" Classes="topbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <!-- Close -->
                <Button Grid.Column="0" Classes="icon-btn"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyClose}">
                    <controls:AppIcon Icon="Common/x" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <!-- Deck name -->
                <TextBlock Grid.Column="1" Text="{Binding DeckName}"
                           FontFamily="{DynamicResource Font.Medium}"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240" />

                <!-- Amber "Test · practice only" chip -->
                <Border Grid.Column="2" Classes="mode-chip">
                    <TextBlock Text="{markup:T Ns=Flashcards, Key=TestModeChip}" />
                </Border>

                <!-- Live counters (green/amber/red) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsActive}">
                    <TextBlock Classes="counter gotit" Text="{Binding GotItTally}" IsVisible="{Binding HasGotIt}"
                               ToolTip.Tip="{markup:T Ns=Flashcards, Key=GradeGotIt}" />
                    <TextBlock Classes="counter close" Text="{Binding CloseTally}" IsVisible="{Binding HasClose}"
                               ToolTip.Tip="{markup:T Ns=Flashcards, Key=TestGradeClose}" />
                    <TextBlock Classes="counter missed" Text="{Binding MissedTally}" IsVisible="{Binding HasMissed}"
                               ToolTip.Tip="{markup:T Ns=Flashcards, Key=TestGradeMissed}" />
                </StackPanel>

                <!-- Amber progress bar -->
                <Border Grid.Column="5" Width="160" Height="4" CornerRadius="2" ClipToBounds="True"
                        Background="{DynamicResource WidgetBackgroundPrimaryBrush}"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsActive}">
                    <Border HorizontalAlignment="Left" CornerRadius="2"
                            Background="{DynamicResource FlashcardStateLearningBrush}"
                            Width="{Binding ProgressFillWidth}" />
                </Border>

                <!-- Done / total -->
                <TextBlock Grid.Column="6" Classes="progress-count" Text="{Binding ProgressText}"
                           IsVisible="{Binding IsActive}" />

                <!-- Session settings -->
                <Button Grid.Column="7" Classes="icon-btn"
                        Click="OnSessionSettingsClick"
                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=ReviewSettingsMenu}">
                    <controls:AppIcon Icon="Flyout/settings" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Panel Grid.Row="1">

            <!-- Loading -->
            <TextBlock IsVisible="{Binding IsLoading}"
                       Text="{markup:T Ns=Flashcards, Key=StudyLoading}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Nothing to test (0 active cards) -->
            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="16" MaxWidth="420"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:AppIcon Icon="Common/file-text" Width="52" Height="52"
                                  Color="{DynamicResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                <TextBlock Text="{markup:T Ns=Flashcards, Key=TestEmptyTitle}"
                           FontSize="{DynamicResource FontSize.Heading3}"
                           FontFamily="{DynamicResource Font.SemiBold}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{markup:T Ns=Flashcards, Key=TestEmptyDesc}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <controls:AppButton Classes="accent" HorizontalAlignment="Center"
                                    Command="{Binding BackToDeckCommand}"
                                    Content="{markup:T Ns=Flashcards, Key=BackToDeck}" />
            </StackPanel>

            <!-- ===== End-of-session score screen ===== -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsComplete}">
                <StackPanel Margin="24" Spacing="20" MaxWidth="440"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{markup:T Ns=Flashcards, Key=TestScoreTitle}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextFadedBrush}"
                               LetterSpacing="1.2"
                               HorizontalAlignment="Center" />

                    <TextBlock Classes="score-big" Text="{Binding ScorePercentText}" />

                    <!-- Better / worse / first-attempt line -->
                    <TextBlock Text="{Binding DeltaText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" />

                    <!-- Score trend sparkline -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasTrend}" HorizontalAlignment="Center">
                        <TextBlock Text="{markup:T Ns=Flashcards, Key=TestTrendLabel}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <controls:TrendSparkline Width="240" Height="48"
                                                 Values="{Binding TrendScores}"
                                                 LineBrush="{DynamicResource FlashcardStateLearningBrush}"
                                                 DotBrush="{DynamicResource AccentBrush}" />
                    </StackPanel>

                    <!-- Best score -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                IsVisible="{Binding HasBestScore}">
                        <TextBlock Text="{markup:T Ns=Flashcards, Key=TestBestLabel}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body.Small}" />
                        <TextBlock Text="{Binding BestScoreText}"
                                   FontFamily="{DynamicResource Font.SemiBold}"
                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                   Foreground="{DynamicResource FlashcardRetentionHighBrush}" />
                    </StackPanel>

                    <!-- Got it / Close / Missed count row -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Border Classes="score-count">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="num" Text="{Binding FinalGotIt}"
                                           Foreground="{DynamicResource FlashcardRetentionHighBrush}" />
                                <TextBlock Classes="lbl" Text="{markup:T Ns=Flashcards, Key=GradeGotIt}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="score-count">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="num" Text="{Binding FinalClose}"
                                           Foreground="{DynamicResource FlashcardStateLearningBrush}" />
                                <TextBlock Classes="lbl" Text="{markup:T Ns=Flashcards, Key=TestGradeClose}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="score-count">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="num" Text="{Binding FinalMissed}"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Classes="lbl" Text="{markup:T Ns=Flashcards, Key=TestGradeMissed}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <controls:AppButton Classes="accent" HorizontalAlignment="Center"
                                        Command="{Binding BackToDeckCommand}"
                                        Content="{markup:T Ns=Flashcards, Key=BackToDeck}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Active card ===== -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsActive}">
                <StackPanel Margin="24" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Card -->
                    <Border Classes="card-surface" x:Name="CardSurface">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Top-right actions -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2"
                                        HorizontalAlignment="Right" Margin="0,10,10,0">
                                <Button Classes="card-action"
                                        Command="{Binding EditCommand}"
                                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyEdit}">
                                    <controls:AppIcon Icon="Flyout/rename" Width="15" Height="15"
                                                      Color="{DynamicResource TextTertiaryBrush}" />
                                </Button>
                                <Button Classes="card-action"
                                        Command="{Binding FlagCommand}"
                                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyFlag}">
                                    <controls:AppIcon Icon="Common/flag" Width="15" Height="15"
                                                      Color="{Binding IsFlagged, Converter={StaticResource FlagColorConverter}}" />
                                </Button>
                                <Button Classes="card-action"
                                        Command="{Binding UndoCommand}"
                                        ToolTip.Tip="{markup:T Ns=Flashcards, Key=StudyUndo}">
                                    <controls:AppIcon Icon="Common/undo" Width="15" Height="15"
                                                      Color="{DynamicResource TextTertiaryBrush}" />
                                </Button>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto" Padding="34,4,34,30">
                                <StackPanel Spacing="0">
                                    <!-- Front (markdown; cloze masked upstream) -->
                                    <components:MarkdownView Source="{Binding FrontText}"
                                                             Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <!-- "— YOUR ANSWER —" divider -->
                                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,22,0,10">
                                        <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                                                Background="{DynamicResource BorderBrush}" />
                                        <TextBlock Grid.Column="1" Classes="answer-label"
                                                   Text="{markup:T Ns=Flashcards, Key=TestYourAnswerLabel}" />
                                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                                Background="{DynamicResource BorderBrush}" />
                                    </Grid>

                                    <!-- Typed answer input (before reveal) -->
                                    <TextBox x:Name="AnswerInput" Classes="answer-input"
                                             IsVisible="{Binding !IsRevealed}"
                                             Text="{Binding TypedAnswer, Mode=TwoWay}"
                                             PlaceholderText="{markup:T Ns=Flashcards, Key=TestAnswerPlaceholder}"
                                             KeyDown="OnAnswerKeyDown" />

                                    <!-- Read-only echo of the typed answer (after reveal), same slot -->
                                    <Border Classes="answer-echo" IsVisible="{Binding IsRevealed}">
                                        <TextBlock Text="{Binding TypedAnswer}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>

                                    <!-- Correct answer (after reveal) -->
                                    <StackPanel Spacing="14" IsVisible="{Binding IsRevealed}">
                                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,22,0,4">
                                            <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                                                    Background="{DynamicResource BorderBrush}" />
                                            <TextBlock Grid.Column="1" Classes="answer-label"
                                                       Text="{markup:T Ns=Flashcards, Key=TestCorrectAnswerLabel}" />
                                            <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                                    Background="{DynamicResource BorderBrush}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <components:MarkdownView Grid.Column="0"
                                                                     Source="{Binding AnswerText}"
                                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                                     Margin="0,0,14,0" />
                                            <ContentControl Grid.Column="1"
                                                            Content="{Binding BackAttachments}"
                                                            IsVisible="{Binding BackAttachments.HasAny}"
                                                            VerticalAlignment="Top"
                                                            ContentTemplate="{StaticResource FigureTemplate}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Reveal affordance (before answer) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                IsVisible="{Binding !IsRevealed}">
                        <controls:AppButton Classes="secondary"
                                            Command="{Binding RevealCommand}"
                                            Content="{markup:T Ns=Flashcards, Key=TestReveal}" />
                        <Border Classes="kbd">
                            <TextBlock Text="{markup:T Ns=Flashcards, Key=StudyKeyEnter}" />
                        </Border>
                    </StackPanel>

                    <!-- Grade row (after reveal) -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsRevealed}">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Classes="grade missed" Command="{Binding GradeMissedCommand}">
                                <StackPanel>
                                    <TextBlock Classes="grade-label" Text="{markup:T Ns=Flashcards, Key=TestGradeMissed}" />
                                    <TextBlock Classes="grade-key" Text="1" />
                                </StackPanel>
                            </Button>
                            <Button Classes="grade close" Command="{Binding GradeCloseCommand}">
                                <StackPanel>
                                    <TextBlock Classes="grade-label" Text="{markup:T Ns=Flashcards, Key=TestGradeClose}" />
                                    <TextBlock Classes="grade-key" Text="2" />
                                </StackPanel>
                            </Button>
                            <Button Classes="grade gotit" Command="{Binding GradeGotItCommand}">
                                <StackPanel>
                                    <TextBlock Classes="grade-label" Text="{markup:T Ns=Flashcards, Key=GradeGotIt}" />
                                    <TextBlock Classes="grade-key" Text="⏎" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer keyboard hints -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Border Classes="kbd"><TextBlock Text="{markup:T Ns=Flashcards, Key=TestKeyGradeRange}" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=StudyHintGrade}" />
                        <TextBlock Classes="hint-text" Text="·" />
                        <Border Classes="kbd"><TextBlock Text="{markup:T Ns=Flashcards, Key=StudyKeyEnter}" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=TestHintGotIt}" />
                        <TextBlock Classes="hint-text" Text="·" />
                        <Border Classes="kbd"><TextBlock Text="E" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=StudyHintEdit}" />
                        <TextBlock Classes="hint-text" Text="·" />
                        <Border Classes="kbd"><TextBlock Text="{Binding UndoKeyLabel}" /></Border>
                        <TextBlock Classes="hint-text" Text="{markup:T Ns=Flashcards, Key=StudyHintUndo}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
