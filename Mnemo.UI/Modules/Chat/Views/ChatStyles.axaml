<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Mnemo.UI.Controls">

    <!--
        Shared styles for the Chat module (ChatView + ChatComposerView).

        The conversation is the page. Chrome around it stays flat and quiet: no card borders,
        no fills at rest, hierarchy carried by weight and text colour rather than containers.
        Vertical rhythm is the 8px scale (Space.* tokens); nothing here invents its own.
    -->

    <!-- Quiet 28px icon button (message actions, header actions, composer utilities) -->
    <Style Selector="Button.chatIconBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!-- Selected (e.g. an active thumbs vote): accent ink -->
        <Style Selector="^.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Style>

    <!-- Accent-filled pill button (Save & submit) -->
    <Style Selector="Button.chatAccentPillBtn">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonIconBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
    </Style>

    <!-- Ghost pill button (Cancel) -->
    <Style Selector="Button.chatGhostPillBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
    </Style>

    <!-- Landing quick-action pill: hairline at rest, accent ink on hover. No fill, these sit
         under the composer and must not compete with it. -->
    <Style Selector="Button.chatQuickPill">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Style>

    <!-- Assistant follow-up suggestion chip -->
    <Style Selector="Button.chatSuggestionChip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Style>

    <!-- Circular send / stop buttons. Disabled send keeps the white arrow on a washed accent
         fill (never a grayed ghost) so the affordance stays legible while input is empty. -->
    <Style Selector="Button.chatSendCircle">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBackgroundBrush}"/>
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBackgroundBrush}"/>
        </Style>
    </Style>
    <Style Selector="Button.chatStopCircle">
        <Setter Property="Background" Value="{DynamicResource StopButtonBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.92"/>
        </Style>
    </Style>

    <!-- ========================= COMPOSER TOOLBAR ========================= -->

    <!-- Composer shell: hairline at rest, the app's standard focused-input border while typing -->
    <Style Selector="Border.chatComposerShell">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.chatComposerShell:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}"/>
    </Style>

    <!-- Composer utility icon (attach, screenshot): smaller and quieter than a message action -->
    <Style Selector="Button.chatComposerTool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
    </Style>

    <!-- Web-search toggle: quiet text+icon at rest, accent ink and tint when armed -->
    <Style Selector="ToggleButton.chatComposerToggle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
    </Style>
    <Style Selector="ToggleButton.chatComposerToggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.chatComposerToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
    </Style>
    <!-- Declared after :pointerover so the armed tint survives hover -->
    <Style Selector="ToggleButton.chatComposerToggle:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton.chatComposerToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}"/>
    </Style>

    <!-- Response-length segments: a flat 3-way choice, no chrome except on the active one -->
    <Style Selector="RadioButton.chatSegment">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Caption}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_SegmentRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Border#PART_SegmentRoot">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        </Style>
    </Style>

    <!-- ========================= PROCESS TRACE ========================= -->

    <!-- Micro caps section label (SOURCES, sidebar day groups) -->
    <Style Selector="TextBlock.chatMicroCaps">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.CaptionButton}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        <Setter Property="LetterSpacing" Value="0.8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
    </Style>

    <!-- Spinner arc rotation (pair with States/spinner-track + States/spinner-arc).
         Type selectors match the exact type, so target AppIcon, not its SvgIcon base. -->
    <Style Selector="controls|AppIcon.ActiveSpin">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Shimmer placeholder bars: soft opacity breathing until the first token lands -->
    <Style Selector="Border.chatShimmerBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Thinking disclosure: one quiet line of text, not a card. It reports state and gets out of
         the way; the reasoning rail below it is opt-in. Sized to the text so the hit target ends
         where the label ends rather than spanning the column. -->
    <Style Selector="ToggleButton.chatThinkingToggle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="-6,0,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.chatThinkingToggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.chatThinkingToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Declared after :checked so hover wins in both open and closed states -->
    <Style Selector="ToggleButton.chatThinkingToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
    </Style>
    <Style Selector="ToggleButton.chatThinkingToggle TextBlock.label">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.chatThinkingToggle:pointerover TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.chatThinkingToggle controls|AppIcon.chevron">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
    </Style>
    <Style Selector="ToggleButton.chatThinkingToggle:checked controls|AppIcon.chevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)"/>
    </Style>

    <!-- Trace rail step label: faded when done, primary while active. Weight stays flat,
         the colour shift alone carries the state. -->
    <Style Selector="TextBlock.chatStepLabel">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.chatStepLabel.active">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Inline tool-call suffix chip: quiet by default, brightens on hover -->
    <Style Selector="ToggleButton.chatToolSuffix">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Caption}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Regular}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="^ TextBlock.failed">
            <Setter Property="Foreground" Value="{DynamicResource ChatProcessStateFailedGlyphBrush}"/>
        </Style>
    </Style>
    <Style Selector="ToggleButton.chatToolSuffix /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.chatToolSuffix:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.chatToolSuffix:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Scroll-to-latest: only affordance allowed to float over the thread, and only while
         the user is scrolled away from it. Flat fill, no shadow, no border. -->
    <Style Selector="Button.chatScrollFab">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
    </Style>

    <!-- Inline turn-failure notice (missing key, unavailable model, generic error). Flat tint,
         no border, it sits where the answer would be and reads as prose, not as a dialog. -->
    <Style Selector="Border.chatNoticeCard">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ========================= HISTORY SIDEBAR ========================= -->

    <!-- New chat: a quiet ghost row, accent reserved for the glyph alone -->
    <Style Selector="Button.chatNewChat">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Style>

    <Style Selector="Button.chatHistoryToggle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
    </Style>

    <Style Selector="Border.chatHistoryRow">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>

    <Style Selector="Button.chatHistoryRowSegment">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Style>

    <Style Selector="Button.chatHistoryMore">
        <Setter Property="Padding" Value="4,6,8,6"/>
        <Setter Property="MinWidth" Value="28"/>
    </Style>

</Styles>
