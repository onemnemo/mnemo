<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Chat.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:converters="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="700"
             x:Class="Mnemo.UI.Modules.Chat.Views.ChatComposerView"
             x:DataType="vm:ChatViewModel"
             x:Name="ComposerRoot">

    <UserControl.Resources>
        <converters:LocalPathToBitmapConverter x:Key="ComposerPathToBitmapConverter"/>
        <converters:ChatAttachmentKindToBoolConverter x:Key="ComposerAttachmentKindConverter"/>
        <converters:EqualsConverter x:Key="ComposerModeEqualsConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Mnemo.UI/Modules/Chat/Views/ChatStyles.axaml"/>
    </UserControl.Styles>

    <!-- Composer: a flat well, not a raised card. Every tool is on the surface — nothing
         hides behind a menu. ~64px at rest; the input grows from there. The border answers
         focus the way every other text control does. -->
    <Border Classes="chatComposerShell"
            Background="{DynamicResource SurfaceSubtleBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Xl}"
            Padding="6">
        <Grid RowDefinitions="Auto,Auto,Auto">

            <!-- Staged attachments -->
            <ItemsControl Grid.Row="0"
                          ItemsSource="{Binding PendingAttachments}"
                          IsVisible="{Binding !!PendingAttachments.Count}"
                          Margin="6,6,6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChatAttachmentViewModel">
                        <Panel Margin="0,4,8,4">
                            <!-- Image thumbnail -->
                            <Border Width="48" Height="48"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    ClipToBounds="True"
                                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    IsVisible="{Binding Kind, Converter={StaticResource ComposerAttachmentKindConverter}, ConverterParameter=Image}">
                                <Image Source="{Binding Path, Converter={StaticResource ComposerPathToBitmapConverter}}"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <!-- File chip -->
                            <Border Height="48"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    Padding="10,0,12,0"
                                    IsVisible="{Binding Kind, Converter={StaticResource ComposerAttachmentKindConverter}, ConverterParameter=File}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <controls:AppIcon Icon="Common/file-text"
                                                      Width="14" Height="14"
                                                      VerticalAlignment="Center"
                                                      Color="{DynamicResource TextFadedBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                   FontFamily="{DynamicResource Font.Medium}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeText}"
                                                   IsVisible="{Binding HasSizeText}"
                                                   FontSize="{DynamicResource FontSize.Body.Caption}"
                                                   Foreground="{DynamicResource TextFadedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Floating remove badge -->
                            <Button Width="16" Height="16"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Background="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Cursor="Hand"
                                    Command="{Binding RemoveCommand}"
                                    CommandParameter="{Binding}">
                                <controls:AppIcon Icon="Common/x"
                                                  Width="9" Height="9"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Color="{DynamicResource WorkspaceBackgroundBrush}"/>
                            </Button>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Input -->
            <TextBox x:Name="InputBox"
                     Grid.Row="1"
                     Classes="TransparentBackground"
                     PlaceholderText="{Binding #ComposerRoot.Placeholder}"
                     AcceptsReturn="False"
                     TextWrapping="Wrap"
                     MinHeight="28"
                     MaxHeight="180"
                     BorderThickness="0"
                     Background="{DynamicResource TextControlTransparentBackgroundBrush}"
                     FontSize="{DynamicResource FontSize.Body.Medium}"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,4"/>

            <!-- Toolbar: everything on one flat row -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,2,0,0">
                <Button Grid.Column="0"
                        Classes="chatComposerTool"
                        Click="AddAttachment_Click"
                        ToolTip.Tip="{markup:T Ns=Chat, Key=AddAttachment}">
                    <controls:AppIcon Icon="Common/paperclip" Width="15" Height="15"
                                      Color="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button Grid.Column="1"
                        Classes="chatComposerTool"
                        Click="AddScreenshot_Click"
                        ToolTip.Tip="{markup:T Ns=Chat, Key=AddScreenshot}">
                    <controls:AppIcon Icon="Common/camera" Width="15" Height="15"
                                      Color="{Binding $parent[Button].Foreground}"/>
                </Button>
                <ToggleButton Grid.Column="2"
                              Classes="chatComposerToggle"
                              Margin="2,0,0,0"
                              IsChecked="{Binding IsWebSearchEnabled, Mode=TwoWay}"
                              ToolTip.Tip="{markup:T Ns=Chat, Key=WebSearch}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:AppIcon Icon="Common/globe" Width="14" Height="14"
                                          VerticalAlignment="Center"
                                          Color="{Binding $parent[ToggleButton].Foreground}"/>
                        <TextBlock Text="{markup:T Ns=Chat, Key=WebSearch}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Response length: a flat 3-way choice. No GroupName — Avalonia scopes an
                     ungrouped RadioButton to its parent, keeping the landing and docked
                     composers independent. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="0"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip.Tip="{markup:T Ns=Chat, Key=AssistantMode}">
                    <RadioButton Classes="chatSegment"
                                 Content="{markup:T Ns=Chat, Key=AssistantModeShort}"
                                 IsChecked="{Binding SelectedAssistantMode, Mode=OneWay, Converter={StaticResource ComposerModeEqualsConverter}, ConverterParameter=Short}"
                                 Command="{Binding SetAssistantModeCommand}"
                                 CommandParameter="Short"/>
                    <RadioButton Classes="chatSegment"
                                 Content="{markup:T Ns=Chat, Key=AssistantModeNormal}"
                                 IsChecked="{Binding SelectedAssistantMode, Mode=OneWay, Converter={StaticResource ComposerModeEqualsConverter}, ConverterParameter=Normal}"
                                 Command="{Binding SetAssistantModeCommand}"
                                 CommandParameter="Normal"/>
                    <RadioButton Classes="chatSegment"
                                 Content="{markup:T Ns=Chat, Key=AssistantModeDetailed}"
                                 IsChecked="{Binding SelectedAssistantMode, Mode=OneWay, Converter={StaticResource ComposerModeEqualsConverter}, ConverterParameter=Detailed}"
                                 Command="{Binding SetAssistantModeCommand}"
                                 CommandParameter="Detailed"/>
                </StackPanel>

                <Panel Grid.Column="5" VerticalAlignment="Center">
                    <Button Classes="chatSendCircle"
                            Command="{Binding SendMessageCommand}"
                            IsVisible="{Binding !IsBusy}"
                            ToolTip.Tip="{markup:T Ns=Chat, Key=SendEnter}">
                        <controls:AppIcon Icon="Common/arrow-up"
                                          Width="15" Height="15"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Color="{DynamicResource AccentButtonIconBrush}"/>
                    </Button>
                    <Button Classes="chatStopCircle"
                            Command="{Binding StopCommand}"
                            IsVisible="{Binding IsBusy}"
                            ToolTip.Tip="{markup:T Ns=Chat, Key=Stop}">
                        <controls:AppIcon Icon="Common/stop"
                                          Width="13" Height="13"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Color="{DynamicResource StopButtonForegroundBrush}"/>
                    </Button>
                </Panel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
