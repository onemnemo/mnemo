<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Chat.ViewModels"
             xmlns:vmroot="using:Mnemo.UI.ViewModels"
             xmlns:views="using:Mnemo.UI.Modules.Chat.Views"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:converters="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Mnemo.UI.Modules.Chat.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             x:Name="ChatRoot">

    <UserControl.Resources>
        <converters:BoolToStreamingIntervalConverter x:Key="BoolToStreamingIntervalConverter"/>
        <converters:LocalPathToBitmapConverter x:Key="LocalPathToBitmapConverter"/>
        <converters:ChatAttachmentKindToBoolConverter x:Key="ChatAttachmentKindToBoolConverter"/>
        <converters:ChatViewModelDataContextCommandConverter x:Key="ChatViewModelDataContextCommandConverter"/>
        <converters:BoolToBrushConverter x:Key="ChatHistoryRowHoverBrushConverter"
                                         TrueBrush="{DynamicResource ListItemHoverBackgroundBrush}"
                                         FalseBrush="Transparent"/>
        <converters:BoolToDoubleConverter x:Key="BoolToDoubleConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Mnemo.UI/Modules/Chat/Views/ChatStyles.axaml"/>

        <!-- Hover-revealed message actions (space always reserved: no layout shift) -->
        <Style Selector="Grid.userTurn StackPanel.msgActions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.userTurn:pointerover StackPanel.msgActions">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- Assistant action bar: pinned on the latest answer, hover-revealed on earlier turns
             (same reserved-space pattern as user actions; .pinned wins by declaration order) -->
        <Style Selector="Grid.assistantTurn StackPanel.msgActions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.assistantTurn:pointerover StackPanel.msgActions">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="Grid.assistantTurn StackPanel.msgActions.pinned">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*">

        <!-- ===================== CHAT HISTORY SIDEBAR ===================== -->
        <Border Grid.Column="0"
                Width="{Binding ChatHistorySidebarWidth}"
                MinWidth="48"
                BorderBrush="{DynamicResource DividerSubtleBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource SidebarBackgroundBrush}">
            <Panel>
                <!-- Collapsed rail -->
                <StackPanel Margin="0,12,0,0"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding !IsChatHistorySidebarOpen}">
                    <Button Classes="chatHistoryToggle"
                            Command="{Binding ToggleChatHistorySidebarCommand}"
                            ToolTip.Tip="{markup:T Ns=Notes, Key=ToggleSidebar}">
                        <controls:AppIcon Icon="Common/layout-sidebar"
                                          Width="16" Height="16"
                                          Color="{DynamicResource TextFadedBrush}"/>
                    </Button>
                    <Button Classes="chatHistoryToggle"
                            Command="{Binding NewChatCommand}"
                            ToolTip.Tip="{markup:T Ns=Chat, Key=NewChat}">
                        <controls:AppIcon Icon="Common/plus"
                                          Width="16" Height="16"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Expanded -->
                <Grid RowDefinitions="Auto,Auto,*"
                      Margin="8,12,8,8"
                      IsVisible="{Binding IsChatHistorySidebarOpen}">
                    <!-- Header: the pane's own control, not a brand slot. The app already says who it is. -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{markup:T Ns=Chat, Key=ChatHistory}"
                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                   FontFamily="{DynamicResource Font.Medium}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="chatHistoryToggle"
                                Padding="5"
                                Command="{Binding ToggleChatHistorySidebarCommand}"
                                ToolTip.Tip="{markup:T Ns=Notes, Key=ToggleSidebar}">
                            <controls:AppIcon Icon="Common/layout-sidebar"
                                              Width="16" Height="16"
                                              Color="{DynamicResource TextFadedBrush}"/>
                        </Button>
                    </Grid>
                    <!-- New chat -->
                    <Button Grid.Row="1"
                            Classes="chatNewChat"
                            Command="{Binding NewChatCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:AppIcon Icon="Common/plus"
                                              Width="14" Height="14"
                                              VerticalAlignment="Center"
                                              Color="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{markup:T Ns=Chat, Key=NewChat}"
                                       FontFamily="{DynamicResource Font.Medium}"
                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Day-grouped sessions -->
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ConversationRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ChatConversationRowViewModel">
                                    <StackPanel>
                                        <TextBlock Classes="chatMicroCaps"
                                                   Text="{Binding SectionLabel}"
                                                   IsVisible="{Binding ShowSectionLabel}"
                                                   Margin="8,16,8,4"/>
                                        <Panel>
                                            <Border IsVisible="{Binding IsSelected}"
                                                    CornerRadius="{StaticResource Radius.Md}"
                                                    Background="{DynamicResource CardBackgroundSecondaryBrush}"/>
                                            <Border Classes="chatHistoryRow"
                                                    MinWidth="0"
                                                    Background="{Binding IsRowHovered, Converter={StaticResource ChatHistoryRowHoverBrushConverter}}">
                                                <Grid ColumnDefinitions="*,Auto" MinWidth="0">
                                                    <Button Grid.Column="0"
                                                            Classes="chatHistoryRowSegment"
                                                            Command="{Binding SelectCommand}"
                                                            Padding="8,6,4,6"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            PointerEntered="ChatHistoryRowSegment_PointerEntered"
                                                            PointerExited="ChatHistoryRowSegment_PointerExited">
                                                        <Button.IsEnabled>
                                                            <Binding ElementName="ChatRoot" Path="HistoryNavigationEnabled"/>
                                                        </Button.IsEnabled>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Classes="chatHistoryRowSegment chatHistoryMore"
                                                            Opacity="{Binding IsRowHovered, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter=1|0}"
                                                            ToolTip.Tip="{markup:T Ns=Chat, Key=MoreChatActions}"
                                                            PointerEntered="ChatHistoryRowSegment_PointerEntered"
                                                            PointerExited="ChatHistoryRowSegment_PointerExited">
                                                        <Button.IsEnabled>
                                                            <Binding ElementName="ChatRoot" Path="HistoryNavigationEnabled"/>
                                                        </Button.IsEnabled>
                                                        <controls:AppIcon Icon="Common/dots-vertical-filled"
                                                                          Width="14" Height="14"
                                                                          Color="{DynamicResource TextFadedBrush}"/>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="{markup:T Ns=Notes, Key=Rename}">
                                                                    <MenuItem.Command>
                                                                        <Binding ElementName="ChatRoot" Path="DataContext" Converter="{StaticResource ChatViewModelDataContextCommandConverter}" ConverterParameter="RenameChat"/>
                                                                    </MenuItem.Command>
                                                                    <MenuItem.CommandParameter>
                                                                        <Binding Path="ConversationId"/>
                                                                    </MenuItem.CommandParameter>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="{markup:T Ns=Notes, Key=Delete}">
                                                                    <MenuItem.Command>
                                                                        <Binding ElementName="ChatRoot" Path="DataContext" Converter="{StaticResource ChatViewModelDataContextCommandConverter}" ConverterParameter="DeleteChat"/>
                                                                    </MenuItem.Command>
                                                                    <MenuItem.CommandParameter>
                                                                        <Binding Path="ConversationId"/>
                                                                    </MenuItem.CommandParameter>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Panel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Panel>
        </Border>

        <!-- ===================== MAIN ===================== -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">

            <!-- Center area: landing OR conversation -->
            <Panel Grid.Row="0">

                <!-- ===================== LANDING ===================== -->
                <ScrollViewer IsVisible="{Binding ShowWelcomeIntro}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                MaxWidth="700"
                                Margin="32,40,32,32">
                        <!-- Greeting carries the page; no brand lockup competing with it -->
                        <TextBlock Text="{Binding GreetingText}"
                                   FontSize="{DynamicResource FontSize.Heading3}"
                                   FontFamily="{DynamicResource Font.Medium}"
                                   LetterSpacing="-0.4"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding GreetingSubtitle}"
                                   FontSize="{DynamicResource FontSize.Body.Medium}"
                                   Foreground="{DynamicResource TextFadedBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Composer -->
                        <views:ChatComposerView Margin="0,24,0,0"
                                                Placeholder="{markup:T Ns=Chat, Key=LandingPlaceholder}"/>

                        <!-- Quick actions -->
                        <ItemsControl ItemsSource="{Binding LandingQuickActions}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ChatLandingSuggestionViewModel">
                                    <Button Classes="chatQuickPill"
                                            Margin="0,8,8,0"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding Prompt}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:AppIcon Icon="{Binding IconName}"
                                                              Width="13" Height="13"
                                                              VerticalAlignment="Center"
                                                              Color="{Binding $parent[Button].Foreground}"/>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                       FontFamily="{DynamicResource Font.Medium}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Disclaimer -->
                        <TextBlock Text="{markup:T Ns=Chat, Key=Disclaimer}"
                                   HorizontalAlignment="Center"
                                   FontSize="{DynamicResource FontSize.Body.Caption}"
                                   Foreground="{DynamicResource TextFadedBrush}"
                                   Margin="0,24,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== ACTIVE CONVERSATION ===================== -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding !ShowWelcomeIntro}">
                    <!-- Session header: title only, actions on hover-free demand. No divider —
                         the thread's own whitespace separates it. -->
                    <Grid Grid.Row="0" Height="44" Margin="24,0,16,0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ActiveConversationTitle}"
                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                   Foreground="{DynamicResource TextFadedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="chatIconBtn"
                                    Command="{Binding RenameChatCommand}"
                                    CommandParameter="{Binding ActiveConversationId}"
                                    ToolTip.Tip="{markup:T Ns=Chat, Key=RenameChat}">
                                <controls:AppIcon Icon="Common/pencil" Width="14" Height="14"
                                                  Color="{Binding $parent[Button].Foreground}"/>
                            </Button>
                            <Button Classes="chatIconBtn"
                                    ToolTip.Tip="{markup:T Ns=Chat, Key=MoreChatActions}">
                                <controls:AppIcon Icon="Common/ellipsis" Width="15" Height="15"
                                                  Color="{Binding $parent[Button].Foreground}"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{markup:T Ns=Notes, Key=Rename}"
                                                  Command="{Binding RenameChatCommand}"
                                                  CommandParameter="{Binding ActiveConversationId}"/>
                                        <Separator/>
                                        <MenuItem Header="{markup:T Ns=Notes, Key=Delete}"
                                                  Command="{Binding DeleteChatCommand}"
                                                  CommandParameter="{Binding ActiveConversationId}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Thread -->
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border MaxWidth="700" HorizontalAlignment="Stretch" MinWidth="0" Padding="24,8,24,16">
                            <StackPanel MinWidth="0">
                                <!-- ItemsRepeater virtualizes vertically; works correctly even inside ScrollViewer > StackPanel chain (unlike ItemsControl + VirtualizingStackPanel). -->
                                <ItemsRepeater x:Name="ChatMessagesRepeater"
                                               ItemsSource="{Binding Messages}"
                                               HorizontalAlignment="Stretch">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="24"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate DataType="vm:ChatMessageViewModel">
                                            <Panel MinWidth="0">

                                                <!-- ============ ASSISTANT TURN ============ -->
                                                <!-- No avatar: prose starts at the column edge so the answer
                                                     is the first thing the eye lands on. -->
                                                <Grid IsVisible="{Binding !IsUser}" MinWidth="0"
                                                      Classes="assistantTurn" Background="Transparent">
                                                    <StackPanel MinWidth="0">

                                                        <!-- Thinking: one quiet line, expandable -->
                                                        <StackPanel IsVisible="{Binding HasProcessThreadOrThoughts}">
                                                            <ToggleButton Classes="chatThinkingToggle"
                                                                          IsChecked="{Binding IsProcessThreadExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <!-- One 13px slot for both states, so the label doesn't shift
                                                                         when streaming ends. Done is a bare faded check — the
                                                                         header text already says the turn finished. -->
                                                                    <Panel Width="13" Height="13" VerticalAlignment="Center">
                                                                        <Panel IsVisible="{Binding IsStreaming}">
                                                                            <controls:AppIcon Icon="States/spinner-track"
                                                                                              Width="13" Height="13"
                                                                                              Color="{DynamicResource ChatProcessSpinnerTrackBrush}"/>
                                                                            <controls:AppIcon Classes="ActiveSpin"
                                                                                              Icon="States/spinner-arc"
                                                                                              Width="13" Height="13"
                                                                                              Color="{DynamicResource ChatProcessStateActiveBrush}"/>
                                                                        </Panel>
                                                                        <controls:AppIcon Icon="States/done-check"
                                                                                          Width="13" Height="13"
                                                                                          IsVisible="{Binding !IsStreaming}"
                                                                                          Color="{DynamicResource TextFadedBrush}"/>
                                                                    </Panel>
                                                                    <TextBlock Classes="label" VerticalAlignment="Center"><Run Text="{Binding ProcessHeaderText}"/><Run Text="{Binding ElapsedSuffixText}"/></TextBlock>
                                                                    <TextBlock Classes="label"
                                                                               Text="·"
                                                                               IsVisible="{Binding HasProcessSummary}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Classes="label"
                                                                               Text="{Binding ProcessSummaryText}"
                                                                               IsVisible="{Binding HasProcessSummary}"
                                                                               VerticalAlignment="Center"/>
                                                                    <controls:AppIcon Classes="chevron"
                                                                                      Icon="Common/chevron-down"
                                                                                      Width="12" Height="12"
                                                                                      Color="{DynamicResource TextFadedBrush}"
                                                                                      VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <!-- Reasoning rail: indented under the toggle, no container -->
                                                            <StackPanel IsVisible="{Binding IsProcessThreadExpanded}"
                                                                        Margin="0,8,0,0">
                                                                <!-- Thinking: reasoning text as the first rail row -->
                                                                <Grid ColumnDefinitions="14,*" IsVisible="{Binding IsThinking}">
                                                                    <Grid Grid.Column="0" RowDefinitions="Auto,*">
                                                                        <Panel Grid.Row="0" Width="14" Height="14" Margin="0,1,0,0">
                                                                            <Panel IsVisible="{Binding IsActivelyThinking}">
                                                                                <controls:AppIcon Icon="States/spinner-track"
                                                                                                  Width="14" Height="14"
                                                                                                  Color="{DynamicResource ChatProcessSpinnerTrackBrush}"/>
                                                                                <controls:AppIcon Classes="ActiveSpin"
                                                                                                  Icon="States/spinner-arc"
                                                                                                  Width="14" Height="14"
                                                                                                  Color="{DynamicResource ChatProcessStateActiveBrush}"/>
                                                                            </Panel>
                                                                            <!-- Done reads as a quiet faded check — colour in the rail is reserved
                                                                                 for live activity and failure. -->
                                                                            <controls:AppIcon Icon="States/done-check"
                                                                                              Width="14" Height="14"
                                                                                              IsVisible="{Binding HasFinishedThinking}"
                                                                                              Color="{DynamicResource TextFadedBrush}"/>
                                                                        </Panel>
                                                                        <Border Grid.Row="1" Width="1"
                                                                                Background="{DynamicResource DividerSubtleBrush}"
                                                                                Margin="0,4,0,4"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Stretch"
                                                                                IsVisible="{Binding HasProcessThread}"/>
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="1" MinWidth="0" Margin="8,0,0,8">
                                                                        <TextBlock Classes="chatStepLabel"
                                                                                   Classes.active="{Binding IsActivelyThinking}"
                                                                                   Text="{markup:T Ns=Chat, Key=ThinkingLabel}"/>
                                                                        <!-- Clamped 2-line summary of the reasoning — never the full chain-of-thought. -->
                                                                        <TextBlock Text="{Binding Thoughts}"
                                                                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                                                   Foreground="{DynamicResource TextFadedBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxLines="2"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   LineHeight="18"
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <ItemsControl ItemsSource="{Binding ProcessSteps}" IsVisible="{Binding HasProcessThread}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="vmroot:ChatProcessStepViewModel">
                                                                            <Grid ColumnDefinitions="14,*">
                                                                                <!-- State glyph (done / active / failed / pending) + connector -->
                                                                                <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,1,0,0">
                                                                                    <Panel Grid.Row="0" Width="14" Height="14">
                                                                                        <controls:AppIcon Icon="States/done-check"
                                                                                                          Width="14" Height="14"
                                                                                                          IsVisible="{Binding ShowDoneIcon}"
                                                                                                          Color="{DynamicResource TextFadedBrush}"/>
                                                                                        <Panel IsVisible="{Binding ShowActiveIcon}">
                                                                                            <controls:AppIcon Icon="States/spinner-track"
                                                                                                              Width="14" Height="14"
                                                                                                              Color="{DynamicResource ChatProcessSpinnerTrackBrush}"/>
                                                                                            <controls:AppIcon Classes="ActiveSpin"
                                                                                                              Icon="States/spinner-arc"
                                                                                                              Width="14" Height="14"
                                                                                                              Color="{DynamicResource ChatProcessStateActiveBrush}"/>
                                                                                        </Panel>
                                                                                        <Panel IsVisible="{Binding ShowFailedIcon}">
                                                                                            <controls:AppIcon Icon="States/done-disc"
                                                                                                              Width="14" Height="14"
                                                                                                              Color="{DynamicResource ChatProcessStateFailedFillBrush}"/>
                                                                                            <controls:AppIcon Icon="States/failed-x"
                                                                                                              Width="14" Height="14"
                                                                                                              Color="{DynamicResource ChatProcessStateFailedGlyphBrush}"/>
                                                                                        </Panel>
                                                                                        <controls:AppIcon Icon="States/pending"
                                                                                                          Width="14" Height="14"
                                                                                                          Color="{DynamicResource ChatProcessStatePendingBrush}"
                                                                                                          IsVisible="{Binding IsPending}"/>
                                                                                    </Panel>
                                                                                    <Border Grid.Row="1" Width="1"
                                                                                            Background="{DynamicResource DividerSubtleBrush}"
                                                                                            Margin="0,4,0,4"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Stretch"
                                                                                            IsVisible="{Binding !IsLast}"/>
                                                                                </Grid>
                                                                                <!-- Step content -->
                                                                                <StackPanel Grid.Column="1" MinWidth="0" Margin="8,0,0,8">
                                                                                    <!-- Narration: quiet quoted mid-turn prose, folded into the trace -->
                                                                                    <TextBlock IsVisible="{Binding IsNarration}"
                                                                                               Text="{Binding Narration}"
                                                                                               FontStyle="Italic"
                                                                                               FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                                                               Foreground="{DynamicResource TextFadedBrush}"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxLines="3"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               LineHeight="18"/>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                                                IsVisible="{Binding !IsNarration}">
                                                                                        <TextBlock Classes="chatStepLabel"
                                                                                                   Classes.active="{Binding IsActive}"
                                                                                                   Text="{Binding Label}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding Detail}"
                                                                                                   IsVisible="{Binding HasDetail}"
                                                                                                   FontSize="{DynamicResource FontSize.Body.Caption}"
                                                                                                   FontFamily="{DynamicResource Font.Monospace}"
                                                                                                   Foreground="{DynamicResource TextFadedBrush}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <!-- Inline tool-call suffixes; each toggles its own detail box below -->
                                                                                        <ItemsControl ItemsSource="{Binding ToolCalls}"
                                                                                                      IsVisible="{Binding HasToolCalls}"
                                                                                                      VerticalAlignment="Center">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate DataType="vmroot:ChatToolCallViewModel">
                                                                                                    <ToggleButton Classes="chatToolSuffix"
                                                                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                                                                  IsVisible="{Binding HasSummary}"
                                                                                                                  ToolTip.Tip="{Binding Name}">
                                                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                                            <TextBlock Text="·"/>
                                                                                                            <TextBlock Text="{Binding Summary}"
                                                                                                                       Classes.failed="{Binding IsFailed}"/>
                                                                                                        </StackPanel>
                                                                                                    </ToggleButton>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                    <!-- Per-tool details, expanded from the suffix chip -->
                                                                                    <ItemsControl ItemsSource="{Binding ToolCalls}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate DataType="vmroot:ChatToolCallViewModel">
                                                                                                <Border IsVisible="{Binding IsExpanded}"
                                                                                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                                                                                        CornerRadius="{StaticResource Radius.Sm}"
                                                                                                        Margin="0,8,0,0"
                                                                                                        Padding="10,8">
                                                                                                    <ScrollViewer MaxHeight="180"
                                                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                                                        <StackPanel Spacing="6">
                                                                                                            <TextBlock Text="{Binding Arguments}"
                                                                                                                       FontFamily="{DynamicResource Font.Monospace}"
                                                                                                                       FontSize="{DynamicResource FontSize.CaptionButton}"
                                                                                                                       Foreground="{DynamicResource TextFadedBrush}"
                                                                                                                       TextWrapping="Wrap"/>
                                                                                                            <TextBlock Text="{Binding Result}"
                                                                                                                       FontFamily="{DynamicResource Font.Monospace}"
                                                                                                                       FontSize="{DynamicResource FontSize.CaptionButton}"
                                                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                                                       TextWrapping="Wrap"/>
                                                                                                        </StackPanel>
                                                                                                    </ScrollViewer>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Shimmer skeleton until the first token -->
                                                        <StackPanel Spacing="8"
                                                                    Margin="0,8,0,0"
                                                                    IsVisible="{Binding IsAwaitingFirstToken}">
                                                            <Grid ColumnDefinitions="92*,8*">
                                                                <Border Grid.Column="0" Classes="chatShimmerBar"/>
                                                            </Grid>
                                                            <Border Classes="chatShimmerBar"/>
                                                            <Grid ColumnDefinitions="62*,38*">
                                                                <Border Grid.Column="0" Classes="chatShimmerBar"/>
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- Turn-failure notice: what went wrong + the way forward, inline where the answer would be -->
                                                        <Border Classes="chatNoticeCard"
                                                                IsVisible="{Binding IsErrorNotice}"
                                                                Margin="0,8,0,0">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <controls:AppIcon Grid.Column="0"
                                                                                  Icon="Common/triangle-alert"
                                                                                  Width="15" Height="15"
                                                                                  Margin="0,3,10,0"
                                                                                  VerticalAlignment="Top"
                                                                                  Color="{DynamicResource AccentBrush}"/>
                                                                <StackPanel Grid.Column="1" Spacing="12" MinWidth="0">
                                                                    <TextBlock Text="{Binding Content}"
                                                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               TextWrapping="Wrap"
                                                                               LineHeight="22"/>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Button Classes="chatAccentPillBtn"
                                                                                IsVisible="{Binding ShowOpenSettings}"
                                                                                Command="{Binding #ChatRoot.((vm:ChatViewModel)DataContext).OpenAiSettingsCommand}">
                                                                            <TextBlock Text="{markup:T Ns=Chat, Key=OpenSettings}" VerticalAlignment="Center"/>
                                                                        </Button>
                                                                        <Button Classes="chatGhostPillBtn"
                                                                                IsVisible="{Binding !ShowOpenSettings}"
                                                                                Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Regenerate}"
                                                                                CommandParameter="{Binding}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <controls:AppIcon Icon="Common/refresh" Width="12" Height="12"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Color="{Binding $parent[Button].Foreground}"/>
                                                                                <TextBlock Text="{markup:T Ns=Chat, Key=RetryTurn}" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Answer: 16px at 1.6 leading, the reading rhythm of the whole surface -->
                                                        <components:MarkdownView Source="{Binding Content}"
                                                                                 IsVisible="{Binding ShowAnswerBody}"
                                                                                 Margin="0,8,0,0"
                                                                                 FontSize="{DynamicResource FontSize.Body.Medium}"
                                                                                 ProseLineHeight="1.6"
                                                                                 RenderProfile="Conversation"
                                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                 StreamingUpdateIntervalMs="{Binding IsStreaming, Converter={StaticResource BoolToStreamingIntervalConverter}}"/>

                                                        <!-- Sources -->
                                                        <StackPanel Margin="0,16,0,0"
                                                                    IsVisible="{Binding Sources, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                            <TextBlock Classes="chatMicroCaps"
                                                                       Text="{markup:T Ns=Chat, Key=SourcesLabel}"
                                                                       Margin="0,0,0,8"/>
                                                            <ItemsControl ItemsSource="{Binding Sources}" MinWidth="0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                                                CornerRadius="{StaticResource Radius.Sm}"
                                                                                Padding="8,5"
                                                                                Margin="0,0,8,8">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <controls:AppIcon Icon="Common/globe"
                                                                                                  Width="12" Height="12"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Color="{DynamicResource TextFadedBrush}"/>
                                                                                <TextBlock Text="{Binding}"
                                                                                           FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           MaxWidth="240"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- Follow-up suggestions -->
                                                        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,8,0,0" HorizontalAlignment="Stretch" MinWidth="0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Classes="chatSuggestionChip" Margin="0,8,8,0"
                                                                            Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Suggestion}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="{Binding}"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Action bar: pinned on the latest answer, hover-revealed on earlier turns.
                                                             Pulled left by the icon button's 7px inset so the first glyph lines up
                                                             with the prose edge rather than the button box. -->
                                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="-7,8,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Classes="msgActions"
                                                                    Classes.pinned="{Binding IsLatestAssistantTurn}"
                                                                    Height="28"
                                                                    IsVisible="{Binding ShowActionBar}">
                                                            <Button Classes="chatIconBtn"
                                                                    Classes.active="{Binding IsThumbUp}"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=GoodResponse}"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=ThumbUp}"
                                                                    CommandParameter="{Binding}">
                                                                <controls:AppIcon Icon="Common/thumbs-up" Width="14" Height="14"
                                                                                  Color="{Binding $parent[Button].Foreground}"/>
                                                            </Button>
                                                            <Button Classes="chatIconBtn"
                                                                    Classes.active="{Binding IsThumbDown}"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=BadResponse}"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=ThumbDown}"
                                                                    CommandParameter="{Binding}">
                                                                <controls:AppIcon Icon="Common/thumbs-down" Width="14" Height="14"
                                                                                  Color="{Binding $parent[Button].Foreground}"/>
                                                            </Button>
                                                            <Button Classes="chatIconBtn"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=CopyMessage}"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Copy}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding HasCopiableAssistantContent}">
                                                                <controls:AppIcon Icon="Common/copy" Width="14" Height="14"
                                                                                  Color="{Binding $parent[Button].Foreground}"/>
                                                            </Button>
                                                            <Button Classes="chatIconBtn"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=Regenerate}"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Regenerate}"
                                                                    CommandParameter="{Binding}">
                                                                <controls:AppIcon Icon="Common/refresh" Width="14" Height="14"
                                                                                  Color="{Binding $parent[Button].Foreground}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- ============ USER TURN ============ -->
                                                <!-- Right-aligned, flat tint, no border, no avatar -->
                                                <Grid IsVisible="{Binding IsUser}" MinWidth="0"
                                                      Classes="userTurn" Background="Transparent">
                                                    <StackPanel HorizontalAlignment="Right" MinWidth="0">
                                                        <!-- Bubble -->
                                                        <Border HorizontalAlignment="Right"
                                                                MaxWidth="560"
                                                                CornerRadius="{StaticResource Radius.Xl}"
                                                                Padding="16,10"
                                                                Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                                                IsVisible="{Binding !IsEditing}">
                                                            <StackPanel Spacing="8">
                                                                <ItemsControl ItemsSource="{Binding Attachments}"
                                                                              IsVisible="{Binding HasAttachments}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="vm:ChatAttachmentViewModel">
                                                                            <Panel Margin="0,0,8,8">
                                                                                <!-- Image attachment (click to preview) -->
                                                                                <Button Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=OpenImagePreview}"
                                                                                        CommandParameter="{Binding Path}"
                                                                                        Background="Transparent"
                                                                                        BorderThickness="0"
                                                                                        Padding="0"
                                                                                        CornerRadius="{StaticResource Radius.Md}"
                                                                                        ClipToBounds="True"
                                                                                        Cursor="Hand"
                                                                                        IsVisible="{Binding Kind, Converter={StaticResource ChatAttachmentKindToBoolConverter}, ConverterParameter=Image}">
                                                                                    <Border CornerRadius="{StaticResource Radius.Md}"
                                                                                            ClipToBounds="True"
                                                                                            Background="{DynamicResource SurfaceSubtleBrush}">
                                                                                        <Image Source="{Binding Path, Converter={StaticResource LocalPathToBitmapConverter}}"
                                                                                               Stretch="Uniform"
                                                                                               MaxWidth="128"
                                                                                               MaxHeight="96"
                                                                                               MinWidth="32"
                                                                                               MinHeight="32"/>
                                                                                    </Border>
                                                                                </Button>
                                                                                <!-- File attachment -->
                                                                                <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                                                        CornerRadius="{StaticResource Radius.Md}"
                                                                                        Padding="8,6"
                                                                                        IsVisible="{Binding Kind, Converter={StaticResource ChatAttachmentKindToBoolConverter}, ConverterParameter=File}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                        <controls:AppIcon Icon="Common/file-text"
                                                                                                          Width="14" Height="14"
                                                                                                          VerticalAlignment="Center"
                                                                                                          Color="{DynamicResource TextFadedBrush}"/>
                                                                                        <StackPanel VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                                       FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                                                                       FontFamily="{DynamicResource Font.Medium}"
                                                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       MaxWidth="180"/>
                                                                                            <TextBlock Text="{Binding SizeText}"
                                                                                                       IsVisible="{Binding HasSizeText}"
                                                                                                       FontSize="{DynamicResource FontSize.Body.Caption}"
                                                                                                       Foreground="{DynamicResource TextFadedBrush}"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Panel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <!-- LineHeight matches assistant prose: 16px x 1.6 leading -->
                                                                <TextBlock Text="{Binding Content}"
                                                                           FontSize="{DynamicResource FontSize.Body.Medium}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="26"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Inline edit state -->
                                                        <Border IsVisible="{Binding IsEditing}"
                                                                HorizontalAlignment="Stretch"
                                                                MaxWidth="560"
                                                                CornerRadius="{StaticResource Radius.Lg}"
                                                                Background="{DynamicResource SurfaceSubtleBrush}"
                                                                BorderBrush="{DynamicResource AccentBrush}"
                                                                BorderThickness="1"
                                                                Padding="12,10">
                                                            <StackPanel Spacing="8">
                                                                <TextBox Classes="TransparentBackground"
                                                                         Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         AcceptsReturn="True"
                                                                         TextWrapping="Wrap"
                                                                         MinHeight="40"
                                                                         MaxHeight="180"
                                                                         BorderThickness="0"
                                                                         Background="{DynamicResource TextControlTransparentBackgroundBrush}"
                                                                         FontSize="{DynamicResource FontSize.Body.Small}"
                                                                         Padding="2"/>
                                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{markup:T Ns=Chat, Key=EditSendNote}"
                                                                               FontSize="{DynamicResource FontSize.Body.Caption}"
                                                                               Foreground="{DynamicResource TextFadedBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="1"
                                                                            Classes="chatGhostPillBtn"
                                                                            Margin="8,0,0,0"
                                                                            Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=CancelEdit}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="{markup:T Ns=Common, Key=Cancel}"/>
                                                                    </Button>
                                                                    <Button Grid.Column="2"
                                                                            Classes="chatAccentPillBtn"
                                                                            Margin="8,0,0,0"
                                                                            Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=SubmitEdit}"
                                                                            CommandParameter="{Binding}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <controls:AppIcon Icon="Common/check" Width="12" Height="12"
                                                                                              VerticalAlignment="Center"
                                                                                              Color="{DynamicResource AccentButtonIconBrush}"/>
                                                                            <TextBlock Text="{markup:T Ns=Chat, Key=SaveAndSubmit}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Hover actions (reserved height; fades in) -->
                                                        <StackPanel Classes="msgActions"
                                                                    Orientation="Horizontal" Spacing="2"
                                                                    HorizontalAlignment="Right"
                                                                    Height="28" Margin="0,4,-4,0"
                                                                    IsVisible="{Binding !IsEditing}">
                                                            <Button Classes="chatIconBtn"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Copy}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=CopyMessage}">
                                                                <controls:AppIcon Icon="Common/copy" Width="13" Height="13"
                                                                                  Color="{Binding $parent[Button].Foreground}"/>
                                                            </Button>
                                                            <Button Classes="chatIconBtn"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=BeginEdit}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=EditMessage}">
                                                                <controls:AppIcon Icon="Common/pencil" Width="13" Height="13"
                                                                                  Color="{Binding $parent[Button].Foreground}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- Scroll-to-latest, overlaid on the thread just above the composer -->
                    <Button Grid.Row="1"
                            Classes="chatScrollFab"
                            IsVisible="{Binding ShowScrollToBottomButton}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,8"
                            Command="{Binding ScrollToBottomCommand}"
                            ToolTip.Tip="{markup:T Ns=Chat, Key=ScrollToBottom}">
                        <controls:AppIcon Icon="Common/arrow-down" Width="14" Height="14"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Color="{Binding $parent[Button].Foreground}"/>
                    </Button>
                </Grid>
            </Panel>

            <!-- Bottom dock: composer + disclaimer -->
            <StackPanel Grid.Row="1" IsVisible="{Binding !ShowWelcomeIntro}" MinWidth="0">
                <views:ChatComposerView MaxWidth="700"
                                        Margin="24,0,24,0"
                                        Placeholder="{markup:T Ns=Chat, Key=FollowUpPlaceholder}"/>
                <TextBlock Text="{markup:T Ns=Chat, Key=Disclaimer}"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Body.Caption}"
                           Foreground="{DynamicResource TextFadedBrush}"
                           Margin="0,8,0,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
