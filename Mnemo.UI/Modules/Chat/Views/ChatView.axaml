<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Chat.ViewModels"
             xmlns:vmroot="using:Mnemo.UI.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:converters="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Mnemo.UI.Modules.Chat.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             x:Name="ChatRoot">

    <UserControl.Resources>
        <converters:BoolToStreamingIntervalConverter x:Key="BoolToStreamingIntervalConverter"/>
        <converters:NullToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>
        <converters:AssistantModeToLabelConverter x:Key="AssistantModeToLabelConverter"/>
        <converters:LocalPathToBitmapConverter x:Key="LocalPathToBitmapConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:ChatAttachmentKindToBoolConverter x:Key="ChatAttachmentKindToBoolConverter"/>
        <converters:ChatViewModelDataContextCommandConverter x:Key="ChatViewModelDataContextCommandConverter"/>
        <converters:BoolToBrushConverter x:Key="ChatHistoryRowHoverBrushConverter"
                                         TrueBrush="{DynamicResource ListItemHoverBackgroundBrush}"
                                         FalseBrush="Transparent"/>
        <converters:BoolToDoubleConverter x:Key="BoolToDoubleConverter"/>

        <!-- Shared composer attachment chip (used by both the landing and active composers) -->
        <DataTemplate x:Key="PendingAttachmentTemplate" DataType="vm:ChatAttachmentViewModel">
            <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,4"
                    Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="36" Height="36" CornerRadius="8"
                            ClipToBounds="True"
                            Background="{DynamicResource CardBackgroundPrimaryBrush}">
                        <Grid>
                            <Image Width="36" Height="36"
                                   Source="{Binding Path, Converter={StaticResource LocalPathToBitmapConverter}}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding Kind, Converter={StaticResource ChatAttachmentKindToBoolConverter}, ConverterParameter=Image}"/>
                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/file-text.svg"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Color="{DynamicResource TextSecondaryBrush}"
                                              IsVisible="{Binding Kind, Converter={StaticResource ChatAttachmentKindToBoolConverter}, ConverterParameter=File}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MaxWidth="120"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding}"
                            Classes="PromptActionButton"
                            Padding="2"
                            VerticalAlignment="Center">
                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/x.svg"
                                          Width="12" Height="12"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Assistant follow-up suggestion chip -->
        <Style Selector="Button.SuggestionChip">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Small}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextFadedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
        </Style>

        <!-- Landing suggestion card: colored icon + title + description -->
        <Style Selector="Button.SuggestionCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource TextFadedBrush}"/>
            </Style>
        </Style>

        <!-- Landing quick-action pill; the "primary" variant is the inverted/filled one -->
        <Style Selector="Button.QuickPill">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource TextFadedBrush}"/>
            </Style>
        </Style>
        <Style Selector="Button.QuickPill TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.QuickPill controls|SvgIcon">
            <Setter Property="Color" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.QuickPill.primary">
            <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style Selector="^:pointerover">
                <Setter Property="Opacity" Value="0.88"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
        </Style>
        <Style Selector="Button.QuickPill.primary TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.QuickPill.primary controls|SvgIcon">
            <Setter Property="Color" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.PromptActionButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            </Style>
        </Style>

        <!-- Icon + label ghost pill used in the composer toolbars (Attach) -->
        <Style Selector="Button.ToolbarPill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
            </Style>
        </Style>

        <!-- Toggle ghost pill (Web Search) -->
        <Style Selector="ToggleButton.ToolbarPill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.ToolbarPill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.ToolbarPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="ToggleButton.ToolbarPill:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardAccentBrush}"/>
        </Style>

        <Style Selector="controls|ModernComboBox.PromptPill">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.Caption}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.ScrollToBottomLink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.ScrollToBottomLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ScrollToBottomLink:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="controls|SvgIcon.ActiveSpin">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="controls|SvgIcon.ActivePulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                </Animation>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- White card "New Chat" button in the sidebar -->
        <Style Selector="Button.NewChatButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource TextFadedBrush}"/>
            </Style>
        </Style>

        <Style Selector="Border.chat-history-row">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <Style Selector="Button.chat-history-row-segment">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
        </Style>

        <Style Selector="Button.ChatHistoryToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
            </Style>
        </Style>

        <Style Selector="Button.chat-history-more">
            <Setter Property="Padding" Value="6,8,10,8"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>

        <Style Selector="Button.MessageActionIcon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.35"/>
            </Style>
        </Style>

        <!-- Process thread pill: white floating pill, collapsible -->
        <Style Selector="ToggleButton.ProcessPill">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.ProcessPill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.ProcessPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.ProcessPill:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextFadedBrush}"/>
        </Style>
        <Style Selector="ToggleButton.ProcessPill:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.ProcessPill controls|SvgIcon.chevron">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>
        <Style Selector="ToggleButton.ProcessPill:checked controls|SvgIcon.chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>

        <!-- Circular send / stop button -->
        <Style Selector="Button.SendCircle">
            <Setter Property="Background" Value="{DynamicResource CardAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Opacity" Value="0.92"/>
            </Style>
        </Style>
        <Style Selector="Button.StopCircle">
            <Setter Property="Background" Value="{DynamicResource StopButtonBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*">
        <!-- ===================== CHAT HISTORY SIDEBAR ===================== -->
        <Border Grid.Column="0"
                Width="{Binding ChatHistorySidebarWidth}"
                MinWidth="48"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource WorkspaceBackgroundBrush}">
            <Panel>
                <!-- Collapsed: narrow controls -->
                <StackPanel Margin="0,14,0,0"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding !IsChatHistorySidebarOpen}">
                    <Button Classes="ChatHistoryToggle"
                            Command="{Binding ToggleChatHistorySidebarCommand}"
                            ToolTip.Tip="{markup:T Ns=Notes, Key=ToggleSidebar}">
                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/layout-sidebar.svg"
                                          Width="20" Height="20"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Background="{DynamicResource CardAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="17"
                            Width="34" Height="34"
                            Padding="6"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Command="{Binding NewChatCommand}"
                            ToolTip.Tip="{markup:T Ns=Chat, Key=NewChat}">
                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/plus.svg"
                                          Width="18" Height="18"
                                          Color="{DynamicResource AccentButtonIconBrush}"/>
                    </Button>
                </StackPanel>
                <!-- Expanded -->
                <Grid RowDefinitions="Auto,Auto,Auto,*"
                      Margin="14,16,14,14"
                      IsVisible="{Binding IsChatHistorySidebarOpen}">
                    <!-- Brand row -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0,0,18">
                        <Border Grid.Column="0"
                                Width="20" Height="20" CornerRadius="10"
                                Background="{DynamicResource CardAccentBrush}"
                                VerticalAlignment="Center">
                            <Border Width="9" Height="9" CornerRadius="4.5"
                                    BorderBrush="{DynamicResource AccentButtonIconBrush}"
                                    BorderThickness="2.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="ATLAS"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   LetterSpacing="2.5"
                                   FontFamily="{DynamicResource Font.Bold}"
                                   Foreground="{DynamicResource CardAccentBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="3"
                                Classes="ChatHistoryToggle"
                                Padding="6"
                                Command="{Binding ToggleChatHistorySidebarCommand}"
                                ToolTip.Tip="{markup:T Ns=Notes, Key=ToggleSidebar}">
                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/layout-sidebar.svg"
                                              Width="18" Height="18"
                                              Color="{DynamicResource TextFadedBrush}"/>
                        </Button>
                    </Grid>
                    <!-- New Chat -->
                    <Button Grid.Row="1"
                            Command="{Binding NewChatCommand}"
                            Classes="NewChatButton"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/plus.svg"
                                              Width="14" Height="14"
                                              Color="{DynamicResource TextPrimaryBrush}"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="{markup:T Ns=Chat, Key=NewChat}"
                                       FontFamily="{DynamicResource Font.Medium}"
                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Recent sessions label -->
                    <TextBlock Grid.Row="2"
                               Text="{markup:T Ns=Chat, Key=RecentSessions}"
                               Margin="6,0,0,10"
                               FontSize="10"
                               LetterSpacing="1.2"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextFadedBrush}"/>
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ConversationRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ChatConversationRowViewModel">
                                    <Panel Margin="0,0,0,4">
                                        <Border IsVisible="{Binding IsSelected}"
                                                CornerRadius="10"
                                                Background="{DynamicResource CardBackgroundPrimaryBrush}"
                                                BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                BorderThickness="1"/>
                                        <Border Classes="chat-history-row"
                                                MinWidth="0"
                                                Background="{Binding IsRowHovered, Converter={StaticResource ChatHistoryRowHoverBrushConverter}}">
                                            <Grid ColumnDefinitions="*,Auto" MinWidth="0">
                                                <Button Grid.Column="0"
                                                        Classes="chat-history-row-segment"
                                                        Command="{Binding SelectCommand}"
                                                        Padding="12,9,4,9"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        PointerEntered="ChatHistoryRowSegment_PointerEntered"
                                                        PointerExited="ChatHistoryRowSegment_PointerExited">
                                                    <Button.IsEnabled>
                                                        <Binding ElementName="ChatRoot" Path="HistoryNavigationEnabled"/>
                                                    </Button.IsEnabled>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Classes="chat-history-row-segment chat-history-more"
                                                        Opacity="{Binding IsRowHovered, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter=1|0}"
                                                        ToolTip.Tip="{markup:T Ns=Chat, Key=MoreChatActions}"
                                                        PointerEntered="ChatHistoryRowSegment_PointerEntered"
                                                        PointerExited="ChatHistoryRowSegment_PointerExited">
                                                    <Button.IsEnabled>
                                                        <Binding ElementName="ChatRoot" Path="HistoryNavigationEnabled"/>
                                                    </Button.IsEnabled>
                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/dots-vertical-filled.svg"
                                                                      Width="16" Height="16"
                                                                      Color="{DynamicResource TextSecondaryBrush}"/>
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="{markup:T Ns=Notes, Key=Rename}">
                                                                <MenuItem.Command>
                                                                    <Binding ElementName="ChatRoot" Path="DataContext" Converter="{StaticResource ChatViewModelDataContextCommandConverter}" ConverterParameter="RenameChat"/>
                                                                </MenuItem.Command>
                                                                <MenuItem.CommandParameter>
                                                                    <Binding Path="ConversationId"/>
                                                                </MenuItem.CommandParameter>
                                                            </MenuItem>
                                                            <MenuItem Header="{markup:T Ns=Notes, Key=Delete}">
                                                                <MenuItem.Command>
                                                                    <Binding ElementName="ChatRoot" Path="DataContext" Converter="{StaticResource ChatViewModelDataContextCommandConverter}" ConverterParameter="DeleteChat"/>
                                                                </MenuItem.Command>
                                                                <MenuItem.CommandParameter>
                                                                    <Binding Path="ConversationId"/>
                                                                </MenuItem.CommandParameter>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Panel>
        </Border>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Panel Grid.Column="1">
            <!-- Soft warm gradient backdrop -->
            <!-- Accent is #e95b45 across all core themes; GradientStop cannot resolve DynamicResource reliably -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="20%,0%" EndPoint="80%,100%">
                        <GradientStop Offset="0" Color="#00E95B45"/>
                        <GradientStop Offset="0.55" Color="#00E95B45"/>
                        <GradientStop Offset="1" Color="#14E95B45"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid RowDefinitions="*,Auto">
                <!-- Center area: landing OR conversation -->
                <Panel Grid.Row="0">

                    <!-- ===================== LANDING / EMPTY STATE ===================== -->
                    <ScrollViewer IsVisible="{Binding ShowWelcomeIntro}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    MaxWidth="780"
                                    Margin="32,56,32,40">
                            <!-- Brand row -->
                            <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Left" Margin="4,0,0,20">
                                <Border Width="18" Height="18" CornerRadius="9"
                                        Background="{DynamicResource CardAccentBrush}"
                                        VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            BorderBrush="{DynamicResource AccentButtonIconBrush}"
                                            BorderThickness="2.2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ATLAS"
                                           FontSize="11"
                                           LetterSpacing="2.5"
                                           FontFamily="{DynamicResource Font.Bold}"
                                           Foreground="{DynamicResource CardAccentBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Greeting -->
                            <TextBlock Text="{Binding GreetingText}"
                                       FontSize="{DynamicResource FontSize.Heading1}"
                                       FontFamily="{DynamicResource Font.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="2,0,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding GreetingSubtitle}"
                                       FontSize="{DynamicResource FontSize.Heading1}"
                                       FontFamily="{DynamicResource Font.Bold}"
                                       Foreground="{DynamicResource TextFadedBrush}"
                                       Margin="2,2,0,26"
                                       TextWrapping="Wrap"/>

                            <!-- Quick action pills -->
                            <ItemsControl ItemsSource="{Binding LandingQuickActions}" Margin="2,0,0,22">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ChatLandingSuggestionViewModel">
                                        <Button Classes="QuickPill"
                                                Classes.primary="{Binding IsPrimary}"
                                                Margin="0,0,8,8"
                                                Command="{Binding Command}"
                                                CommandParameter="{Binding Prompt}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <controls:SvgIcon SvgPath="{Binding IconPath}"
                                                                  Width="14" Height="14"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{DynamicResource FontSize.Body.Caption}"
                                                           FontFamily="{DynamicResource Font.Medium}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Composer card -->
                            <Border Background="{DynamicResource CardBackgroundPrimaryBrush}"
                                    CornerRadius="22"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                                    BoxShadow="0 12 32 -12 #22000000">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <ItemsControl Grid.Row="0"
                                                  ItemsSource="{Binding PendingAttachments}"
                                                  ItemTemplate="{StaticResource PendingAttachmentTemplate}"
                                                  Margin="16,12,16,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <TextBox x:Name="LandingInputBox"
                                             Grid.Row="1"
                                             Classes="TransparentBackground"
                                             PlaceholderText="{markup:T Ns=Chat, Key=LandingPlaceholder}"
                                             AcceptsReturn="False"
                                             TextWrapping="Wrap"
                                             MinHeight="56"
                                             MaxHeight="180"
                                             BorderThickness="0"
                                             Background="{DynamicResource TextControlTransparentBackgroundBrush}"
                                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="20,18,20,8"/>

                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                          Margin="12,0,12,12">
                                        <Button Grid.Column="0"
                                                Classes="PromptActionButton"
                                                Margin="0,0,2,0"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{markup:T Ns=Chat, Key=AddAttachment}"
                                                Click="AddAttachment_Click">
                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/link.svg"
                                                              Width="16" Height="16"
                                                              Color="{DynamicResource TextFadedBrush}"/>
                                        </Button>
                                        <ToggleButton Grid.Column="1"
                                                      Classes="ToolbarPill"
                                                      Padding="8"
                                                      Margin="0,0,8,0"
                                                      BorderThickness="0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsWebSearchEnabled, Mode=TwoWay}"
                                                      ToolTip.Tip="{markup:T Ns=Chat, Key=WebSearch}">
                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/search.svg"
                                                              Width="16" Height="16"
                                                              Color="{DynamicResource TextFadedBrush}"/>
                                        </ToggleButton>
                                        <!-- Model badge; dot color doubles as live model status -->
                                        <Border Grid.Column="2"
                                                BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding AiStatusTooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{DynamicResource CardAccentBrush}"
                                                        VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3"
                                                            Background="{Binding AiStatusBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="atlas-1"
                                                           FontSize="{DynamicResource FontSize.Body.Caption}"
                                                           FontFamily="{DynamicResource Font.Medium}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Panel Grid.Column="4" VerticalAlignment="Center">
                                            <Button Command="{Binding SendMessageCommand}"
                                                    IsVisible="{Binding !IsBusy}"
                                                    Classes="SendCircle"
                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=SendEnter}">
                                                <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/chevron-right.svg"
                                                                  Width="18" Height="18"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Color="{DynamicResource AccentButtonIconBrush}">
                                                    <controls:SvgIcon.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </controls:SvgIcon.RenderTransform>
                                                </controls:SvgIcon>
                                            </Button>
                                            <Button Command="{Binding StopCommand}"
                                                    IsVisible="{Binding IsBusy}"
                                                    Classes="StopCircle"
                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=Stop}">
                                                <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/player-pause.svg"
                                                                  Width="16" Height="16"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Color="{DynamicResource StopButtonForegroundBrush}"/>
                                            </Button>
                                        </Panel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Disclaimer -->
                            <TextBlock Text="{markup:T Ns=Chat, Key=Disclaimer}"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                       Foreground="{DynamicResource TextFadedBrush}"
                                       Margin="0,14,0,0"/>

                            <!-- Suggestion cards -->
                            <ItemsControl ItemsSource="{Binding LandingSuggestions}" Margin="0,28,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ChatLandingSuggestionViewModel">
                                        <Button Classes="SuggestionCard"
                                                Margin="6,0"
                                                Command="{Binding Command}"
                                                CommandParameter="{Binding Prompt}">
                                            <StackPanel Spacing="0">
                                                <controls:SvgIcon SvgPath="{Binding IconPath}"
                                                                  Width="18" Height="18"
                                                                  HorizontalAlignment="Left"
                                                                  Color="{Binding IconBrush}"/>
                                                <TextBlock Text="{Binding Title}"
                                                           Margin="0,14,0,0"
                                                           FontSize="{DynamicResource FontSize.Body.Small}"
                                                           FontFamily="{DynamicResource Font.SemiBold}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}"
                                                           IsVisible="{Binding HasDescription}"
                                                           Margin="0,6,0,0"
                                                           FontSize="{DynamicResource FontSize.Body.Caption}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== ACTIVE CONVERSATION ===================== -->
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  IsVisible="{Binding !ShowWelcomeIntro}"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border MaxWidth="820" HorizontalAlignment="Stretch" MinWidth="0" Padding="28,28,28,16">
                            <StackPanel MinWidth="0">
                                <!-- ItemsRepeater virtualizes vertically; works correctly even inside ScrollViewer > StackPanel chain (unlike ItemsControl + VirtualizingStackPanel). -->
                                <ItemsRepeater x:Name="ChatMessagesRepeater"
                                               ItemsSource="{Binding Messages}"
                                               HorizontalAlignment="Stretch">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate DataType="vm:ChatMessageViewModel">
                                            <Panel Margin="0,0,0,32" MinWidth="0">
                                                <!-- Assistant Message -->
                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsUser}" MinWidth="0">
                                                    <!-- Atlas avatar -->
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                            Background="{DynamicResource CardAccentBrush}"
                                                            Margin="0,2,14,0" VerticalAlignment="Top"
                                                            BoxShadow="0 2 6 -1 #26000000">
                                                        <Border Width="11" Height="11" CornerRadius="5.5"
                                                                BorderBrush="{DynamicResource AccentButtonIconBrush}"
                                                                BorderThickness="2.5"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Assistant message body -->
                                                    <StackPanel Grid.Column="1" MinWidth="0">
                                                        <!-- Thought Process Pill (compact, collapsible) -->
                                                        <ToggleButton Classes="ProcessPill"
                                                                      IsChecked="{Binding IsProcessThreadExpanded, Mode=TwoWay}"
                                                                      IsVisible="{Binding HasProcessThreadOrThoughts}"
                                                                      Margin="0,0,0,12"
                                                                      HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <!-- Streaming: spinner -->
                                                                <controls:SvgIcon Classes="ActiveSpin"
                                                                                  SvgPath="avares://Mnemo.UI/Icons/States/active.svg"
                                                                                  Width="14" Height="14"
                                                                                  VerticalAlignment="Center"
                                                                                  Color="{DynamicResource ChatProcessStateActiveBrush}"
                                                                                  IsVisible="{Binding IsStreaming}"/>
                                                                <!-- Complete: success check -->
                                                                <Panel Width="15" Height="15"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding !IsStreaming}">
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/done-disc.svg"
                                                                                      Width="15" Height="15"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      Color="{DynamicResource ChatProcessStateDoneFillBrush}"/>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/done-check.svg"
                                                                                      Width="15" Height="15"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      Color="{DynamicResource ChatProcessStateDoneGlyphBrush}"/>
                                                                </Panel>
                                                                <TextBlock Text="{Binding ProcessHeaderText}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           FontFamily="{DynamicResource Font.Medium}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="·"
                                                                           IsVisible="{Binding HasElapsedText}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextFadedBrush}"
                                                                           FontFamily="{DynamicResource Font.Medium}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ElapsedText}"
                                                                           IsVisible="{Binding HasElapsedText}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontFamily="{DynamicResource Font.Monospace}"
                                                                           VerticalAlignment="Center"/>
                                                                <controls:SvgIcon Classes="chevron"
                                                                                  SvgPath="avares://Mnemo.UI/Icons/Common/chevron-down.svg"
                                                                                  Width="14" Height="14"
                                                                                  Color="{DynamicResource TextFadedBrush}"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </ToggleButton>

                                                        <!-- Collapsible step list / Thoughts -->
                                                        <Border IsVisible="{Binding IsProcessThreadExpanded}"
                                                                Margin="0,0,0,14"
                                                                Padding="16,14"
                                                                Background="{DynamicResource CardBackgroundPrimaryBrush}"
                                                                BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="16"
                                                                BoxShadow="0 8 20 -10 #1A000000"
                                                                HorizontalAlignment="Left"
                                                                MinWidth="260">
                                                            <StackPanel>
                                                                <ItemsControl ItemsSource="{Binding ProcessSteps}" IsVisible="{Binding HasProcessThread}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="vmroot:ChatProcessStepViewModel">
                                                                            <Grid ColumnDefinitions="Auto,*">
                                                                                <Grid Grid.Column="0" RowDefinitions="Auto, *" Width="20" Margin="0,2,10,0" HorizontalAlignment="Center">
                                                                                    <Panel Grid.Row="0" Width="20" Height="20">
                                                                                        <Panel Width="20" Height="20" IsVisible="{Binding IsComplete}">
                                                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/done-disc.svg"
                                                                                                              Width="16" Height="16"
                                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                              Color="{DynamicResource ChatProcessStateDoneFillBrush}"/>
                                                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/done-check.svg"
                                                                                                              Width="16" Height="16"
                                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                              Color="{DynamicResource ChatProcessStateDoneGlyphBrush}"/>
                                                                                        </Panel>
                                                                                        <controls:SvgIcon Classes="ActivePulse"
                                                                                                          SvgPath="avares://Mnemo.UI/Icons/States/active.svg"
                                                                                                          Width="16" Height="16"
                                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                          Color="{DynamicResource ChatProcessStateActiveBrush}"
                                                                                                          IsVisible="{Binding IsActive}"/>
                                                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/pending.svg"
                                                                                                          Width="16" Height="16"
                                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                          Color="{DynamicResource ChatProcessStatePendingBrush}"
                                                                                                          IsVisible="{Binding IsPending}"/>
                                                                                    </Panel>
                                                                                    <Border Grid.Row="1" Width="1.5"
                                                                                            Background="{DynamicResource SidebarBorderBrush}"
                                                                                            Margin="0,4,0,0"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Stretch"/>
                                                                                </Grid>
                                                                                <StackPanel Grid.Column="1" Spacing="2" MinWidth="0" Margin="0,0,0,14">
                                                                                    <TextBlock Text="{Binding Label}"
                                                                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                               FontFamily="{DynamicResource Font.Medium}"
                                                                                               TextWrapping="Wrap"/>
                                                                                    <TextBlock Text="{Binding Detail}"
                                                                                               FontSize="{DynamicResource FontSize.Body.Caption}"
                                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                               TextWrapping="Wrap"
                                                                                               IsVisible="{Binding HasDetail}"/>
                                                                                    <ItemsControl ItemsSource="{Binding ToolCalls}"
                                                                                                  IsVisible="{Binding HasToolCalls}"
                                                                                                  Margin="0,4,0,0">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate DataType="vmroot:ChatToolCallViewModel">
                                                                                                <Expander Padding="0" MinHeight="0"
                                                                                                          Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                                                                                          BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                                                                          BorderThickness="1"
                                                                                                          CornerRadius="8"
                                                                                                          Margin="0,0,0,4">
                                                                                                    <Expander.Header>
                                                                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                                                                            <!-- Live call state: spinner while running, check on success, alert on failure -->
                                                                                                            <Panel Width="13" Height="13" VerticalAlignment="Center">
                                                                                                                <controls:SvgIcon Classes="ActiveSpin"
                                                                                                                                  SvgPath="avares://Mnemo.UI/Icons/States/active.svg"
                                                                                                                                  Width="13" Height="13"
                                                                                                                                  Color="{DynamicResource ChatProcessStateActiveBrush}"
                                                                                                                                  IsVisible="{Binding IsRunning}"/>
                                                                                                                <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/done-check.svg"
                                                                                                                                  Width="13" Height="13"
                                                                                                                                  Color="{DynamicResource ChatProcessStateDoneFillBrush}"
                                                                                                                                  IsVisible="{Binding IsSucceeded}"/>
                                                                                                                <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/square-rounded-x.svg"
                                                                                                                                  Width="13" Height="13"
                                                                                                                                  Color="{DynamicResource TextFadedBrush}"
                                                                                                                                  IsVisible="{Binding IsFailed}"/>
                                                                                                            </Panel>
                                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                                       FontFamily="{DynamicResource Font.Monospace}"
                                                                                                                       FontSize="11"
                                                                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                                                       VerticalAlignment="Center"/>
                                                                                                            <TextBlock Text="{Binding Summary}"
                                                                                                                       FontSize="11"
                                                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                                                       VerticalAlignment="Center"/>
                                                                                                        </StackPanel>
                                                                                                    </Expander.Header>
                                                                                                    <StackPanel Spacing="6" Margin="12,6,12,10">
                                                                                                        <TextBlock Text="Arguments" FontSize="10" FontFamily="{DynamicResource Font.SemiBold}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                                                        <TextBlock Text="{Binding Arguments}" FontFamily="{DynamicResource Font.Monospace}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                                                                        <TextBlock Text="Result" FontSize="10" FontFamily="{DynamicResource Font.SemiBold}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                                                                        <TextBlock Text="{Binding Result}" FontFamily="{DynamicResource Font.Monospace}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                                                                    </StackPanel>
                                                                                                </Expander>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <!-- Reasoning trace: its own labeled state, clearly separate
                                                                     from the routing/tool steps above and from the final
                                                                     answer below — spinner while thinking, check once the
                                                                     model has moved on to generating the reply. -->
                                                                <StackPanel IsVisible="{Binding IsThinking}"
                                                                            Margin="0,10,0,4"
                                                                            Spacing="8">
                                                                    <Border BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                                            BorderThickness="0,1,0,0"
                                                                            Margin="0,0,0,2"/>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <controls:SvgIcon Classes="ActiveSpin"
                                                                                          SvgPath="avares://Mnemo.UI/Icons/States/active.svg"
                                                                                          Width="13" Height="13"
                                                                                          VerticalAlignment="Center"
                                                                                          Color="{DynamicResource ChatProcessStateActiveBrush}"
                                                                                          IsVisible="{Binding IsActivelyThinking}"/>
                                                                        <Panel Width="14" Height="14" VerticalAlignment="Center"
                                                                               IsVisible="{Binding HasFinishedThinking}">
                                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/done-disc.svg"
                                                                                              Width="14" Height="14"
                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                              Color="{DynamicResource ChatProcessStateDoneFillBrush}"/>
                                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/States/done-check.svg"
                                                                                              Width="14" Height="14"
                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                              Color="{DynamicResource ChatProcessStateDoneGlyphBrush}"/>
                                                                        </Panel>
                                                                        <TextBlock Text="{markup:T Ns=Chat, Key=ThinkingLabel}"
                                                                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                                                                   FontFamily="{DynamicResource Font.Medium}"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <components:MarkdownView Source="{Binding Thoughts}"
                                                                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <components:MarkdownView Source="{Binding Content}"
                                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                 StreamingUpdateIntervalMs="{Binding IsStreaming, Converter={StaticResource BoolToStreamingIntervalConverter}}"/>

                                                        <!-- Sources -->
                                                        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,8,0,0" MinWidth="0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource CardBackgroundPrimaryBrush}"
                                                                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10"
                                                                            Padding="8,4"
                                                                            Margin="0,0,6,6">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/file-text.svg"
                                                                                              Width="12" Height="12"
                                                                                              Color="{DynamicResource TextSecondaryBrush}"/>
                                                                            <TextBlock Text="{Binding}"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Follow-up suggestions -->
                                                        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0" HorizontalAlignment="Stretch" MinWidth="0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Classes="SuggestionChip" Margin="0,0,8,8"
                                                                            Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Suggestion}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                                                                   FontFamily="{DynamicResource Font.Medium}"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Message actions -->
                                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                            <Button Classes="MessageActionIcon"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Regenerate}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=Regenerate}">
                                                                <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/refresh.svg"
                                                                                  Width="16" Height="16"
                                                                                  Color="{DynamicResource TextFadedBrush}"/>
                                                            </Button>
                                                            <Button Classes="MessageActionIcon"
                                                                    Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=Copy}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{markup:T Ns=Chat, Key=CopyMessage}"
                                                                    IsEnabled="{Binding HasCopiableAssistantContent}">
                                                                <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/copy.svg"
                                                                                  Width="16" Height="16"
                                                                                  Color="{DynamicResource TextFadedBrush}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- User Message: bubble + avatar -->
                                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsUser}" MinWidth="0">
                                                    <Border Grid.Column="0"
                                                            HorizontalAlignment="Right"
                                                            MaxWidth="520"
                                                            CornerRadius="18"
                                                            Padding="16,12"
                                                            Background="{DynamicResource CardBackgroundPrimaryBrush}"
                                                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                            BorderThickness="1"
                                                            BoxShadow="0 4 12 -6 #1A000000">
                                                        <StackPanel Spacing="8">
                                                            <ItemsControl ItemsSource="{Binding Attachments}"
                                                                          IsVisible="{Binding HasAttachments}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:ChatAttachmentViewModel">
                                                                        <Panel Margin="0,0,8,8">
                                                                            <!-- Image Attachment (clickable to open overlay preview) -->
                                                                            <Button Command="{Binding #ChatRoot.DataContext, Converter={StaticResource ChatViewModelDataContextCommandConverter}, ConverterParameter=OpenImagePreview}"
                                                                                    CommandParameter="{Binding Path}"
                                                                                    Background="Transparent"
                                                                                    BorderThickness="0"
                                                                                    Padding="0"
                                                                                    CornerRadius="12"
                                                                                    ClipToBounds="True"
                                                                                    Cursor="Hand"
                                                                                    IsVisible="{Binding Kind, Converter={StaticResource ChatAttachmentKindToBoolConverter}, ConverterParameter=Image}">
                                                                                <Border CornerRadius="12"
                                                                                        ClipToBounds="True"
                                                                                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                                                        BorderThickness="1"
                                                                                        Background="{DynamicResource CardBackgroundPrimaryBrush}">
                                                                                    <Image Source="{Binding Path, Converter={StaticResource LocalPathToBitmapConverter}}"
                                                                                           Stretch="Uniform"
                                                                                           MaxWidth="128"
                                                                                           MaxHeight="128"
                                                                                           MinWidth="32"
                                                                                           MinHeight="32"/>
                                                                                </Border>
                                                                            </Button>

                                                                            <!-- File Attachment -->
                                                                            <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                                                                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="8"
                                                                                    Padding="10,8"
                                                                                    IsVisible="{Binding Kind, Converter={StaticResource ChatAttachmentKindToBoolConverter}, ConverterParameter=File}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/file-text.svg"
                                                                                                      Width="16" Height="16"
                                                                                                      Color="{DynamicResource TextPrimaryBrush}"/>
                                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                               FontFamily="{DynamicResource Font.Medium}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               MaxWidth="200"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Panel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding Content}"
                                                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="20"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- User avatar -->
                                                    <Border Grid.Column="1"
                                                            Width="30" Height="30" CornerRadius="15"
                                                            Margin="12,2,0,0"
                                                            VerticalAlignment="Top"
                                                            ClipToBounds="True"
                                                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource CardBackgroundSecondaryBrush}">
                                                        <Image Source="{Binding #ChatRoot.((vm:ChatViewModel)DataContext).ProfilePicturePath, Converter={StaticResource PathToImageConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Panel>

                <!-- Bottom input bar (active conversation only; landing has its own composer) -->
                <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto"
                      IsVisible="{Binding !ShowWelcomeIntro}"
                      MinWidth="0">
                    <Button x:Name="ScrollToBottomButton"
                            Classes="ScrollToBottomLink"
                            Grid.Row="0"
                            IsVisible="{Binding ShowScrollToBottomButton}"
                            Command="{Binding ScrollToBottomCommand}"
                            Padding="0,6,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{markup:T Ns=Chat, Key=ScrollToBottom}"
                                   FontSize="{DynamicResource FontSize.Body.Caption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>

                    <Border Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            MaxWidth="820"
                            MinWidth="0"
                            Margin="28,14,28,0">
                        <Border Background="{DynamicResource CardBackgroundPrimaryBrush}"
                                CornerRadius="22"
                                BoxShadow="0 10 28 -12 #22000000"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SidebarBorderBrush}"
                                Padding="0">
                            <Grid RowDefinitions="Auto, Auto, Auto">
                                <!-- Pending Attachments -->
                                <ItemsControl Grid.Row="0"
                                              ItemsSource="{Binding PendingAttachments}"
                                              ItemTemplate="{StaticResource PendingAttachmentTemplate}"
                                              Margin="14,10,14,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- Text input -->
                                <TextBox x:Name="InputBox"
                                         Grid.Row="1"
                                         Classes="TransparentBackground"
                                         PlaceholderText="{markup:T Ns=Chat, Key=LandingPlaceholder}"
                                         AcceptsReturn="False"
                                         TextWrapping="Wrap"
                                         MinHeight="48"
                                         MaxHeight="140"
                                         BorderThickness="0"
                                         Background="{DynamicResource TextControlTransparentBackgroundBrush}"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="18,14,18,6"/>

                                <!-- Toolbar row -->
                                <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *, Auto"
                                      MinWidth="0"
                                      Margin="10,0,10,10">
                                    <Button Grid.Column="0" Classes="PromptActionButton" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{markup:T Ns=Chat, Key=AddAttachment}" Click="AddAttachment_Click">
                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/link.svg"
                                                          Width="16" Height="16"
                                                          Color="{DynamicResource TextFadedBrush}"/>
                                    </Button>
                                    <ToggleButton Grid.Column="1" Classes="ToolbarPill" Margin="0,0,2,0"
                                                  Padding="8"
                                                  BorderThickness="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsWebSearchEnabled, Mode=TwoWay}"
                                                  ToolTip.Tip="{markup:T Ns=Chat, Key=WebSearch}">
                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/search.svg"
                                                          Width="16" Height="16"
                                                          Color="{DynamicResource TextFadedBrush}"/>
                                    </ToggleButton>
                                    <Button Grid.Column="2" Classes="PromptActionButton" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{markup:T Ns=Chat, Key=AddImage}" Click="AddImage_Click">
                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/polaroid.svg"
                                                          Width="16" Height="16"
                                                          Color="{DynamicResource TextFadedBrush}"/>
                                    </Button>
                                    <Button Grid.Column="3" Classes="PromptActionButton" Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{markup:T Ns=Chat, Key=AddScreenshot}" Click="AddScreenshot_Click">
                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/screenshot.svg"
                                                          Width="16" Height="16"
                                                          Color="{DynamicResource TextFadedBrush}"/>
                                    </Button>
                                    <controls:ModernComboBox Grid.Column="4"
                                                             Classes="PromptPill"
                                                             ItemsSource="{Binding AssistantModes}"
                                                             SelectedItem="{Binding SelectedAssistantMode}"
                                                             MinWidth="80"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             ToolTip.Tip="{markup:T Ns=Chat, Key=AssistantMode}">
                                        <controls:ModernComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource AssistantModeToLabelConverter}}"
                                                           FontSize="{DynamicResource FontSize.Body.Caption}"
                                                           FontFamily="{DynamicResource Font.Medium}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </DataTemplate>
                                        </controls:ModernComboBox.ItemTemplate>
                                    </controls:ModernComboBox>
                                    <Border Grid.Column="5"
                                            IsVisible="{Binding ShowMemoryPill}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                            BorderBrush="{DynamicResource SidebarBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="10,5"
                                            MaxWidth="200"
                                            Cursor="Help">
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding MemoryPillTooltipText}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="420"
                                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </ToolTip.Tip>
                                        <TextBlock Text="{Binding MemoryPillDisplayText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{DynamicResource FontSize.Body.Caption}"
                                                   FontFamily="{DynamicResource Font.Medium}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Border Grid.Column="6" MinWidth="0"/>
                                    <Panel Grid.Column="7" VerticalAlignment="Center">
                                        <Button Command="{Binding SendMessageCommand}"
                                                IsVisible="{Binding !IsBusy}"
                                                Classes="SendCircle"
                                                Width="36" Height="36" CornerRadius="18"
                                                ToolTip.Tip="{markup:T Ns=Chat, Key=SendEnter}">
                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/chevron-right.svg"
                                                              Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Color="{DynamicResource AccentButtonIconBrush}">
                                                <controls:SvgIcon.RenderTransform>
                                                    <RotateTransform Angle="-90"/>
                                                </controls:SvgIcon.RenderTransform>
                                            </controls:SvgIcon>
                                        </Button>
                                        <Button Command="{Binding StopCommand}"
                                                IsVisible="{Binding IsBusy}"
                                                Classes="StopCircle"
                                                Width="36" Height="36" CornerRadius="18"
                                                ToolTip.Tip="{markup:T Ns=Chat, Key=Stop}">
                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/player-pause.svg"
                                                              Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Color="{DynamicResource StopButtonForegroundBrush}"/>
                                        </Button>
                                    </Panel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Disclaimer -->
                    <TextBlock Grid.Row="2"
                               Text="{markup:T Ns=Chat, Key=Disclaimer}"
                               HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                               Foreground="{DynamicResource TextFadedBrush}"
                               Margin="0,10,0,14"/>
                </Grid>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
