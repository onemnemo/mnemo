<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mnemo.UI.Controls"
             x:Class="Mnemo.UI.Modules.Notes.Views.NotePdfExportOverlay"
             x:CompileBindings="False"
             Focusable="True"
             Width="720">
    <UserControl.Styles>
        <!-- Segmented General / Rendering switch on a recessed track. -->
        <Style Selector="Button.pdf-tab">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Translucent white hover so the track tint shows through on any theme. -->
        <Style Selector="Button.pdf-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8CFFFFFF" />
        </Style>
        <Style Selector="Button.pdf-tab.selected">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
        </Style>
        <Style Selector="Button.pdf-tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
        </Style>

        <Style Selector="TextBlock.pdf-field-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.pdf-toggle-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Floating dropdown row: label left, muted mono value + check right. -->
        <Style Selector="TextBlock.pdf-choice-hint">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingChromeForegroundMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="{DynamicResource Radius.Lg}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource OverlayBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Border Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                    Padding="20,16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:AppIcon Grid.Column="0"
                                      Icon="Common/download"
                                      Width="16" Height="16"
                                      Margin="0,2,10,0"
                                      VerticalAlignment="Top"
                                      Color="{DynamicResource AccentBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="TitleText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body.Medium}"
                                   FontFamily="{DynamicResource Font.SemiBold}" />
                        <TextBlock x:Name="DescriptionText"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}" />
                    </StackPanel>
                    <controls:AppButton Grid.Column="2"
                                        x:Name="CloseButton"
                                        Classes="ghost"
                                        IconName="Common/x"
                                        IconSize="14"
                                        Width="28" Height="28"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        Click="OnCloseClick" />
                </Grid>
            </Border>

            <!-- Body: controls | preview -->
            <Grid Grid.Row="1" ColumnDefinitions="320,*">
                <Border Grid.Column="0"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{DynamicResource DividerSubtleBrush}"
                        Padding="20,18">
                    <StackPanel Spacing="14">
                        <!-- Section switch -->
                        <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="3">
                            <Grid ColumnDefinitions="*,3,*">
                                <Button Grid.Column="0"
                                        x:Name="GeneralTabButton"
                                        Classes="pdf-tab selected"
                                        Click="OnGeneralTabClick" />
                                <Button Grid.Column="2"
                                        x:Name="RenderingTabButton"
                                        Classes="pdf-tab"
                                        Click="OnRenderingTabClick" />
                            </Grid>
                        </Border>

                        <!-- General: paper, margins, page numbers -->
                        <StackPanel x:Name="GeneralPanel" Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="PaperLabel" Classes="pdf-field-label" />
                                <controls:ModernComboBox x:Name="PaperCombo"
                                                         Classes="compact floating"
                                                         HorizontalAlignment="Stretch"
                                                         SelectionChanged="OnSettingChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="MarginLabel" Classes="pdf-field-label" />
                                <controls:ModernComboBox x:Name="MarginCombo"
                                                         Classes="compact floating"
                                                         HorizontalAlignment="Stretch"
                                                         SelectionChanged="OnSettingChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="PageNumberPositionLabel" Classes="pdf-field-label" />
                                <controls:ModernComboBox x:Name="PageNumberPositionCombo"
                                                         Classes="compact floating"
                                                         HorizontalAlignment="Stretch"
                                                         SelectionChanged="OnSettingChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="PageNumberFormatLabel" Classes="pdf-field-label" />
                                <controls:ModernComboBox x:Name="PageNumberFormatCombo"
                                                         Classes="compact floating"
                                                         HorizontalAlignment="Stretch"
                                                         SelectionChanged="OnSettingChanged" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Rendering: body size, title, render toggles -->
                        <StackPanel x:Name="RenderingPanel" Spacing="14" IsVisible="False">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="FontSizeLabel" Classes="pdf-field-label" />
                                <controls:ModernComboBox x:Name="FontSizeCombo"
                                                         Classes="compact floating"
                                                         HorizontalAlignment="Stretch"
                                                         SelectionChanged="OnSettingChanged">
                                    <controls:ModernComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Classes="pdf-choice-hint"
                                                           Margin="9,0,0,0"
                                                           Text="{Binding Hint}" />
                                                <controls:AppIcon Grid.Column="2"
                                                                  Classes="floating-check"
                                                                  Icon="States/done-check"
                                                                  Width="12" Height="12"
                                                                  Margin="9,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Color="{DynamicResource FloatingChromeAccentBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </controls:ModernComboBox.ItemTemplate>
                                </controls:ModernComboBox>
                            </StackPanel>

                            <CheckBox x:Name="IncludeTitleCheck"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                      IsChecked="True" />

                            <Border BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                                    Padding="0,10,0,0">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*" Height="28">
                                        <ToggleSwitch x:Name="HighlightsToggle"
                                                      IsChecked="True"
                                                      Margin="0,0,10,0"
                                                      IsCheckedChanged="OnToggleChanged" />
                                        <TextBlock Grid.Column="1" x:Name="HighlightsToggleLabel" Classes="pdf-toggle-label" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" Height="28">
                                        <ToggleSwitch x:Name="ImagesToggle"
                                                      IsChecked="True"
                                                      Margin="0,0,10,0"
                                                      IsCheckedChanged="OnToggleChanged" />
                                        <TextBlock Grid.Column="1" x:Name="ImagesToggleLabel" Classes="pdf-toggle-label" />
                                    </Grid>
                                    <!-- Placeholder: flashcards-from-note appendix export is not implemented yet. -->
                                    <Grid ColumnDefinitions="Auto,*" Height="28" IsVisible="False">
                                        <ToggleSwitch x:Name="FlashcardsToggle" IsEnabled="False" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" x:Name="FlashcardsToggleLabel"
                                                   Classes="pdf-toggle-label"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Grid.Column="1" Padding="20,18">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                   x:Name="PreviewCaption"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   FontFamily="{DynamicResource Font.SemiBold}"
                                   LetterSpacing="1"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,0,8" />
                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                MinHeight="300">
                            <Panel>
                                <Border x:Name="PreviewSheet"
                                        Background="White"
                                        CornerRadius="3"
                                        BoxShadow="0 8 22 0 #29000000"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="24"
                                        IsVisible="False">
                                    <Image x:Name="PreviewImage"
                                           Stretch="Uniform"
                                           MaxHeight="280"
                                           MaxWidth="280" />
                                </Border>
                                <TextBlock x:Name="PreviewStatusText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="24"
                                           FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Panel>
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <controls:AppButton x:Name="PrevPageButton"
                                                    Classes="outline"
                                                    IconName="Common/chevron-down"
                                                    IconSize="10"
                                                    Width="26" Height="26"
                                                    Padding="0"
                                                    Click="OnPrevPageClick" />
                                <TextBlock x:Name="PageCounterText"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Text="– / –" />
                                <controls:AppButton x:Name="NextPageButton"
                                                    Classes="outline"
                                                    IconName="Common/chevron-up"
                                                    IconSize="10"
                                                    Width="26" Height="26"
                                                    Padding="0"
                                                    Click="OnNextPageClick" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       x:Name="DocumentStatsText"
                                       FontFamily="{DynamicResource Font.Monospace}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                    Padding="20,14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="FooterHintText"
                               FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <controls:AppButton x:Name="CancelButton"
                                            Classes="outline"
                                            Height="34"
                                            Padding="16,0"
                                            Click="OnCloseClick" />
                        <controls:AppButton x:Name="ExportButton"
                                            Classes="accent"
                                            Height="34"
                                            Padding="18,0"
                                            Click="OnExportClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ExportButtonLabel" VerticalAlignment="Center" />
                                <TextBlock x:Name="ExportShortcutHint"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           FontSize="10"
                                           Opacity="0.65"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:AppButton>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
