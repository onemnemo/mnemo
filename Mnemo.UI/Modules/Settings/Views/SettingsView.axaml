<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Settings.ViewModels"
             xmlns:model="using:Mnemo.Core.Models"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:converters="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Mnemo.UI.Modules.Settings.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="SettingsRoot">

    <UserControl.Styles>
        <!-- Bordered search field on the nav pane -->
        <Style Selector="TextBox.settings-search">
            <Setter Property="Background" Value="{DynamicResource SearchBarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{DynamicResource SearchBarHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SearchBarBorderBrush}"/>
            </Style>
            <Style Selector="^:focus /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{DynamicResource SearchBarBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
        </Style>

        <!-- Uppercase micro-label shared by nav sections, page sections and rail subheaders -->
        <Style Selector="TextBlock.settings-section-label">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        </Style>

        <!-- Bordered single-line inputs in setting rows -->
        <Style Selector="TextBox.settings-input">
            <Setter Property="Background" Value="{DynamicResource SearchBarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style Selector="^:focus /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{DynamicResource SearchBarBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>
        </Style>

        <!-- Sections separate rows with dividers between them: the last row in a run drops its
             bottom divider. Anchored on the items panel so ContentPresenters inside row content
             (buttons, wrappers) can't match. -->
        <Style Selector="ItemsControl.settings-rows StackPanel &gt; ContentPresenter:nth-last-child(1) components|SettingsRow /template/ Border#PART_RowBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:BoolToPasswordCharConverter x:Key="BoolToPasswordCharConverter"/>

        <!-- Toggle Setting -->
        <DataTemplate x:Key="ToggleSettingTemplate" x:DataType="vm:ToggleSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <ToggleSwitch IsChecked="{Binding Value}"
                                  IsEnabled="{Binding IsInteractionEnabled}"/>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- AI enable toggle rendered as a plain row (search results); on its own page it is the master row -->
        <DataTemplate x:Key="EnableAiAssistantToggleSettingTemplate" x:DataType="vm:EnableAiAssistantToggleSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <ToggleSwitch IsChecked="{Binding Value}"
                                  IsEnabled="{Binding IsInteractionEnabled}"/>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Dropdown Setting -->
        <DataTemplate x:Key="DropdownSettingTemplate" x:DataType="vm:DropdownSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <controls:ModernComboBox Classes="compact"
                                             ItemsSource="{Binding Options}"
                                             SelectedItem="{Binding SelectedOption}"
                                             IsEnabled="{Binding IsInteractionEnabled}"
                                             MinWidth="130"/>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Model picker (options stream in from the model catalog) -->
        <DataTemplate x:Key="ModelPickerSettingTemplate" x:DataType="vm:ModelPickerSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <controls:ModernComboBox Classes="compact"
                                             ItemsSource="{Binding Options}"
                                             SelectedItem="{Binding SelectedOption}"
                                             IsEnabled="{Binding !IsLoading}"
                                             MinWidth="190">
                        <controls:ModernComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                            </DataTemplate>
                        </controls:ModernComboBox.ItemTemplate>
                    </controls:ModernComboBox>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Language Setting -->
        <DataTemplate x:Key="LanguageSettingTemplate" x:DataType="vm:LanguageSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <controls:ModernComboBox Classes="compact"
                                             ItemsSource="{Binding AvailableLanguages}"
                                             SelectedItem="{Binding SelectedLanguage}"
                                             MinWidth="130">
                        <controls:ModernComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:LanguageManifest">
                                <TextBlock Text="{Binding NativeName}" FontSize="13"/>
                            </DataTemplate>
                        </controls:ModernComboBox.ItemTemplate>
                    </controls:ModernComboBox>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Action Setting -->
        <DataTemplate x:Key="ActionSettingTemplate" x:DataType="vm:ActionSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <controls:AppButton Classes="outline"
                                        Content="{Binding ActionText}"
                                        Command="{Binding ActionCommand}"
                                        IsEnabled="{Binding HasAction}"
                                        Padding="12,6"
                                        FontSize="12.5"/>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Async Action Setting -->
        <DataTemplate x:Key="AsyncActionSettingTemplate" x:DataType="vm:AsyncActionSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <StackPanel Spacing="6" HorizontalAlignment="Right">
                        <controls:AppButton Classes="outline"
                                            Content="{Binding ActionText}"
                                            Command="{Binding ActionCommand}"
                                            IsEnabled="{Binding CanClick}"
                                            IsLoading="{Binding IsRunning}"
                                            Padding="12,6"
                                            FontSize="12.5"
                                            HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding StatusText}"
                                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Right"
                                   MaxWidth="260"/>
                    </StackPanel>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- App Icon Setting -->
        <DataTemplate x:Key="AppIconSettingTemplate" x:DataType="vm:AppIconSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <ItemsControl ItemsSource="{Binding Options}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" ClipToBounds="False" Margin="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppIconOptionViewModel">
                                <Button Command="{Binding SelectCommand}"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                                </Transitions>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="RenderTransform" Value="scale(1.1)"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                    <Border Width="42" Height="42"
                                            CornerRadius="{DynamicResource Radius.Md}"
                                            ClipToBounds="True"
                                            BorderThickness="2"
                                            Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                            Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Transitions">
                                                    <Transitions>
                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                    </Transitions>
                                                </Setter>
                                            </Style>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Image Source="{Binding IconPath, Converter={StaticResource PathToImageConverter}}"
                                               Width="32" Height="32"
                                               Margin="4"
                                               Stretch="Uniform"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Notice (read-only) Setting -->
        <DataTemplate x:Key="NoticeSettingTemplate" x:DataType="vm:SettingsNoticeViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}"/>
        </DataTemplate>

        <!-- Sub-section label inside a group (e.g. rail sections of the AI block) -->
        <DataTemplate x:Key="SubheaderSettingTemplate" x:DataType="vm:SettingsSubheaderViewModel">
            <TextBlock Classes="settings-section-label"
                       Text="{Binding Title, Converter={x:Static converters:UpperCaseStringConverter.Instance}}"
                       Margin="0,18,0,2"/>
        </DataTemplate>

        <!-- Theme Setting -->
        <DataTemplate x:Key="ThemeSettingTemplate" x:DataType="vm:ThemeSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <ItemsControl ItemsSource="{Binding Options}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" ClipToBounds="False" Margin="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                                <Button Command="{Binding SelectCommand}"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip.Tip="{Binding DisplayName}">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                                </Transitions>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="RenderTransform" Value="scale(1.1)"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                    <Border Width="56" Height="42"
                                            CornerRadius="{DynamicResource Radius.Md}"
                                            BorderThickness="2"
                                            Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                            Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Transitions">
                                                    <Transitions>
                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                    </Transitions>
                                                </Setter>
                                            </Style>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border CornerRadius="6" ClipToBounds="True">
                                            <Grid ColumnDefinitions="*,*,*">
                                                <Border Grid.Column="0" Background="{Binding PreviewColors[0]}"/>
                                                <Border Grid.Column="1" Background="{Binding PreviewColors[1]}"/>
                                                <Border Grid.Column="2" Background="{Binding PreviewColors[2]}"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Profile Picture Setting -->
        <DataTemplate x:Key="ProfilePictureSettingTemplate" x:DataType="vm:ProfilePictureSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <ItemsControl ItemsSource="{Binding Options}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" ClipToBounds="False" Margin="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfilePictureOptionViewModel">
                                <Button Command="{Binding SelectCommand}"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Transitions">
                                                <Transitions>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                                                </Transitions>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="RenderTransform" Value="scale(1.1)"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                    <Border Width="42" Height="42"
                                            CornerRadius="21"
                                            BorderThickness="2"
                                            Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                            Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Transitions">
                                                    <Transitions>
                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                    </Transitions>
                                                </Setter>
                                            </Style>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border CornerRadius="19" ClipToBounds="True">
                                            <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Name Setting -->
        <DataTemplate x:Key="NameSettingTemplate" x:DataType="vm:NameSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <TextBox Classes="settings-input" Text="{Binding UserName}"/>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Text Setting -->
        <DataTemplate x:Key="TextSettingTemplate" x:DataType="vm:TextSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <TextBox Classes="settings-input"
                             Text="{Binding Value}"
                             PasswordChar="{Binding IsPassword, Converter={StaticResource BoolToPasswordCharConverter}}"/>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Step Slider Setting -->
        <DataTemplate x:Key="StepSliderSettingTemplate" x:DataType="vm:StepSliderSettingViewModel">
            <components:SettingsRow Title="{Binding Title}" Description="{Binding Description}">
                <components:SettingsRow.RightContent>
                    <StackPanel Width="260" Spacing="4">
                        <Slider Minimum="0"
                                Maximum="{Binding MaxIndex}"
                                Value="{Binding SelectedIndex}"
                                IsEnabled="{Binding IsInteractionEnabled}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                MinHeight="30"
                                Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </components:SettingsRow.RightContent>
            </components:SettingsRow>
        </DataTemplate>

        <!-- Nav item: name, then an optional count badge or quiet status chip -->
        <DataTemplate x:Key="SettingsNavItemTemplate" x:DataType="vm:SettingsCategoryViewModel">
            <controls:NavigationButton IsSelected="{Binding IsSelected}"
                                       Height="28"
                                       Padding="8,0"
                                       FontSize="13"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       Command="{Binding SelectCommand}"
                                       CommandParameter="{Binding}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeText}"
                                   FontFamily="{DynamicResource Font.Monospace}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Border Background="{DynamicResource WorkspaceBackgroundBrush}"
                                BorderBrush="{DynamicResource SidebarBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding StatusTagText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding StatusTagText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:NavigationButton>
        </DataTemplate>

        <!-- Shared per-item template used by every rows list; picks the typed template above -->
        <DataTemplate x:Key="SettingItemTemplates">
            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                <ContentControl.DataTemplates>
                    <StaticResource ResourceKey="ToggleSettingTemplate"/>
                    <StaticResource ResourceKey="EnableAiAssistantToggleSettingTemplate"/>
                    <StaticResource ResourceKey="DropdownSettingTemplate"/>
                    <StaticResource ResourceKey="ModelPickerSettingTemplate"/>
                    <StaticResource ResourceKey="LanguageSettingTemplate"/>
                    <StaticResource ResourceKey="ActionSettingTemplate"/>
                    <StaticResource ResourceKey="AsyncActionSettingTemplate"/>
                    <StaticResource ResourceKey="AppIconSettingTemplate"/>
                    <StaticResource ResourceKey="ThemeSettingTemplate"/>
                    <StaticResource ResourceKey="ProfilePictureSettingTemplate"/>
                    <StaticResource ResourceKey="NameSettingTemplate"/>
                    <StaticResource ResourceKey="TextSettingTemplate"/>
                    <StaticResource ResourceKey="StepSliderSettingTemplate"/>
                    <StaticResource ResourceKey="NoticeSettingTemplate"/>
                    <StaticResource ResourceKey="SubheaderSettingTemplate"/>
                </ContentControl.DataTemplates>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="220,*">
        <!-- Settings navigation pane -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,14,12,12">
                <!-- Title (7 quick taps unlock the developer gate) -->
                <Button Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,0"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left"
                        Cursor="Arrow"
                        Command="{Binding SecretSettingsTitleTapCommand}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="Button:focus /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </Button.Styles>
                    <TextBlock Text="{markup:T Ns=Settings, Key=Title}"
                               FontSize="{DynamicResource FontSize.Heading6}"
                               FontFamily="{DynamicResource Font.SemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>

                <!-- Search -->
                <TextBox Grid.Row="1"
                         Classes="settings-search"
                         Margin="2,0"
                         Text="{Binding SearchText}"
                         PlaceholderText="{markup:T Ns=Settings, Key=SearchPlaceholder}">
                    <TextBox.InnerLeftContent>
                        <controls:AppIcon Icon="Common/search"
                                          Width="13" Height="13"
                                          Margin="8,0,0,0"
                                          Color="{DynamicResource TextFadedBrush}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- Nav sections -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Classes="settings-section-label"
                                   Text="{markup:T Ns=Settings, Key=NavAccount, Converter={x:Static converters:UpperCaseStringConverter.Instance}}"
                                   Margin="8,16,8,5"/>
                        <ItemsControl ItemsSource="{Binding NavAccountCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                                    <controls:NavigationButton IsSelected="{Binding IsSelected}"
                                                               Height="28"
                                                               Padding="8,0"
                                                               FontSize="13"
                                                               HorizontalAlignment="Stretch"
                                                               HorizontalContentAlignment="Stretch"
                                                               Command="{Binding SelectCommand}"
                                                               CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="16" Height="16" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center">
                                                <Image Source="{Binding ProfilePicturePath, Converter={StaticResource PathToImageConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </controls:NavigationButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="settings-section-label"
                                   Text="{markup:T Ns=Settings, Key=NavApp, Converter={x:Static converters:UpperCaseStringConverter.Instance}}"
                                   Margin="8,14,8,5"/>
                        <ItemsControl ItemsSource="{Binding NavAppCategories}"
                                      ItemTemplate="{StaticResource SettingsNavItemTemplate}"/>

                        <TextBlock Classes="settings-section-label"
                                   Text="{markup:T Ns=Settings, Key=NavModules, Converter={x:Static converters:UpperCaseStringConverter.Instance}}"
                                   Margin="8,14,8,5"/>
                        <ItemsControl ItemsSource="{Binding NavModuleCategories}"
                                      ItemTemplate="{StaticResource SettingsNavItemTemplate}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Version footer -->
                <TextBlock Grid.Row="3"
                           Text="{Binding VersionDisplay}"
                           FontFamily="{DynamicResource Font.Monospace}"
                           FontSize="10.5"
                           Foreground="{DynamicResource VersionTextBrush}"
                           Margin="8,10,0,0"/>
            </Grid>
        </Border>

        <!-- Settings content -->
        <Border Grid.Column="1" Background="{DynamicResource WorkspaceBackgroundBrush}">
            <ScrollViewer>
                <Border Padding="48,34,48,64" MaxWidth="716" HorizontalAlignment="Left">
                    <StackPanel>
                        <!-- Page header -->
                        <TextBlock Text="{Binding SelectedCategory.Name}"
                                   FontSize="{DynamicResource FontSize.Heading4}"
                                   FontFamily="{DynamicResource Font.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding CategorySubtitleText}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,6"/>

                        <!-- Groups -->
                        <ItemsControl ItemsSource="{Binding SelectedCategory.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsGroupViewModel">
                                    <StackPanel>
                                        <!-- Plain group: uppercase label + flat rows -->
                                        <StackPanel IsVisible="{Binding !HasMasterToggle}">
                                            <TextBlock Classes="settings-section-label"
                                                       Text="{Binding Name, Converter={x:Static converters:UpperCaseStringConverter.Instance}}"
                                                       IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Margin="0,24,0,2"/>
                                            <ItemsControl Classes="settings-rows"
                                                          ItemsSource="{Binding Items}"
                                                          ItemTemplate="{StaticResource SettingItemTemplates}"/>
                                        </StackPanel>

                                        <!-- Master group: header row gates the rows on an inset rail -->
                                        <StackPanel IsVisible="{Binding HasMasterToggle}">
                                            <Separator Height="1"
                                                       Background="{DynamicResource DividerSubtleBrush}"
                                                       Margin="0,18,0,0"/>
                                            <components:SettingsRow Title="{Binding MasterTitle}"
                                                                    Description="{Binding MasterDescription}"
                                                                    ShowDivider="False">
                                                <components:SettingsRow.RightContent>
                                                    <ToggleSwitch IsChecked="{Binding MasterToggleValue}"
                                                                  IsEnabled="{Binding MasterToggleInteractionEnabled}"/>
                                                </components:SettingsRow.RightContent>
                                            </components:SettingsRow>

                                            <Border IsVisible="{Binding IsContentVisible}"
                                                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                                                    BorderThickness="2,0,0,0"
                                                    Padding="20,0,0,6"
                                                    Margin="0,2,0,10">
                                                <ItemsControl Classes="settings-rows"
                                                              ItemsSource="{Binding Items}"
                                                              ItemTemplate="{StaticResource SettingItemTemplates}"/>
                                            </Border>

                                            <!-- Dashed reassurance box while the block is off -->
                                            <Grid IsVisible="{Binding IsOffNoticeVisible}" Margin="0,28,0,0">
                                                <Rectangle Stroke="{DynamicResource SidebarBorderBrush}"
                                                           StrokeThickness="1"
                                                           StrokeDashArray="4,3"
                                                           RadiusX="8" RadiusY="8"
                                                           Fill="Transparent"/>
                                                <TextBlock Text="{Binding OffNoticeDescription}"
                                                           Margin="24,18"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="18"
                                                           TextAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
