<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mnemo.UI.Controls"
             x:Class="Mnemo.UI.Modules.Mindmap.Views.MindmapSaveTemplateOverlay">
  <UserControl.Styles>
    <!-- Name field: quiet fill, accent ring on focus, constant thickness (no layout jump). -->
    <Style Selector="TextBox#NameBox">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Input}"/>
      <Style Selector="^:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      </Style>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource OverlayBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="24,22,24,20"
          MinWidth="380"
          MaxWidth="440">
    <StackPanel>
      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText"
                     FontFamily="{DynamicResource Font.SemiBold}"
                     FontSize="{DynamicResource FontSize.Heading6}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="DescriptionText"
                     FontFamily="{DynamicResource Font.Medium}"
                     FontSize="{DynamicResource FontSize.Body.Small}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     LineHeight="20"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <controls:AppButton Grid.Column="1"
                            Classes="ghost"
                            IconName="Common/x"
                            IconSize="16"
                            Padding="6"
                            Margin="0,-4,-6,0"
                            VerticalAlignment="Top"
                            Click="OnCancelClick"/>
      </Grid>

      <!-- Name -->
      <TextBox x:Name="NameBox" Margin="0,16,0,0"/>

      <!-- Levels to capture -->
      <StackPanel Margin="0,16,0,0" Spacing="8">
        <TextBlock x:Name="LevelsLabel"
                   FontFamily="{DynamicResource Font.SemiBold}"
                   FontSize="{DynamicResource FontSize.Body.Small}"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Border Classes="segment-track" HorizontalAlignment="Left">
          <StackPanel x:Name="LevelsPanel" Orientation="Horizontal" Spacing="2"/>
        </Border>
        <TextBlock x:Name="LevelsCaption"
                   FontFamily="{DynamicResource Font.Medium}"
                   FontSize="{DynamicResource FontSize.Caption}"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
      </StackPanel>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,20,0,0">
        <controls:AppButton x:Name="CancelButton" Classes="ghost" Click="OnCancelClick"/>
        <controls:AppButton x:Name="SaveButton" Classes="accent" IconName="Common/bookmark-plus" Click="OnSaveClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
