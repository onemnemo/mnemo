<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Mindmap.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:converters="using:Mnemo.UI.Converters"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Mnemo.UI.Modules.Mindmap.Views.MindmapOverviewView"
             x:DataType="vm:MindmapOverviewViewModel"
             x:CompileBindings="True"
             Foreground="{DynamicResource TextPrimaryBrush}"
             ClipToBounds="False"
             x:Name="root">

    <UserControl.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Library cards: quiet surface, shadow lift on hover (no border-thickness change). -->
        <Style Selector="Border.lib-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource Elevation.1}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover Border.lib-card">
            <Setter Property="BoxShadow" Value="{DynamicResource Elevation.2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
        </Style>

        <!-- Card buttons strip stock chrome so the card is the visible surface. -->
        <Style Selector="Button.card-host">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.card-host:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Overflow / more button on cards -->
        <Style Selector="Button.more">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Button.more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}"/>
        </Style>

        <!-- Card overflow: hidden until the card is hovered -->
        <Style Selector="Button.card-more">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card-host:pointerover Button.card-more">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.card-more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}"/>
        </Style>

        <!-- Toolbar sort button -->
        <Style Selector="Button.sort">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sort:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}"/>
        </Style>

        <!-- Breadcrumb crumb buttons -->
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="Button.crumb:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Segmented grid/list toggle -->
        <Style Selector="RadioButton.seg">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg controls|AppIcon">
            <Setter Property="Color" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="RadioButton.seg:checked">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
        </Style>
        <Style Selector="RadioButton.seg:checked controls|AppIcon">
            <Setter Property="Color" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="RadioButton.seg:pointerover controls|AppIcon">
            <Setter Property="Color" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Due badge -->
        <Style Selector="Border.due-badge">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- Dashed "new" tile -->
        <Style Selector="Border.new-tile">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card-host:pointerover Border.new-tile">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        </Style>

        <!-- Section eyebrow -->
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFadedBrush}"/>
        </Style>

        <!-- List rows -->
        <Style Selector="Border.list-row">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card-host:pointerover Border.list-row">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- ===== reusable fragments ===== -->
    <UserControl.DataTemplates>

        <!-- Folder card -->
        <DataTemplate DataType="vm:MindmapFolderItemViewModel">
            <Button Classes="card-host"
                    Command="{Binding $parent[UserControl].DataContext.OpenFolderCommand, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}"
                    Margin="0,0,18,18">
                <Border Classes="lib-card" ClipToBounds="True"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnFolderDragOver"
                        DragDrop.Drop="OnFolderDrop">
                    <StackPanel>
                        <!-- stacked thumbnail -->
                        <Panel Height="120" Background="{DynamicResource CardBackgroundSecondaryBrush}" ClipToBounds="True">
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0"
                                    Background="{DynamicResource WorkspaceBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Pill}" Padding="8,2">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <controls:AppIcon Icon="Common/folder" Width="11" Height="11" Color="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{markup:T Ns=Mindmap, Key=Folder}" FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <!-- borrowed preview from newest child map -->
                            <Panel Width="150" Height="80" IsVisible="{Binding HasPreview}">
                                <ItemsControl ItemsSource="{Binding EdgePreviews}" IsHitTestVisible="False"
                                              Width="240" Height="120" RenderTransform="scale(0.6)">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="240" Height="120"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EdgePreviewViewModel">
                                            <Line StartPoint="{Binding StartPoint}" EndPoint="{Binding EndPoint}"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6" Opacity="0.45"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding NodePreviews}" IsHitTestVisible="False"
                                              Width="240" Height="120" RenderTransform="scale(0.6)">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="240" Height="120"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NodePreviewViewModel">
                                            <Ellipse Width="{Binding Size}" Height="{Binding Size}" Fill="{Binding Fill}" Margin="{Binding CenterMargin}">
                                                <Ellipse.RenderTransform><TranslateTransform X="{Binding X}" Y="{Binding Y}"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                            <controls:AppIcon Icon="Common/folder" Width="40" Height="40" Color="{DynamicResource TextFadedBrush}"
                                              IsVisible="{Binding !HasPreview}"/>
                            <Button Classes="card-more">
                                <controls:AppIcon Icon="Common/dots-vertical" Width="15" Height="15" Color="{DynamicResource TextTertiaryBrush}"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{markup:T Ns=Mindmap, Key=Rename}"
                                                  Command="{Binding $parent[UserControl].DataContext.RenameFolderCommand, FallbackValue={x:Null}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><controls:AppIcon Icon="Flyout/rename" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{markup:T Ns=Mindmap, Key=Delete}" Classes="danger"
                                                  Command="{Binding $parent[UserControl].DataContext.DeleteFolderCommand, FallbackValue={x:Null}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><controls:AppIcon Icon="Common/trash" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Panel>
                        <!-- footer -->
                        <Grid ColumnDefinitions="*,Auto" Margin="14,11">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.SemiBold}"
                                           FontSize="{DynamicResource FontSize.Body.Small}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MetaLine}" FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextFadedBrush}"/>
                            </StackPanel>
                            <controls:AppIcon Grid.Column="1" Icon="Common/chevron-right" Width="14" Height="14"
                                              Color="{DynamicResource TextFadedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Map card -->
        <DataTemplate DataType="vm:MindmapItemViewModel">
            <Button Classes="card-host"
                    Command="{Binding $parent[UserControl].DataContext.OpenMindmapCommand, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}"
                    Margin="0,0,18,18">
                <Border Classes="lib-card" ClipToBounds="True"
                        PointerPressed="OnMapCardPointerPressed"
                        PointerMoved="OnMapCardPointerMoved"
                        PointerReleased="OnMapCardPointerReleased">
                    <StackPanel>
                        <!-- graph thumbnail -->
                        <Panel Height="120" Background="{DynamicResource CardBackgroundSecondaryBrush}" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding EdgePreviews}" IsHitTestVisible="False"
                                          Width="240" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="240" Height="120"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EdgePreviewViewModel">
                                        <Line StartPoint="{Binding StartPoint}" EndPoint="{Binding EndPoint}"
                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6" Opacity="0.5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding NodePreviews}" IsHitTestVisible="False"
                                          Width="240" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="240" Height="120"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NodePreviewViewModel">
                                        <Ellipse Width="{Binding Size}" Height="{Binding Size}" Fill="{Binding Fill}" Margin="{Binding CenterMargin}">
                                            <Ellipse.RenderTransform><TranslateTransform X="{Binding X}" Y="{Binding Y}"/></Ellipse.RenderTransform>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="card-more">
                                <controls:AppIcon Icon="Common/dots-vertical" Width="15" Height="15" Color="{DynamicResource TextTertiaryBrush}"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{markup:T Ns=Mindmap, Key=Rename}" Tag="{Binding}" Click="OnMindmapRenameClick">
                                            <MenuItem.Icon><controls:AppIcon Icon="Flyout/rename" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{markup:T Ns=Mindmap, Key=Duplicate}" Tag="{Binding}" Click="OnMindmapDuplicateClick">
                                            <MenuItem.Icon><controls:AppIcon Icon="Flyout/duplicate" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{markup:T Ns=Mindmap, Key=Export}" Tag="{Binding}" Click="OnMindmapExportClick">
                                            <MenuItem.Icon><controls:AppIcon Icon="Flyout/export" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{markup:T Ns=Mindmap, Key=Delete}" Classes="danger" Tag="{Binding}" Click="OnMindmapDeleteClick">
                                            <MenuItem.Icon><controls:AppIcon Icon="Common/trash" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Panel>
                        <!-- footer -->
                        <StackPanel Margin="14,10" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.SemiBold}"
                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MetaLine}" FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{DynamicResource TextFadedBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Classes="due-badge" IsVisible="{Binding HasDue}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <controls:AppIcon Icon="Sidebar/flashcard" Width="10" Height="10" Color="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding DueLabel}" FontSize="{DynamicResource FontSize.Caption}"
                                                   FontFamily="{DynamicResource Font.Medium}" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding AccentDots}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <Ellipse Width="8" Height="8" Fill="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" Text="{Binding LayoutLabel}"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextFadedBrush}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Dashed new-map tile (folder view) -->
        <DataTemplate DataType="vm:MindmapNewTilePlaceholder">
            <Button Classes="card-host"
                    Command="{Binding $parent[UserControl].DataContext.CreateCommand, FallbackValue={x:Null}}"
                    Margin="0,0,18,18">
                <Border Classes="new-tile" MinHeight="180">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                        <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius.Md}"
                                Background="{DynamicResource CardBackgroundSecondaryBrush}">
                            <controls:AppIcon Icon="Common/plus" Width="18" Height="18" Color="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding $parent[UserControl].DataContext.NewTileLabel, FallbackValue=''}"
                                   FontFamily="{DynamicResource Font.Medium}"
                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}" Spacing="18">

            <!-- breadcrumb (folder view) -->
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsFolderView}">
                <Button Classes="crumb" Command="{Binding NavigateUpCommand}" ToolTip.Tip="{markup:T Ns=Mindmap, Key=Back}" Padding="4">
                    <controls:AppIcon Icon="Common/chevron-left" Width="14" Height="14" Color="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MindmapBreadcrumbSegment">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="crumb"
                                        Command="{Binding $parent[UserControl].DataContext.NavigateToFolderCommand, FallbackValue={x:Null}}"
                                        CommandParameter="{Binding Id}"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnFolderDragOver"
                                        DragDrop.Drop="OnCrumbDrop">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                </Button>
                                <TextBlock Text="/" Foreground="{DynamicResource TextFadedBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- page / folder head -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- left: root or folder head -->
                <Panel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Spacing="3" IsVisible="{Binding IsRootView}">
                        <TextBlock Text="{markup:T Ns=Mindmap, Key=Title}"
                                   FontSize="{DynamicResource FontSize.Heading1}"
                                   FontFamily="{DynamicResource Font.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding HeaderCountLine}"
                                   FontSize="{DynamicResource FontSize.Body.Small}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsFolderView}">
                        <Border Width="38" Height="38" CornerRadius="{DynamicResource Radius.Md}"
                                Background="{DynamicResource CardBackgroundSecondaryBrush}">
                            <controls:AppIcon Icon="Common/folder" Width="19" Height="19" Color="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentFolderName}"
                                       FontSize="{DynamicResource FontSize.Heading1}"
                                       FontFamily="{DynamicResource Font.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding HeaderCountLine}"
                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Panel>

                <!-- right: actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:AppButton Classes="outline"
                                        IconName="Common/download"
                                        IconSize="14"
                                        IsVisible="{Binding IsRootView}"
                                        Tag="transfer" Click="OnTransferClick"
                                        Content="{markup:T Ns=Mindmap, Key=Transfer}"/>

                    <!-- folder overflow -->
                    <controls:AppButton Classes="outline" IconName="Common/dots-vertical" IconSize="16"
                                        IsVisible="{Binding IsFolderView}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=FolderActions}">
                        <controls:AppButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=Rename}" Command="{Binding RenameCurrentFolderCommand}">
                                    <MenuItem.Icon><controls:AppIcon Icon="Flyout/rename" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=Delete}" Classes="danger" Command="{Binding DeleteCurrentFolderCommand}">
                                    <MenuItem.Icon><controls:AppIcon Icon="Common/trash" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </controls:AppButton.Flyout>
                    </controls:AppButton>

                    <controls:AppButton Classes="accent" IconName="Common/plus" IconSize="16"
                                        Content="{markup:T Ns=Mindmap, Key=New}">
                        <controls:AppButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=NewMenuMap}" Command="{Binding CreateCommand}">
                                    <MenuItem.Icon><controls:AppIcon Icon="Common/chart-bubble" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=NewMenuFolder}" Command="{Binding CreateFolderCommand}">
                                    <MenuItem.Icon><controls:AppIcon Icon="Common/folder" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </controls:AppButton.Flyout>
                    </controls:AppButton>
                </StackPanel>
            </Grid>

            <!-- jump back in (root) -->
            <StackPanel Spacing="9" IsVisible="{Binding ShowRecent}">
                <TextBlock Text="{markup:T Ns=Mindmap, Key=JumpBackIn}" Classes="eyebrow"/>
                <ItemsControl ItemsSource="{Binding RecentItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MindmapItemViewModel">
                            <Button Classes="card-host"
                                    Command="{Binding $parent[UserControl].DataContext.OpenMindmapCommand, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,12,0">
                                <Border Classes="lib-card" Padding="9">
                                    <Grid ColumnDefinitions="Auto,*" >
                                        <Border Grid.Column="0" Width="68" Height="54" CornerRadius="{DynamicResource Radius.Sm}"
                                                Background="{DynamicResource CardBackgroundSecondaryBrush}" ClipToBounds="True" Margin="0,0,11,0">
                                            <Panel>
                                                <ItemsControl ItemsSource="{Binding EdgePreviews}" IsHitTestVisible="False"
                                                              Width="240" Height="120" RenderTransform="scale(0.28)"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="240" Height="120"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:EdgePreviewViewModel">
                                                            <Line StartPoint="{Binding StartPoint}" EndPoint="{Binding EndPoint}"
                                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="2" Opacity="0.5"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding NodePreviews}" IsHitTestVisible="False"
                                                              Width="240" Height="120" RenderTransform="scale(0.28)"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="240" Height="120"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NodePreviewViewModel">
                                                            <Ellipse Width="{Binding Size}" Height="{Binding Size}" Fill="{Binding Fill}" Margin="{Binding CenterMargin}">
                                                                <Ellipse.RenderTransform><TranslateTransform X="{Binding X}" Y="{Binding Y}"/></Ellipse.RenderTransform>
                                                            </Ellipse>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.SemiBold}"
                                                       FontSize="{DynamicResource FontSize.Body.Small}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ContextLine}" FontSize="{DynamicResource FontSize.Caption}"
                                                       Foreground="{DynamicResource TextFadedBrush}"/>
                                            <ItemsControl ItemsSource="{Binding AccentDots}" Margin="0,3,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False"><Ellipse Width="8" Height="8" Fill="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- toolbar -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding !ShowEmptyState}">
                <TextBlock Grid.Column="0" Text="{Binding MapsHeaderLabel}"
                           FontFamily="{DynamicResource Font.SemiBold}"
                           FontSize="{DynamicResource FontSize.Body.Small}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding MapsHeaderCount}" Margin="8,0,0,0"
                           FontFamily="{DynamicResource Font.Monospace}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextFadedBrush}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="sort">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SortLabel}" FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <controls:AppIcon Icon="Common/chevron-down" Width="10" Height="10"
                                              Color="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=SortRecent}" Command="{Binding SetSortCommand}" CommandParameter="Recent"/>
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=SortName}" Command="{Binding SetSortCommand}" CommandParameter="Name"/>
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=SortNodes}" Command="{Binding SetSortCommand}" CommandParameter="Nodes"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Border Background="{DynamicResource CardBackgroundSecondaryBrush}" CornerRadius="{DynamicResource Radius.Sm}" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <RadioButton Classes="seg" GroupName="mmview" IsChecked="{Binding IsGridView}" ToolTip.Tip="{markup:T Ns=Mindmap, Key=ViewGrid}">
                                <controls:AppIcon Icon="Common/layout-grid" Width="16" Height="16"/>
                            </RadioButton>
                            <RadioButton Classes="seg" GroupName="mmview" ToolTip.Tip="{markup:T Ns=Mindmap, Key=ViewList}"
                                         IsChecked="{Binding IsGridView, Converter={StaticResource BoolNegationConverter}}">
                                <controls:AppIcon Icon="Common/list-details" Width="16" Height="16"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- items -->
            <Panel>
                <!-- grid view -->
                <ItemsControl ItemsSource="{Binding GridItems}" IsVisible="{Binding IsGridView}" Margin="0,0,-18,-18">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- list view -->
                <ItemsControl ItemsSource="{Binding GridItems}" IsVisible="{Binding !IsGridView}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:MindmapFolderItemViewModel">
                            <Button Classes="card-host"
                                    Command="{Binding $parent[UserControl].DataContext.OpenFolderCommand, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}">
                                <Border Classes="list-row">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Sm}"
                                                Background="{DynamicResource CardBackgroundSecondaryBrush}" Margin="0,0,12,0">
                                            <controls:AppIcon Icon="Common/folder" Width="17" Height="17" Color="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.SemiBold}"
                                                       FontSize="{DynamicResource FontSize.Body.Small}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding MetaLine}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextFadedBrush}"/>
                                        </StackPanel>
                                        <controls:AppIcon Grid.Column="2" Icon="Common/chevron-right" Width="14" Height="14"
                                                          Color="{DynamicResource TextFadedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="vm:MindmapItemViewModel">
                            <Button Classes="card-host"
                                    Command="{Binding $parent[UserControl].DataContext.OpenMindmapCommand, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}">
                                <Border Classes="list-row">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="{DynamicResource Radius.Sm}"
                                                Background="{DynamicResource CardIconBackgroundBrush}" Margin="0,0,12,0">
                                            <controls:AppIcon Icon="Common/chart-bubble" Width="17" Height="17" Color="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.SemiBold}"
                                                       FontSize="{DynamicResource FontSize.Body.Small}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding MetaLine}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextFadedBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="due-badge" IsVisible="{Binding HasDue}" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding DueLabel}" FontSize="{DynamicResource FontSize.Caption}"
                                                       FontFamily="{DynamicResource Font.Medium}" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding LayoutLabel}" VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource Font.Monospace}" FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource TextFadedBrush}" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="vm:MindmapNewTilePlaceholder">
                            <Button Classes="card-host"
                                    Command="{Binding $parent[UserControl].DataContext.CreateCommand, FallbackValue={x:Null}}">
                                <Border Classes="new-tile" Padding="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <controls:AppIcon Icon="Common/plus" Width="16" Height="16" Color="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding $parent[UserControl].DataContext.NewTileLabel, FallbackValue=''}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource Font.Medium}" FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>

                <!-- empty / no-results -->
                <components:EmptyState IsVisible="{Binding ShowEmptyState}"
                                       IconPath="avares://Mnemo.UI/Icons/Common/chart-bubble.svg"
                                       Title="{markup:T Ns=Mindmap, Key=LibraryEmptyTitle}"
                                       Description="{markup:T Ns=Mindmap, Key=LibraryEmptyDescription}"
                                       ActionText="{markup:T Ns=Mindmap, Key=NewMindmap}"
                                       ActionCommand="{Binding CreateCommand}"
                                       Margin="0,48,0,0"/>
                <components:EmptyState IsVisible="{Binding ShowNoResultsState}"
                                       IconPath="avares://Mnemo.UI/Icons/Common/search.svg"
                                       Title="{markup:T Ns=Mindmap, Key=NoResultsTitle}"
                                       Description="{markup:T Ns=Mindmap, Key=NoResultsDescription}"
                                       Margin="0,48,0,0"/>
            </Panel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
