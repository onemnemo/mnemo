<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mnemo.UI.Modules.Mindmap.ViewModels"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:converters="using:Mnemo.UI.Converters"
             xmlns:components="using:Mnemo.UI.Components"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Mnemo.UI.Modules.Mindmap.Views.MindmapOverviewView"
             x:DataType="vm:MindmapOverviewViewModel"
             Foreground="{DynamicResource TextPrimaryBrush}"
             x:Name="root">

    <UserControl.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
        <converters:DataContextToOverviewCommandConverter x:Key="OpenMindmapCommandConverter" ReturnDeleteCommand="False"/>
        <converters:DataContextToOverviewCommandConverter x:Key="DeleteMindmapCommandConverter" ReturnDeleteCommand="True"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="RadioButton.ToggleViewItem">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.ToggleViewItem controls|SvgIcon">
            <Setter Property="Color" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="RadioButton.ToggleViewItem:checked">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton.ToggleViewItem:checked controls|SvgIcon">
            <Setter Property="Color" Value="{DynamicResource CardAccentBrush}"/>
        </Style>
        <Style Selector="RadioButton.ToggleViewItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}"/>
        </Style>

        <Style Selector="Border.CardHover:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardAccentBrush}"/>
        </Style>
        <Style Selector="Border.FeaturedCardHover:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="ZIndex" Value="1"/>
        </Style>
        <Style Selector="Border.FeaturedCardHover">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </Style>

        <Style Selector="Button[Background=Transparent]:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button[Background=Transparent]:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,32" Spacing="28">
            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="{markup:T Ns=Mindmap, Key=Title}" 
                               FontSize="{DynamicResource FontSize.Heading1}" 
                               FontFamily="{DynamicResource Font.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{markup:T Ns=Mindmap, Key=Subtitle}" 
                               FontSize="{DynamicResource FontSize.Body.Medium}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost"
                            Padding="10,8"
                            Click="OnTransferClick"
                            Tag="transfer">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/export.svg" Width="16" Height="16"/>
                            <TextBlock Text="{markup:T Ns=Mindmap, Key=Transfer}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CreateCommand}"
                            Classes="accent"
                            BorderThickness="0"
                            Padding="16,10" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/plus.svg"
                                              Width="18" Height="18"
                                              Color="{DynamicResource AccentButtonForegroundBrush}"/>
                            <TextBlock Text="{markup:T Ns=Mindmap, Key=NewMindmap}"
                                       FontFamily="{DynamicResource Font.SemiBold}"
                                       Foreground="{DynamicResource AccentButtonForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Featured / Recently Active -->
            <StackPanel Spacing="20" IsVisible="{Binding !!FrequentlyUsedItems.Count}">
                <TextBlock Text="{markup:T Ns=Mindmap, Key=RecentlyActive}" 
                           FontSize="{DynamicResource FontSize.Heading3}" 
                           FontFamily="{DynamicResource Font.SemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                
                <ListBox ItemsSource="{Binding FrequentlyUsedItems}" 
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ClipToBounds="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" Margin="5,10,20,20"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:MindmapItemViewModel">
                            <Button Command="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource OpenMindmapCommandConverter}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,20,0">
                                <Border Width="280" Height="170"
                                        Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                        Cursor="Hand"
                                        CornerRadius="{DynamicResource Radius.Xl}" ClipToBounds="True"
                                        Classes="FeaturedCardHover">
                                        <Panel>
                                            <!-- Background Decoration -->
                                            <Ellipse Width="180" Height="180" Fill="{DynamicResource CardAccentBrush}" 
                                                     Opacity="0.04" Margin="-60,-60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <Ellipse Width="120" Height="120" Fill="{DynamicResource CardAccentBrush}" 
                                                     Opacity="0.02" Margin="0,0,-40,-40" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            
                                            <!-- Abstract Preview -->
                                            <ItemsControl ItemsSource="{Binding EdgePreviews}" IsHitTestVisible="False" Opacity="0.15">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:EdgePreviewViewModel">
                                                        <Line StartPoint="{Binding StartPoint}" 
                                                              EndPoint="{Binding EndPoint}"
                                                              Stroke="{DynamicResource CardAccentBrush}" StrokeThickness="1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding NodePreviews}" IsHitTestVisible="False" Opacity="0.3">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:NodePreviewViewModel">
                                                        <Ellipse Width="4" Height="4" Fill="{DynamicResource CardAccentBrush}">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform X="{Binding X}" Y="{Binding Y}"/>
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid RowDefinitions="Auto,*,Auto" Margin="24">
                                                <Grid Grid.Row="0">
                                                    <Border HorizontalAlignment="Left" Padding="10,5" 
                                                            Background="{DynamicResource SearchBarBackgroundBrush}" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/chart-bubble.svg" 
                                                                              Width="12" Height="12" Color="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{markup:T Ns=Mindmap, Key=MindmapLabel}" 
                                                                       FontSize="{DynamicResource FontSize.Caption}" 
                                                                       FontFamily="{DynamicResource Font.Bold}" 
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Button HorizontalAlignment="Right"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="6"
                                                            Cursor="Hand">
                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/dots-vertical.svg"
                                                                          Width="16" Height="16"
                                                                          Color="{DynamicResource TextTertiaryBrush}"/>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuItem Header="{markup:T Ns=Mindmap, Key=Rename}" Tag="{Binding}" Click="OnMindmapRenameClick">
                                                                    <MenuItem.Icon>
                                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/rename.svg" Width="16" Height="16"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="{markup:T Ns=Mindmap, Key=Duplicate}" Tag="{Binding}" Click="OnMindmapDuplicateClick">
                                                                    <MenuItem.Icon>
                                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/duplicate.svg" Width="16" Height="16"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="{markup:T Ns=Mindmap, Key=Export}" Tag="{Binding}" Click="OnMindmapExportClick">
                                                                    <MenuItem.Icon>
                                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/export.svg" Width="16" Height="16"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="{markup:T Ns=Mindmap, Key=Delete}" Classes="danger" Tag="{Binding}" Click="OnMindmapDeleteClick">
                                                                    <MenuItem.Icon>
                                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/trash.svg" Width="16" Height="16"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                                
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" 
                                                           FontSize="{DynamicResource FontSize.Heading5}" 
                                                           FontFamily="{DynamicResource Font.SemiBold}" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                
                                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding NodeStats}">
                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/sitemap.svg" 
                                                                              Width="14" Height="14" Color="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding NodeCount}" 
                                                                       FontSize="{DynamicResource FontSize.Body.ExtraSmall}" 
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding EdgeStats}">
                                                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/link.svg" 
                                                                              Width="14" Height="14" Color="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding EdgeCount}" 
                                                                       FontSize="{DynamicResource FontSize.Body.ExtraSmall}" 
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding LastModified}" 
                                                               FontSize="{DynamicResource FontSize.Body.ExtraSmall}" 
                                                               Foreground="{DynamicResource TextTertiaryBrush}" 
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Panel>
                                    </Border>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Library -->
            <StackPanel Spacing="25">
                <TextBlock Text="{markup:T Ns=Mindmap, Key=Library}" 
                           FontSize="{DynamicResource FontSize.Heading3}" 
                           FontFamily="{DynamicResource Font.SemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Modern Toolbar -->
                <DockPanel LastChildFill="False">
                    <TextBox PlaceholderText="{markup:T Ns=Mindmap, Key=SearchMindmaps}"
                             Classes="page-search"
                             Width="320"
                             Text="{Binding SearchText}"
                             VerticalContentAlignment="Center"
                             DockPanel.Dock="Left">
                        <TextBox.InnerLeftContent>
                            <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/search.svg" 
                                              Width="16" Height="16" 
                                              Margin="12,0,0,0"
                                              Color="{DynamicResource TextSecondaryBrush}"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" Spacing="12" DockPanel.Dock="Right">
                        <Border CornerRadius="12" Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <RadioButton Classes="ToggleViewItem" IsChecked="{Binding IsGridView, Converter={StaticResource BoolNegationConverter}}">
                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/list-details.svg" Width="18" Height="18"/>
                                </RadioButton>
                                <RadioButton Classes="ToggleViewItem" IsChecked="{Binding IsGridView}">
                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/layout-grid.svg" Width="18" Height="18"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Items View -->
                <Panel>
                    <!-- Grid View -->
                    <ListBox ItemsSource="{Binding FilteredItems}" 
                             IsVisible="{Binding IsGridView}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:MindmapItemViewModel">
                                <Button Command="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource OpenMindmapCommandConverter}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,20,20">
                                    <Border Padding="20" Background="{DynamicResource CardBackgroundSecondaryBrush}" Cursor="Hand"
                                            CornerRadius="{DynamicResource Radius.Xl}" MinWidth="180" MaxWidth="220" Height="180" Classes="CardHover"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.Md}" Background="{DynamicResource CardIconBackgroundBrush}">
                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/chart-bubble.svg"
                                                                          Width="20" Height="20" Color="{DynamicResource CardAccentBrush}"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                         <TextBlock Text="{markup:T Ns=Mindmap, Key=MindmapLabel}" 
                                                                    FontSize="{DynamicResource FontSize.CaptionButton}" 
                                                                    Foreground="{DynamicResource TextTertiaryBrush}" 
                                                                    FontFamily="{DynamicResource Font.SemiBold}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="6"
                                                        Cursor="Hand">
                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/dots-vertical.svg"
                                                                      Width="14" Height="14"
                                                                      Color="{DynamicResource TextTertiaryBrush}"/>
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Rename}" Tag="{Binding}" Click="OnMindmapRenameClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/rename.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Duplicate}" Tag="{Binding}" Click="OnMindmapDuplicateClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/duplicate.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Export}" Tag="{Binding}" Click="OnMindmapExportClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/export.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Delete}" Classes="danger" Tag="{Binding}" Click="OnMindmapDeleteClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/trash.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="{DynamicResource FontSize.Heading5}"
                                                       FontFamily="{DynamicResource Font.SemiBold}" TextWrapping="Wrap" Margin="0,12,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Top" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            
                                            <StackPanel Grid.Row="2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding NodeStats}">
                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/sitemap.svg" 
                                                                          Width="12" Height="12" Color="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding NodeCount}" 
                                                                   FontSize="{DynamicResource FontSize.Caption}" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding EdgeStats}">
                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/link.svg" 
                                                                          Width="12" Height="12" Color="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding EdgeCount}" 
                                                                   FontSize="{DynamicResource FontSize.Caption}" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastModified}" 
                                                           FontSize="{DynamicResource FontSize.Caption}" 
                                                           Foreground="{DynamicResource TextTertiaryBrush}" 
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- List View -->
                    <StackPanel Spacing="10" IsVisible="{Binding !IsGridView}">
                        <!-- Custom List Header -->
                        <Border Padding="12,8" Margin="0,0,0,5">
                            <Grid ColumnDefinitions="48,*,150,170,40">
                                <TextBlock Grid.Column="1" Text="{markup:T Ns=Mindmap, Key=ColumnName}" 
                                           FontSize="{DynamicResource FontSize.Caption}" 
                                           FontFamily="{DynamicResource Font.Bold}" 
                                           Foreground="{DynamicResource TextTertiaryBrush}" 
                                           Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{markup:T Ns=Mindmap, Key=LastModified}" 
                                           FontSize="{DynamicResource FontSize.Caption}" 
                                           FontFamily="{DynamicResource Font.Bold}" 
                                           Foreground="{DynamicResource TextTertiaryBrush}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{markup:T Ns=Mindmap, Key=NodesEdges}" 
                                           FontSize="{DynamicResource FontSize.Caption}" 
                                           FontFamily="{DynamicResource Font.Bold}" 
                                           Foreground="{DynamicResource TextTertiaryBrush}" 
                                           HorizontalAlignment="Right" 
                                           Margin="0,0,10,0"/>
                            </Grid>
                        </Border>

                        <ListBox ItemsSource="{Binding FilteredItems}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:MindmapItemViewModel">
                                    <Button Command="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource OpenMindmapCommandConverter}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch">
                                        <Border Background="{DynamicResource CardBackgroundSecondaryBrush}" CornerRadius="{DynamicResource Radius.Lg}" Margin="0,0,0,8" Padding="12" Classes="CardHover" ClipToBounds="True" Cursor="Hand"
                                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                            <Grid ColumnDefinitions="48,*,150,170,40">
                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{DynamicResource Radius.Md}" Background="{DynamicResource CardIconBackgroundBrush}">
                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/chart-bubble.svg"
                                                                      Width="20" Height="20" Color="{DynamicResource CardAccentBrush}"/>
                                                </Border>
    
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="{DynamicResource FontSize.Body.Small}" 
                                                               FontFamily="{DynamicResource Font.SemiBold}" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
    
                                                <TextBlock Grid.Column="2" Text="{Binding LastModified}" 
                                                           VerticalAlignment="Center" 
                                                           FontSize="{DynamicResource FontSize.Body.ExtraSmall}" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                                           HorizontalAlignment="Center"/>
    
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding NodeStats}">
                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/sitemap.svg" 
                                                                          Width="14" Height="14" Color="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding NodeCount}" 
                                                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding EdgeStats}">
                                                        <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/link.svg" 
                                                                          Width="14" Height="14" Color="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding EdgeCount}" 
                                                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Column="4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="6"
                                                        Cursor="Hand">
                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/dots-vertical.svg"
                                                                      Width="16" Height="16"
                                                                      Color="{DynamicResource TextTertiaryBrush}"/>
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Rename}" Tag="{Binding}" Click="OnMindmapRenameClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/rename.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Duplicate}" Tag="{Binding}" Click="OnMindmapDuplicateClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/duplicate.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Export}" Tag="{Binding}" Click="OnMindmapExportClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Flyout/export.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{markup:T Ns=Mindmap, Key=Delete}" Classes="danger" Tag="{Binding}" Click="OnMindmapDeleteClick">
                                                                <MenuItem.Icon>
                                                                    <controls:SvgIcon SvgPath="avares://Mnemo.UI/Icons/Common/trash.svg" Width="16" Height="16"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <components:EmptyState IsVisible="{Binding ShowEmptyState}"
                                           IconPath="avares://Mnemo.UI/Icons/Common/chart-bubble.svg"
                                           Title="{markup:T Ns=Mindmap, Key=LibraryEmptyTitle}"
                                           Description="{markup:T Ns=Mindmap, Key=LibraryEmptyDescription}"
                                           ActionText="{markup:T Ns=Mindmap, Key=NewMindmap}"
                                           ActionCommand="{Binding CreateCommand}"
                                           Margin="0,48,0,0"/>
                    <components:EmptyState IsVisible="{Binding ShowNoResultsState}"
                                           IconPath="avares://Mnemo.UI/Icons/Common/search.svg"
                                           Title="{markup:T Ns=Mindmap, Key=NoResultsTitle}"
                                           Description="{markup:T Ns=Mindmap, Key=NoResultsDescription}"
                                           Margin="0,48,0,0"/>
                </Panel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
