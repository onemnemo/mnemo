<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mnemo.UI.Modules.Mindmap.ViewModels"
             xmlns:views="using:Mnemo.UI.Modules.Mindmap.Views"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:conv="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Mnemo.UI.Modules.Mindmap.Views.MindmapView"
             x:CompileBindings="True"
             x:DataType="vm:MindmapViewModel">

    <UserControl.Resources>
        <conv:EqualsConverter x:Key="EnumEquals"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.mmSwatch">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.mmSwatch:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button.mmSwatch.active">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingChromeForegroundStrongBrush}"/>
        </Style>
        <Style Selector="Button.mmTool">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource FloatingChromeForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.mmTool:pointerover">
            <Setter Property="Background" Value="{DynamicResource FloatingChromeHoverBrush}"/>
        </Style>
        <!-- Bottom tool pill buttons: larger square hit target inside the rounded pill. -->
        <Style Selector="Button.mmPill">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.mmPill:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        </Style>
        <!-- Active tool (e.g. connect mode engaged): accent fill so the mode is obvious. -->
        <Style Selector="Button.mmPill.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Radial toolkit: circular icon buttons on the dark floating surface; terracotta on hover / when active. -->
        <Style Selector="Button.mmRadial">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource FloatingChromeHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mmRadial:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.mmRadial.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Shape flyout: white popover card; tiles show a shape glyph over a small label. -->
        <Style Selector="FlyoutPresenter.mmShapeFlyout">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Button.shapeTile">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.shapeTile:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.shapeTileBody">
            <Setter Property="Spacing" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.shapeTile TextBlock.shapeTileLabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.mmTool.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}"/>
        </Style>
        <Style Selector="Button.mmTool:disabled">
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <!-- Inspector panel -->
        <Style Selector="Button.insToggle.active">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.insTitle">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.insHeader">
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="Button.insSwatch">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.insSwatch:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button.insSwatch.active">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.insTool">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerSubtleBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.insTool:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.insTool.active">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.insReset">
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.insReset:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.insReset:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Inline label editor: an overlay TextBox that sits flush over the element/edge being renamed. -->
        <Style Selector="TextBox.mmLabelEditor">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Top bar -->
        <Border Grid.Row="0" Height="44" Background="{DynamicResource WorkspaceBackgroundBrush}"
                BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,12,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Classes="ghost" Click="OnBackClick"
                        Name="BackButton" Padding="6" Background="Transparent" BorderThickness="0">
                    <controls:AppIcon Icon="Common/chevron-left" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <controls:ModernComboBox Classes="compact" MinWidth="128" VerticalAlignment="Center"
                                             ItemsSource="{Binding TemplateOptions}"
                                             SelectedItem="{Binding SelectedTemplateOption}"
                                             ToolTip.Tip="{markup:T Ns=Mindmap, Key=TemplateTip}">
                        <controls:ModernComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MindmapTemplateOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </controls:ModernComboBox.ItemTemplate>
                    </controls:ModernComboBox>
                    <Button Classes="ghost" Padding="6" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SelectedTemplateOption.IsUser, FallbackValue=False}"
                            Command="{Binding DeleteSelectedTemplateCommand}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=DeleteTemplate}">
                        <controls:AppIcon Icon="Common/trash" Width="15" Height="15"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <controls:ModernComboBox Classes="compact" MinWidth="118" VerticalAlignment="Center"
                                             ItemsSource="{Binding LayoutOptions}"
                                             SelectedItem="{Binding SelectedLayoutOption}"
                                             ToolTip.Tip="{markup:T Ns=Mindmap, Key=LayoutTip}">
                        <controls:ModernComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MindmapLayoutOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </controls:ModernComboBox.ItemTemplate>
                    </controls:ModernComboBox>
                    <TextBlock Text="{Binding ZoomLabel}" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Button Classes="ghost insToggle" Padding="6" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" CornerRadius="6"
                            Command="{Binding ToggleInspectorCommand}"
                            Classes.active="{Binding IsInspectorOpen}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=InspectorTip}">
                        <controls:AppIcon Icon="Common/palette" Width="16" Height="16"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Classes="ghost" Padding="6" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" CornerRadius="6"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ExportTip}">
                        <controls:AppIcon Icon="Common/download" Width="16" Height="16"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=ExportPng}" Click="OnExportPngClick"/>
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=ExportSvg}" Click="OnExportSvgClick"/>
                                <MenuItem Header="{markup:T Ns=Mindmap, Key=ExportMd}" Click="OnExportMdClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Button Grid.Column="4" Name="RecenterButton" Classes="ghost" Padding="6"
                        Background="Transparent" BorderThickness="0" Command="{Binding RecenterCommand}"
                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=Recenter}">
                    <controls:AppIcon Icon="Common/crosshair" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Canvas + docked style inspector -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <Border Grid.Column="0" Name="CanvasHost" ClipToBounds="True"
                Background="{DynamicResource WorkspaceBackgroundBrush}">
          <Grid>
            <views:MindmapGridBackground Transform="{Binding CanvasTransform}"
                                         DotBrush="{DynamicResource DividerSubtleBrush}"/>
            <views:MindmapCanvasControl Name="World"
                                        Nodes="{Binding Nodes}"
                                        Edges="{Binding Edges}"
                                        Transform="{Binding CanvasTransform}"
                                        FontFamily="{DynamicResource DefaultFontFamily}"
                                        MonoFontFamily="{DynamicResource Font.Monospace}"
                                        SelectedStroke="{DynamicResource AccentBrush}"
                                        EdgeStroke="{DynamicResource BorderBrush}"
                                        MissingImageLabel="{markup:T Ns=Mindmap, Key=ImageMissing}"
                                        MissingRefLabel="{markup:T Ns=Mindmap, Key=RefMissing}"/>
          </Grid>
        </Border>

        <!-- Contextual style toolbar: floats above the selected node -->
        <Canvas Grid.Column="0" ClipToBounds="True">
            <Border IsVisible="{Binding IsSelectionToolbarVisible}"
                    Canvas.Left="{Binding SelectionToolbarLeft}"
                    Canvas.Top="{Binding SelectionToolbarTop}"
                    Height="40" Padding="7,0"
                    Background="{DynamicResource FloatingChromeBackgroundBrush}"
                    CornerRadius="10" BoxShadow="0 6 20 0 #33000000">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="accent"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=accent}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource AccentBrush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.2"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.2}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette2Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.3"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.3}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette3Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.4"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.4}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette4Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.5"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.5}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette5Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.6"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.6}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette6Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="surface"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=surface}">
                            <Border Width="15" Height="15" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{DynamicResource FloatingChromeDividerBrush}" BorderThickness="1"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Card"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Card}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapeCard}">
                            <Border Width="15" Height="11" CornerRadius="3" Background="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Pill"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Pill}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapePill}">
                            <Border Width="17" Height="11" CornerRadius="6" Background="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Outline"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Outline}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapeOutline}">
                            <Border Width="15" Height="11" CornerRadius="3" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Plain"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Plain}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapePlain}" Content="T"/>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="S" Content="S"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=S}"/>
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="M" Content="M"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=M}"/>
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="L" Content="L"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=L}"/>
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="XL" Content="XL"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=XL}"/>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <Button Classes="mmTool" Command="{Binding ToggleCollapseCommand}"
                            Classes.active="{Binding SelectedNode.IsCollapsed, FallbackValue=False}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToggleCollapse}">
                        <controls:AppIcon Icon="Common/chevron-down" Width="15" Height="15"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                    <Button Classes="mmTool" Command="{Binding TogglePinCommand}"
                            Classes.active="{Binding SelectedNode.IsPinned, FallbackValue=False}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=TogglePin}">
                        <controls:AppIcon Icon="Common/pin" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <Button Classes="mmTool" Command="{Binding StyleSubtreeCommand}"
                            IsEnabled="{Binding SelectedNode.HasStyleOverride, FallbackValue=False}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=StyleSubtree}">
                        <controls:AppIcon Icon="Common/sitemap" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                    <Button Classes="mmTool" Command="{Binding ClearNodeStyleCommand}"
                            IsEnabled="{Binding SelectedNode.HasStyleOverride, FallbackValue=False}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ClearStyle}">
                        <controls:AppIcon Icon="Common/eraser" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                    <Button Classes="mmTool" Command="{Binding SaveStyleAsTemplateCommand}"
                            IsEnabled="{Binding SelectedNode.HasStyleOverride, FallbackValue=False}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=SaveAsTemplate}">
                        <controls:AppIcon Icon="Common/bookmark-plus" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Contextual edge toolbar: floats above the selected link edge's midpoint -->
            <Border IsVisible="{Binding IsEdgeToolbarVisible}"
                    Canvas.Left="{Binding EdgeToolbarLeft}"
                    Canvas.Top="{Binding EdgeToolbarTop}"
                    Height="40" Padding="7,0"
                    Background="{DynamicResource FloatingChromeBackgroundBrush}"
                    CornerRadius="10" BoxShadow="0 6 20 0 #33000000">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Line style -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding SetEdgeLineCommand}" CommandParameter="Solid"
                                Classes.active="{Binding SelectedEdge.LineStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Solid}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeSolid}">
                            <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="2"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetEdgeLineCommand}" CommandParameter="Dashed"
                                Classes.active="{Binding SelectedEdge.LineStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Dashed}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeDashed}">
                            <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="2" StrokeDashArray="2,1.5"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetEdgeLineCommand}" CommandParameter="Dotted"
                                Classes.active="{Binding SelectedEdge.LineStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Dotted}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeDotted}">
                            <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="2" StrokeDashArray="0.5,2" StrokeLineCap="Round"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetEdgeLineCommand}" CommandParameter="Double"
                                Classes.active="{Binding SelectedEdge.LineStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Double}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeDouble}">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="1.5"
                                      Stroke="{DynamicResource FloatingChromeForegroundBrush}"/>
                                <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="1.5"
                                      Stroke="{DynamicResource FloatingChromeForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <!-- Routing -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding SetEdgeRoutingCommand}" CommandParameter="Curve"
                                Classes.active="{Binding SelectedEdge.Routing, Converter={StaticResource EnumEquals}, ConverterParameter=Curve}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=RouteCurve}">
                            <Path Data="M0,9 C5,9 7,0 12,0" StrokeThickness="2" StrokeLineCap="Round"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetEdgeRoutingCommand}" CommandParameter="Straight"
                                Classes.active="{Binding SelectedEdge.Routing, Converter={StaticResource EnumEquals}, ConverterParameter=Straight}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=RouteStraight}">
                            <Line StartPoint="0,9" EndPoint="14,0" StrokeThickness="2" StrokeLineCap="Round"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetEdgeRoutingCommand}" CommandParameter="Orthogonal"
                                Classes.active="{Binding SelectedEdge.Routing, Converter={StaticResource EnumEquals}, ConverterParameter=Orthogonal}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=RouteOrthogonal}">
                            <Polyline Points="0,9 6,9 6,0 13,0" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <!-- Thickness -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding SetEdgeThicknessCommand}" CommandParameter="1"
                                Classes.active="{Binding SelectedEdge.Thickness, Converter={StaticResource EnumEquals}, ConverterParameter=1}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeThin}">
                            <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="1"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetEdgeThicknessCommand}" CommandParameter="1.5"
                                Classes.active="{Binding SelectedEdge.Thickness, Converter={StaticResource EnumEquals}, ConverterParameter=1.5}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeMedium}">
                            <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="2"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetEdgeThicknessCommand}" CommandParameter="3"
                                Classes.active="{Binding SelectedEdge.Thickness, Converter={StaticResource EnumEquals}, ConverterParameter=3}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeThick}">
                            <Line StartPoint="0,0" EndPoint="18,0" StrokeThickness="3.5"
                                  Stroke="{DynamicResource FloatingChromeForegroundBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <!-- Arrow caps -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding ToggleEdgeStartCapCommand}" Content="&#x2190;"
                                Classes.active="{Binding SelectedEdge.StartCap, Converter={StaticResource EnumEquals}, ConverterParameter=Arrow}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeStartArrow}"/>
                        <Button Classes="mmTool" Command="{Binding ToggleEdgeEndCapCommand}" Content="&#x2192;"
                                Classes.active="{Binding SelectedEdge.EndCap, Converter={StaticResource EnumEquals}, ConverterParameter=Arrow}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=EdgeEndArrow}"/>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <!-- Color -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mmSwatch" Command="{Binding SetEdgeColorCommand}" CommandParameter="stroke"
                                Classes.active="{Binding SelectedEdge.ColorToken, Converter={StaticResource EnumEquals}, ConverterParameter=stroke}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource BorderBrush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetEdgeColorCommand}" CommandParameter="accent"
                                Classes.active="{Binding SelectedEdge.ColorToken, Converter={StaticResource EnumEquals}, ConverterParameter=accent}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource AccentBrush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetEdgeColorCommand}" CommandParameter="palette.3"
                                Classes.active="{Binding SelectedEdge.ColorToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.3}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette3Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetEdgeColorCommand}" CommandParameter="palette.5"
                                Classes.active="{Binding SelectedEdge.ColorToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.5}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette5Brush}"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <Button Classes="mmTool" Command="{Binding DeleteEdgeCommand}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=DeleteEdge}">
                        <controls:AppIcon Icon="Common/trash" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Contextual align/distribute toolbar: floats above a multi-selection of free elements -->
            <Border IsVisible="{Binding IsAlignmentToolbarVisible}"
                    Canvas.Left="{Binding AlignmentToolbarLeft}"
                    Canvas.Top="{Binding AlignmentToolbarTop}"
                    Height="40" Padding="7,0"
                    Background="{DynamicResource FloatingChromeBackgroundBrush}"
                    CornerRadius="10" BoxShadow="0 6 20 0 #33000000">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Align edges / centres -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding AlignLeftCommand}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=AlignLeft}">
                            <controls:AppIcon Icon="Common/align-start-vertical" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding AlignCenterHorizontalCommand}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=AlignCenterH}">
                            <controls:AppIcon Icon="Common/align-center-vertical" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding AlignRightCommand}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=AlignRight}">
                            <controls:AppIcon Icon="Common/align-end-vertical" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding AlignTopCommand}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=AlignTop}">
                            <controls:AppIcon Icon="Common/align-start-horizontal" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding AlignMiddleVerticalCommand}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=AlignMiddleV}">
                            <controls:AppIcon Icon="Common/align-center-horizontal" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding AlignBottomCommand}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=AlignBottom}">
                            <controls:AppIcon Icon="Common/align-end-horizontal" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <!-- Distribute (needs 3+ elements) -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding DistributeHorizontalCommand}"
                                IsEnabled="{Binding CanDistribute}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=DistributeH}">
                            <controls:AppIcon Icon="Common/align-horizontal-distribute-center" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding DistributeVerticalCommand}"
                                IsEnabled="{Binding CanDistribute}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=DistributeV}">
                            <controls:AppIcon Icon="Common/align-vertical-distribute-center" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Inline label editor floats over the element/edge being renamed -->
            <TextBox Name="LabelEditor" Classes="mmLabelEditor"
                     IsVisible="{Binding IsLabelEditorVisible}"
                     Canvas.Left="{Binding LabelEditorLeft}"
                     Canvas.Top="{Binding LabelEditorTop}"
                     Width="{Binding LabelEditorWidth}"
                     Height="{Binding LabelEditorHeight}"
                     FontSize="{Binding LabelEditorFontSize}"
                     Text="{Binding LabelEditorText, Mode=TwoWay}"
                     AcceptsReturn="{Binding LabelEditorAcceptsReturn}"
                     TextWrapping="NoWrap"
                     PlaceholderText="{markup:T Ns=Mindmap, Key=LabelPlaceholder}"/>
        </Canvas>

        <!-- Bottom tool pill: place elements (node, shape, text) at the viewport center -->
        <Grid Grid.Column="0">
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                    Height="44" Padding="7,0"
                    Background="{DynamicResource WorkspaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="22" BoxShadow="0 10 28 0 #26000000">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="mmPill" Click="OnAddNodeClick" ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolNode}">
                        <controls:AppIcon Icon="Mindmap/node" Width="18" Height="18"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <!-- Shape opens a flyout of primitives rather than one button per shape -->
                    <Button x:Name="ShapeButton" Classes="mmPill" ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolShape}">
                        <Panel Width="22" Height="22">
                            <controls:AppIcon Icon="Common/square" Width="15" Height="15"
                                              Color="{DynamicResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Data="M0,5 L5,5 L5,0 Z" Fill="{DynamicResource TextTertiaryBrush}"
                                  Width="5" Height="5"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="Top" FlyoutPresenterClasses="mmShapeFlyout">
                                <StackPanel Width="252">
                                    <UniformGrid Columns="4">
                                        <Button Classes="shapeTile" Tag="Rectangle" Click="OnShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/rectangle" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeRectangle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Ellipse" Click="OnShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/ellipse" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeEllipse}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Diamond" Click="OnShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/diamond" Width="20" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeDiamond}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Hexagon" Click="OnShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/hexagon" Width="22" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeHexagon}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Parallelogram" Click="OnShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/parallelogram" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeParallelogram}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Line" Click="OnShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/line" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeLine}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Arrow" Click="OnShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/arrow" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeArrow}"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <Border Margin="0,8,0,0" Padding="4,8,4,0" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerSubtleBrush}">
                                        <TextBlock Text="{markup:T Ns=Mindmap, Key=ShapesInlineTextHint}"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="mmPill" Click="OnAddTextClick" ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolText}">
                        <controls:AppIcon Icon="Common/type" Width="16" Height="16"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Border Width="1" Height="22" Margin="4,0" Background="{DynamicResource DividerSubtleBrush}"/>
                    <Button x:Name="ConnectButton" Classes="mmPill" Click="OnConnectClick"
                            Classes.active="{Binding IsConnectToolActive}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolConnect}">
                        <controls:AppIcon x:Name="ConnectIcon" Icon="Common/link" Width="17" Height="17"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Classes="mmPill" Click="OnAddFrameClick" ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolFrame}">
                        <controls:AppIcon Icon="Common/frame" Width="17" Height="17"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Classes="mmPill" Click="OnAddImageClick" ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolImage}">
                        <controls:AppIcon Icon="Common/image" Width="17" Height="17"
                                          Color="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Radial toolkit (Alt+W): a cursor-anchored ring of the six canvas tools -->
        <Panel Grid.Column="0" IsVisible="{Binding IsRadialOpen}">
            <!-- Backdrop swallows canvas clicks (pan/select suppressed); a press outside the ring closes it. -->
            <Border Background="Transparent" PointerPressed="OnRadialBackdropPressed"/>
            <Canvas>
                <Canvas Canvas.Left="{Binding RadialLeft}" Canvas.Top="{Binding RadialTop}" Width="208" Height="208">
                    <Border Width="208" Height="208" CornerRadius="104"
                            Background="{DynamicResource FloatingChromeBackgroundBrush}"
                            BorderBrush="{DynamicResource FloatingChromeDividerBrush}" BorderThickness="1"
                            BoxShadow="0 12 32 0 #40000000"/>
                    <!-- Cursor marker at the ring's center -->
                    <Border Canvas.Left="98" Canvas.Top="98" Width="12" Height="12" CornerRadius="6"
                            Background="{DynamicResource AccentBrush}"/>

                    <Button Classes="mmRadial" Canvas.Left="84" Canvas.Top="6" Click="OnRadialNodeClick"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolNode}">
                        <controls:AppIcon Icon="Mindmap/node" Width="18" Height="18"
                                          Color="{DynamicResource FloatingChromeForegroundStrongBrush}"/>
                    </Button>
                    <Button Classes="mmRadial" Canvas.Left="151.5" Canvas.Top="45" Click="OnRadialTextClick"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolText}">
                        <controls:AppIcon Icon="Common/type" Width="16" Height="16"
                                          Color="{DynamicResource FloatingChromeForegroundStrongBrush}"/>
                    </Button>
                    <!-- Shape wedge opens the same tile picker as the pill, anchored on the ring -->
                    <Button x:Name="RadialShapeButton" Classes="mmRadial" Canvas.Left="151.5" Canvas.Top="123"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolShape}">
                        <Panel Width="22" Height="22">
                            <controls:AppIcon Icon="Common/square" Width="15" Height="15"
                                              Color="{DynamicResource FloatingChromeForegroundStrongBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Data="M0,5 L5,5 L5,0 Z" Fill="{DynamicResource FloatingChromeForegroundBrush}"
                                  Width="5" Height="5"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom" FlyoutPresenterClasses="mmShapeFlyout">
                                <StackPanel Width="252">
                                    <UniformGrid Columns="4">
                                        <Button Classes="shapeTile" Tag="Rectangle" Click="OnRadialShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/rectangle" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeRectangle}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Ellipse" Click="OnRadialShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/ellipse" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeEllipse}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Diamond" Click="OnRadialShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/diamond" Width="20" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeDiamond}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Hexagon" Click="OnRadialShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/hexagon" Width="22" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeHexagon}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Parallelogram" Click="OnRadialShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/parallelogram" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeParallelogram}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Line" Click="OnRadialShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/line" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeLine}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="shapeTile" Tag="Arrow" Click="OnRadialShapeClick">
                                            <StackPanel Classes="shapeTileBody">
                                                <controls:AppIcon Icon="Mindmap/arrow" Width="24" Height="18"
                                                                  Color="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Classes="shapeTileLabel" Text="{markup:T Ns=Mindmap, Key=ShapeArrow}"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <Border Margin="0,8,0,0" Padding="4,8,4,0" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerSubtleBrush}">
                                        <TextBlock Text="{markup:T Ns=Mindmap, Key=ShapesInlineTextHint}"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="mmRadial" Canvas.Left="84" Canvas.Top="162" Click="OnRadialConnectClick"
                            Classes.active="{Binding IsConnectToolActive}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolConnect}">
                        <controls:AppIcon Icon="Common/link" Width="17" Height="17"
                                          Color="{DynamicResource FloatingChromeForegroundStrongBrush}"/>
                    </Button>
                    <Button Classes="mmRadial" Canvas.Left="16.5" Canvas.Top="123" Click="OnRadialFrameClick"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolFrame}">
                        <controls:AppIcon Icon="Common/frame" Width="17" Height="17"
                                          Color="{DynamicResource FloatingChromeForegroundStrongBrush}"/>
                    </Button>
                    <Button Classes="mmRadial" Canvas.Left="16.5" Canvas.Top="45" Click="OnRadialImageClick"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToolImage}">
                        <controls:AppIcon Icon="Common/image" Width="17" Height="17"
                                          Color="{DynamicResource FloatingChromeForegroundStrongBrush}"/>
                    </Button>
                </Canvas>
            </Canvas>
        </Panel>

        <!-- Docked style inspector: the full per-node styling surface -->
        <Border Grid.Column="1" Width="272" IsVisible="{Binding IsInspectorOpen}"
                Background="{DynamicResource WorkspaceBackgroundBrush}"
                BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" Spacing="18">
                    <TextBlock Classes="insTitle" Text="{markup:T Ns=Mindmap, Key=InspectorTitle}"/>

                    <TextBlock IsVisible="{Binding !HasSelection}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="{markup:T Ns=Mindmap, Key=InspectorEmpty}"/>

                    <StackPanel IsVisible="{Binding HasSelection}" Spacing="18">

                        <!-- Template for the selected node's tree (node selections only) -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsNodeSelected}">
                            <TextBlock Classes="insHeader" Text="{markup:T Ns=Mindmap, Key=TemplateThisTree}"/>
                            <controls:ModernComboBox Classes="compact" HorizontalAlignment="Stretch"
                                                     ItemsSource="{Binding TemplateOptions}"
                                                     SelectedItem="{Binding SelectedClusterTemplateOption}">
                                <controls:ModernComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MindmapTemplateOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </controls:ModernComboBox.ItemTemplate>
                            </controls:ModernComboBox>
                        </StackPanel>

                        <!-- Node content type (node selections only) -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsNodeSelected}">
                            <TextBlock Classes="insHeader" Text="{markup:T Ns=Mindmap, Key=NodeType}"/>
                            <WrapPanel>
                                <Button Classes="insTool" Command="{Binding SetNodeKindCommand}" CommandParameter="text" Content="Aa"
                                        Classes.active="{Binding SelectedNode.ContentType, Converter={StaticResource EnumEquals}, ConverterParameter=text}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=KindText}"/>
                                <Button Classes="insTool" Command="{Binding SetNodeKindCommand}" CommandParameter="task" Content="&#x2713;"
                                        Classes.active="{Binding SelectedNode.ContentType, Converter={StaticResource EnumEquals}, ConverterParameter=task}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=KindTask}"/>
                                <Button Classes="insTool" Command="{Binding SetNodeKindCommand}" CommandParameter="code" Content="{}{ }"
                                        Classes.active="{Binding SelectedNode.ContentType, Converter={StaticResource EnumEquals}, ConverterParameter=code}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=KindCode}"/>
                                <Button Classes="insTool" Command="{Binding SetNodeKindCommand}" CommandParameter="math" Content="&#x2211;"
                                        Classes.active="{Binding SelectedNode.ContentType, Converter={StaticResource EnumEquals}, ConverterParameter=math}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=KindMath}"/>
                                <Button Classes="insTool" Command="{Binding SetNodeKindCommand}" CommandParameter="link"
                                        Classes.active="{Binding SelectedNode.ContentType, Converter={StaticResource EnumEquals}, ConverterParameter=link}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=KindLink}">
                                    <controls:AppIcon Icon="Common/link" Width="15" Height="15" Color="{Binding $parent[Button].Foreground}"/>
                                </Button>
                                <Button Classes="insTool" Command="{Binding SetNodeKindCommand}" CommandParameter="note"
                                        Classes.active="{Binding SelectedNode.ContentType, Converter={StaticResource EnumEquals}, ConverterParameter=note}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=KindNote}">
                                    <controls:AppIcon Icon="Common/file-text" Width="15" Height="15" Color="{Binding $parent[Button].Foreground}"/>
                                </Button>
                                <Button Classes="insTool" Command="{Binding SetNodeKindCommand}" CommandParameter="flashcard"
                                        Classes.active="{Binding SelectedNode.ContentType, Converter={StaticResource EnumEquals}, ConverterParameter=flashcard}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=KindFlashcard}">
                                    <controls:AppIcon Icon="Common/gallery-horizontal-end" Width="15" Height="15" Color="{Binding $parent[Button].Foreground}"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Fill -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="insHeader" Text="{markup:T Ns=Mindmap, Key=Fill}"/>
                            <WrapPanel>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="surface"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=surface}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource CardBackgroundSecondaryBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="accent"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=accent}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.1"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.1}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette1Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.2"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.2}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette2Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.3"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.3}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette3Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.4"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.4}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette4Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.5"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.5}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette5Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.6"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.6}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette6Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.7"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.7}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette7Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.8"
                                        Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.8}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette8Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="26" Height="26" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{DynamicResource DividerSubtleBrush}"
                                        Background="{Binding FillHex, Converter={StaticResource HexToBrush}}"/>
                                <TextBox Text="{Binding FillHex}" PlaceholderText="#RRGGBB" Width="112" Height="30"
                                         VerticalContentAlignment="Center" FontSize="12">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SetFillHexCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Classes="insTool" MinWidth="34" Margin="0" Command="{Binding SetFillHexCommand}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=ApplyColor}">
                                    <controls:AppIcon Icon="Common/check" Width="15" Height="15" Color="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Stroke -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="insHeader" Text="{markup:T Ns=Mindmap, Key=Stroke}"/>
                            <WrapPanel>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="stroke"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=stroke}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource BorderBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="accent"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=accent}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.1"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.1}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette1Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.2"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.2}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette2Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.3"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.3}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette3Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.4"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.4}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette4Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.5"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.5}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette5Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.6"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.6}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette6Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.7"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.7}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette7Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetStrokeCommand}" CommandParameter="palette.8"
                                        Classes.active="{Binding SelectedNode.StrokeToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.8}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource MindmapPalette8Brush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="26" Height="26" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{DynamicResource DividerSubtleBrush}"
                                        Background="{Binding StrokeHex, Converter={StaticResource HexToBrush}}"/>
                                <TextBox Text="{Binding StrokeHex}" PlaceholderText="#RRGGBB" Width="112" Height="30"
                                         VerticalContentAlignment="Center" FontSize="12">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SetStrokeHexCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Classes="insTool" MinWidth="34" Margin="0" Command="{Binding SetStrokeHexCommand}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=ApplyColor}">
                                    <controls:AppIcon Icon="Common/check" Width="15" Height="15" Color="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Text -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="insHeader" Text="{markup:T Ns=Mindmap, Key=TextColor}"/>
                            <WrapPanel>
                                <Button Classes="insSwatch" Command="{Binding SetTextColorCommand}" CommandParameter="textPrimary"
                                        Classes.active="{Binding SelectedNode.TextToken, Converter={StaticResource EnumEquals}, ConverterParameter=textPrimary}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetTextColorCommand}" CommandParameter="textMuted"
                                        Classes.active="{Binding SelectedNode.TextToken, Converter={StaticResource EnumEquals}, ConverterParameter=textMuted}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetTextColorCommand}" CommandParameter="onAccent"
                                        Classes.active="{Binding SelectedNode.TextToken, Converter={StaticResource EnumEquals}, ConverterParameter=onAccent}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentButtonForegroundBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                                <Button Classes="insSwatch" Command="{Binding SetTextColorCommand}" CommandParameter="accent"
                                        Classes.active="{Binding SelectedNode.TextToken, Converter={StaticResource EnumEquals}, ConverterParameter=accent}">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="1"/>
                                </Button>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="26" Height="26" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{DynamicResource DividerSubtleBrush}"
                                        Background="{Binding TextHex, Converter={StaticResource HexToBrush}}"/>
                                <TextBox Text="{Binding TextHex}" PlaceholderText="#RRGGBB" Width="112" Height="30"
                                         VerticalContentAlignment="Center" FontSize="12">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SetTextHexCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Classes="insTool" MinWidth="34" Margin="0" Command="{Binding SetTextHexCommand}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=ApplyColor}">
                                    <controls:AppIcon Icon="Common/check" Width="15" Height="15" Color="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Shape -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="insHeader" Text="{markup:T Ns=Mindmap, Key=Shape}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="insTool" Command="{Binding SetShapeCommand}" CommandParameter="Card"
                                        Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Card}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapeCard}">
                                    <Border Width="20" Height="13" CornerRadius="3" Background="{Binding $parent[Button].Foreground}"/>
                                </Button>
                                <Button Classes="insTool" Command="{Binding SetShapeCommand}" CommandParameter="Pill"
                                        Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Pill}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapePill}">
                                    <Border Width="22" Height="13" CornerRadius="7" Background="{Binding $parent[Button].Foreground}"/>
                                </Button>
                                <Button Classes="insTool" Command="{Binding SetShapeCommand}" CommandParameter="Outline"
                                        Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Outline}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapeOutline}">
                                    <Border Width="20" Height="13" CornerRadius="3" BorderThickness="1.5" BorderBrush="{Binding $parent[Button].Foreground}"/>
                                </Button>
                                <Button Classes="insTool" Command="{Binding SetShapeCommand}" CommandParameter="Plain"
                                        Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Plain}"
                                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapePlain}" Content="T"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Size -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="insHeader" Text="{markup:T Ns=Mindmap, Key=Size}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="insTool" Command="{Binding SetFontScaleCommand}" CommandParameter="S" Content="S"
                                        Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=S}"/>
                                <Button Classes="insTool" Command="{Binding SetFontScaleCommand}" CommandParameter="M" Content="M"
                                        Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=M}"/>
                                <Button Classes="insTool" Command="{Binding SetFontScaleCommand}" CommandParameter="L" Content="L"
                                        Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=L}"/>
                                <Button Classes="insTool" Command="{Binding SetFontScaleCommand}" CommandParameter="XL" Content="XL"
                                        Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=XL}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Classes="insReset" Command="{Binding ClearNodeStyleCommand}"
                                IsEnabled="{Binding SelectedNode.HasStyleOverride, FallbackValue=False}"
                                Content="{markup:T Ns=Mindmap, Key=ClearStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
    </Grid>
</UserControl>
