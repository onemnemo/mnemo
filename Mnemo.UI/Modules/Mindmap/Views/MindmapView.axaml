<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mnemo.UI.Modules.Mindmap.ViewModels"
             xmlns:views="using:Mnemo.UI.Modules.Mindmap.Views"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:conv="using:Mnemo.UI.Converters"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Mnemo.UI.Modules.Mindmap.Views.MindmapView"
             x:CompileBindings="True"
             x:DataType="vm:MindmapViewModel">

    <UserControl.Resources>
        <conv:EqualsConverter x:Key="EnumEquals"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.mmSwatch">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.mmSwatch:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button.mmSwatch.active">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingChromeForegroundStrongBrush}"/>
        </Style>
        <Style Selector="Button.mmTool">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource FloatingChromeForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.mmTool:pointerover">
            <Setter Property="Background" Value="{DynamicResource FloatingChromeHoverBrush}"/>
        </Style>
        <Style Selector="Button.mmTool.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Top bar -->
        <Border Grid.Row="0" Height="44" Background="{DynamicResource WorkspaceBackgroundBrush}"
                BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,12,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Classes="ghost" Click="OnBackClick"
                        Name="BackButton" Padding="6" Background="Transparent" BorderThickness="0">
                    <controls:AppIcon Icon="Common/chevron-left" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <controls:ModernComboBox Classes="compact" MinWidth="128" VerticalAlignment="Center"
                                             ItemsSource="{Binding TemplateOptions}"
                                             SelectedItem="{Binding SelectedTemplateOption}"
                                             ToolTip.Tip="{markup:T Ns=Mindmap, Key=TemplateTip}">
                        <controls:ModernComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MindmapTemplateOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </controls:ModernComboBox.ItemTemplate>
                    </controls:ModernComboBox>
                    <controls:ModernComboBox Classes="compact" MinWidth="118" VerticalAlignment="Center"
                                             ItemsSource="{Binding LayoutOptions}"
                                             SelectedItem="{Binding SelectedLayoutOption}"
                                             ToolTip.Tip="{markup:T Ns=Mindmap, Key=LayoutTip}">
                        <controls:ModernComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MindmapLayoutOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </controls:ModernComboBox.ItemTemplate>
                    </controls:ModernComboBox>
                    <TextBlock Text="{Binding ZoomLabel}" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="4" Name="RecenterButton" Classes="ghost" Padding="6"
                        Background="Transparent" BorderThickness="0" Command="{Binding RecenterCommand}"
                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=Recenter}">
                    <controls:AppIcon Icon="Common/crosshair" Width="16" Height="16"
                                      Color="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Canvas -->
        <Border Grid.Row="1" Name="CanvasHost" ClipToBounds="True"
                Background="{DynamicResource WorkspaceBackgroundBrush}">
          <Grid>
            <views:MindmapGridBackground Transform="{Binding CanvasTransform}"
                                         DotBrush="{DynamicResource DividerSubtleBrush}"/>
            <views:MindmapCanvasControl Name="World"
                                        Nodes="{Binding Nodes}"
                                        Edges="{Binding Edges}"
                                        Transform="{Binding CanvasTransform}"
                                        SelectedStroke="{DynamicResource AccentBrush}"
                                        EdgeStroke="{DynamicResource BorderBrush}"/>
          </Grid>
        </Border>

        <!-- Contextual style toolbar: floats above the selected node -->
        <Canvas Grid.Row="1" ClipToBounds="True">
            <Border IsVisible="{Binding IsSelectionToolbarVisible}"
                    Canvas.Left="{Binding SelectionToolbarLeft}"
                    Canvas.Top="{Binding SelectionToolbarTop}"
                    Height="40" Padding="7,0"
                    Background="{DynamicResource FloatingChromeBackgroundBrush}"
                    CornerRadius="10" BoxShadow="0 6 20 0 #33000000">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="accent"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=accent}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource AccentBrush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.2"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.2}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette2Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.3"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.3}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette3Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.4"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.4}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette4Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.5"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.5}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette5Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="palette.6"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=palette.6}">
                            <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource MindmapPalette6Brush}"/>
                        </Button>
                        <Button Classes="mmSwatch" Command="{Binding SetFillCommand}" CommandParameter="surface"
                                Classes.active="{Binding SelectedNode.FillToken, Converter={StaticResource EnumEquals}, ConverterParameter=surface}">
                            <Border Width="15" Height="15" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{DynamicResource FloatingChromeDividerBrush}" BorderThickness="1"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Card"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Card}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapeCard}">
                            <Border Width="15" Height="11" CornerRadius="3" Background="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Pill"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Pill}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapePill}">
                            <Border Width="17" Height="11" CornerRadius="6" Background="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Outline"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Outline}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapeOutline}">
                            <Border Width="15" Height="11" CornerRadius="3" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource FloatingChromeForegroundBrush}"/>
                        </Button>
                        <Button Classes="mmTool" Command="{Binding SetShapeCommand}" CommandParameter="Plain"
                                Classes.active="{Binding SelectedNode.Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Plain}"
                                ToolTip.Tip="{markup:T Ns=Mindmap, Key=ShapePlain}" Content="T"/>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="S" Content="S"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=S}"/>
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="M" Content="M"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=M}"/>
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="L" Content="L"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=L}"/>
                        <Button Classes="mmTool" Command="{Binding SetFontScaleCommand}" CommandParameter="XL" Content="XL"
                                Classes.active="{Binding SelectedNode.FontScale, Converter={StaticResource EnumEquals}, ConverterParameter=XL}"/>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <Button Classes="mmTool" Command="{Binding ToggleCollapseCommand}"
                            Classes.active="{Binding SelectedNode.IsCollapsed, FallbackValue=False}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ToggleCollapse}">
                        <controls:AppIcon Icon="Common/chevron-down" Width="15" Height="15"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                    <Button Classes="mmTool" Command="{Binding TogglePinCommand}"
                            Classes.active="{Binding SelectedNode.IsPinned, FallbackValue=False}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=TogglePin}">
                        <controls:AppIcon Icon="Common/pin" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource FloatingChromeDividerBrush}" VerticalAlignment="Center"/>

                    <Button Classes="mmTool" Command="{Binding StyleSubtreeCommand}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=StyleSubtree}">
                        <controls:AppIcon Icon="Common/sitemap" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                    <Button Classes="mmTool" Command="{Binding ClearNodeStyleCommand}"
                            ToolTip.Tip="{markup:T Ns=Mindmap, Key=ClearStyle}">
                        <controls:AppIcon Icon="Common/eraser" Width="14" Height="14"
                                          Color="{DynamicResource FloatingChromeForegroundBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
