<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mnemo.UI.Modules.Mindmap.ViewModels"
             xmlns:markup="using:Mnemo.UI.Markup"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Mnemo.UI.Modules.Mindmap.Views.MindmapView"
             x:CompileBindings="True"
             x:DataType="vm:MindmapViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Top bar -->
        <Border Grid.Row="0" Height="44" Background="{DynamicResource WorkspaceBackgroundBrush}"
                BorderBrush="{DynamicResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,12,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Classes="ghost" Click="OnBackClick"
                        Name="BackButton" Padding="6" Background="Transparent" BorderThickness="0">
                    <PathIcon Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                              Data="M9 4 L4.5 8 L9 12"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ZoomLabel}" FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="4" Name="RecenterButton" Classes="ghost" Padding="6"
                        Background="Transparent" BorderThickness="0" Command="{Binding RecenterCommand}"
                        ToolTip.Tip="{markup:T Ns=Mindmap, Key=Recenter}">
                    <PathIcon Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                              Data="M8 3 A5 5 0 1 1 3.5 5.5 M3 3 V6 H6"/>
                </Button>
            </Grid>
        </Border>

        <!-- Canvas -->
        <Border Grid.Row="1" Name="CanvasHost" ClipToBounds="True"
                Background="{DynamicResource WorkspaceBackgroundBrush}">
            <Canvas Name="World">
                <Canvas.RenderTransform>
                    <MatrixTransform Matrix="{Binding CanvasTransform}"/>
                </Canvas.RenderTransform>

                <!-- Edges -->
                <ItemsControl ItemsSource="{Binding Edges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MindmapEdgeItem">
                            <Line StartPoint="{Binding Start}" EndPoint="{Binding End}"
                                  Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nodes -->
                <ItemsControl ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:MindmapNodeItem">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MindmapNodeItem">
                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                    CornerRadius="10" BorderThickness="1.5"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.root="{Binding IsRoot}"
                                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}">
                                <Border.Styles>
                                    <Style Selector="Border.selected">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Style>
                                    <Style Selector="Border.root">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </Style>
                                    <Style Selector="Border.root > TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </Border.Styles>
                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="10,0" MaxWidth="112"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
