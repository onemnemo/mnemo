<UserControl
    x:Class="Mnemo.UI.Components.BlockEditor.FormattingToolbar.InlineFormattingToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mnemo.UI.Controls"
    x:CompileBindings="False"
    Focusable="False">
    <Border
        Background="{DynamicResource FloatingChromeBackgroundBrush}"
        BoxShadow="0 8 24 0 #47000000"
        CornerRadius="8"
        Padding="4">
        <StackPanel Orientation="Horizontal" Spacing="1">
            <!-- Assist (placeholder, hidden until implemented) -->
            <Button
                x:Name="AssistButton"
                IsVisible="False"
                Classes="FormattingToolbarButton FormattingToolbarAssist"
                Click="OnAssistClick">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon
                        Width="14" Height="14"
                        SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/sparkles.svg"
                        Color="{DynamicResource FloatingChromeAccentBrush}" />
                    <TextBlock
                        x:Name="AssistLabel"
                        FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource FloatingChromeForegroundBrush}" />
                </StackPanel>
            </Button>

            <!-- Separator (hidden with Assist) -->
            <Border
                IsVisible="False"
                Width="1" Height="16" Margin="3,0"
                VerticalAlignment="Center"
                Background="{DynamicResource FloatingChromeDividerBrush}" />

            <!-- Color dropdown -->
            <Button
                x:Name="ColorButton"
                Classes="FormattingToolbarButton"
                Click="OnColorClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border
                        x:Name="ColorPreviewBackground"
                        Width="16"
                        Height="16"
                        CornerRadius="4"
                        Background="{DynamicResource FloatingChromeBackgroundBrush}"
                        BorderBrush="{DynamicResource FloatingChromeDividerBrush}"
                        BorderThickness="1">
                        <TextBlock
                            x:Name="ColorPreviewForeground"
                            Text="A"
                            FontSize="10"
                            FontFamily="{DynamicResource Font.SemiBold}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource FloatingChromeForegroundBrush}" />
                    </Border>
                    <TextBlock
                        x:Name="ColorLabel"
                        FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource FloatingChromeForegroundBrush}" />
                    <Path
                        Data="M2,4 L6,8 L10,4"
                        Stroke="{DynamicResource FloatingChromeForegroundMutedBrush}"
                        StrokeThickness="1.5"
                        StrokeLineCap="Round"
                        Width="10" Height="10"
                        VerticalAlignment="Center"
                        Margin="0,1,0,0" />
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Border Width="1" Height="16" Margin="3,0" VerticalAlignment="Center" Background="{DynamicResource FloatingChromeDividerBrush}" />

            <!-- Bold -->
            <Button
                x:Name="BoldButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnBoldClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/bold.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Italic -->
            <Button
                x:Name="ItalicButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnItalicClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/italic.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Underline -->
            <Button
                x:Name="UnderlineButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnUnderlineClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/underline.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Strikethrough -->
            <Button
                x:Name="StrikethroughButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnStrikethroughClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/strikethrough.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Link (add / remove) -->
            <Button
                x:Name="UnlinkButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnUnlinkClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/Common/link.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Highlight -->
            <Button
                x:Name="HighlightButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnHighlightClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/highlighter.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Separator -->
            <Border Width="1" Height="16" Margin="3,0" VerticalAlignment="Center" Background="{DynamicResource FloatingChromeDividerBrush}" />

            <!-- Subscript -->
            <Button
                x:Name="SubscriptButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnSubscriptClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/subscript.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Superscript -->
            <Button
                x:Name="SuperscriptButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnSuperscriptClick">
                <controls:SvgIcon
                    Width="15" Height="15"
                    SvgPath="avares://Mnemo.UI/Icons/FormattingToolbar/superscript.svg"
                    Color="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>

            <!-- Equation -->
            <Button
                x:Name="EquationButton"
                Classes="FormattingToolbarButton FormattingToolbarIcon"
                Click="OnEquationClick">
                <TextBlock
                    Text="Σ"
                    FontSize="13"
                    FontFamily="{DynamicResource Font.Monospace}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource FloatingChromeForegroundBrush}" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
