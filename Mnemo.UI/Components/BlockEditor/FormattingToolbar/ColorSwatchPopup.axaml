<UserControl
    x:Class="Mnemo.UI.Components.BlockEditor.FormattingToolbar.ColorSwatchPopup"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mnemo.UI.Controls"
    x:CompileBindings="False"
    Focusable="False">
    <!--
      Curated 5-swatch display palette. Theme files still define ten swatch slots so
      documents written before the rehaul keep rendering; the picker intentionally
      surfaces this subset (red / orange / blue / green / violet text, cream / blue /
      green / pink / neutral backgrounds — the slot semantics match across themes).
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextSwatchRedBrush" Color="{DynamicResource TextColorSwatch5}" />
        <SolidColorBrush x:Key="TextSwatchOrangeBrush" Color="{DynamicResource TextColorSwatch8}" />
        <SolidColorBrush x:Key="TextSwatchBlueBrush" Color="{DynamicResource TextColorSwatch3}" />
        <SolidColorBrush x:Key="TextSwatchGreenBrush" Color="{DynamicResource TextColorSwatch6}" />
        <SolidColorBrush x:Key="TextSwatchVioletBrush" Color="{DynamicResource TextColorSwatch2}" />
        <SolidColorBrush x:Key="BackgroundSwatchCreamBrush" Color="{DynamicResource ColorSwatch7}" />
        <SolidColorBrush x:Key="BackgroundSwatchBlueBrush" Color="{DynamicResource ColorSwatch9}" />
        <SolidColorBrush x:Key="BackgroundSwatchGreenBrush" Color="{DynamicResource ColorSwatch6}" />
        <SolidColorBrush x:Key="BackgroundSwatchPinkBrush" Color="{DynamicResource ColorSwatch5}" />
        <SolidColorBrush x:Key="BackgroundSwatchNeutralBrush" Color="{DynamicResource ColorSwatch1}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.color-section-header">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="{DynamicResource FloatingChromeForegroundMutedBrush}" />
        </Style>

        <Style Selector="Button.swatch-cell">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.swatch-cell /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.swatch-cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FloatingChromeHoverBrush}" />
        </Style>
        <Style Selector="Button.swatch-cell:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FloatingChromePressedBrush}" />
        </Style>
        <Style Selector="Button.swatch-cell.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingChromeAccentBrush}" />
        </Style>
        <Style Selector="Button.swatch-cell.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FloatingChromeActiveBrush}" />
        </Style>

        <Style Selector="Button.swatch-cell TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
        </Style>

        <!-- Filled background swatches get a faint inner outline so light fills read on dark chrome. -->
        <Style Selector="Button.swatch-cell Border.swatch-fill">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border
        Background="{DynamicResource FloatingChromeBackgroundBrush}"
        BoxShadow="0 12 32 0 #52000000"
        CornerRadius="{DynamicResource Radius.Lg}"
        Padding="10">
        <StackPanel>
            <TextBlock x:Name="TextColorHeader" Classes="color-section-header" Margin="4,0,4,6" />
            <StackPanel x:Name="TextSwatchPanel" Orientation="Horizontal" Spacing="4">
                <Button x:Name="TextDefaultButton" Classes="swatch-cell" Click="OnTextSwatchClick">
                    <TextBlock Text="A" Foreground="{DynamicResource FloatingChromeForegroundStrongBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch5" Click="OnTextSwatchClick">
                    <TextBlock Text="A" Foreground="{StaticResource TextSwatchRedBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch8" Click="OnTextSwatchClick">
                    <TextBlock Text="A" Foreground="{StaticResource TextSwatchOrangeBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch3" Click="OnTextSwatchClick">
                    <TextBlock Text="A" Foreground="{StaticResource TextSwatchBlueBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch6" Click="OnTextSwatchClick">
                    <TextBlock Text="A" Foreground="{StaticResource TextSwatchGreenBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch2" Click="OnTextSwatchClick">
                    <TextBlock Text="A" Foreground="{StaticResource TextSwatchVioletBrush}" />
                </Button>
            </StackPanel>

            <TextBlock x:Name="BackgroundHeader" Classes="color-section-header" Margin="4,12,4,6" />
            <StackPanel x:Name="BackgroundSwatchPanel" Orientation="Horizontal" Spacing="4">
                <Button x:Name="BackgroundNoneButton" Classes="swatch-cell" Click="OnBackgroundSwatchClick">
                    <controls:AppIcon
                        Icon="FormattingToolbar/ban"
                        Width="14" Height="14"
                        Color="{DynamicResource FloatingChromeForegroundMutedBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch7" Click="OnBackgroundSwatchClick">
                    <Border Classes="swatch-fill" Background="{StaticResource BackgroundSwatchCreamBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch9" Click="OnBackgroundSwatchClick">
                    <Border Classes="swatch-fill" Background="{StaticResource BackgroundSwatchBlueBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch6" Click="OnBackgroundSwatchClick">
                    <Border Classes="swatch-fill" Background="{StaticResource BackgroundSwatchGreenBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch5" Click="OnBackgroundSwatchClick">
                    <Border Classes="swatch-fill" Background="{StaticResource BackgroundSwatchPinkBrush}" />
                </Button>
                <Button Classes="swatch-cell" Tag="swatch1" Click="OnBackgroundSwatchClick">
                    <Border Classes="swatch-fill" Background="{StaticResource BackgroundSwatchNeutralBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
