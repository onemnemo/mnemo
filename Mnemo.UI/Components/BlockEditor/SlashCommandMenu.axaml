<UserControl
    x:Class="Mnemo.UI.Components.BlockEditor.SlashCommandMenu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mnemo.UI.Components.BlockEditor"
    x:CompileBindings="True"
    MinWidth="268"
    MaxWidth="320"
    MaxHeight="420">
    <Border
        Background="{DynamicResource FloatingChromeBackgroundBrush}"
        BoxShadow="0 12 32 0 #52000000"
        CornerRadius="10"
        Padding="6">
        <StackPanel>
            <!-- Filter hint header -->
            <Grid ColumnDefinitions="*,Auto" Margin="10,5,10,7">
                <TextBlock
                    x:Name="FilterHintTextBlock"
                    FontSize="{DynamicResource FontSize.Caption}"
                    Foreground="{DynamicResource FloatingChromeForegroundMutedBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Text="esc"
                    FontFamily="{DynamicResource Font.Monospace}"
                    FontSize="{DynamicResource FontSize.Caption}"
                    Foreground="{DynamicResource FloatingChromeForegroundMutedBrush}" />
            </Grid>
            <!-- Command list with keyboard-selectable items -->
            <ScrollViewer
                MaxHeight="360"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <ListBox
                    x:Name="CommandListBox"
                    Classes="SlashCommandListBox"
                    Focusable="False"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionMode="Single">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:CommandItem">
                            <StackPanel Spacing="0">
                                <!-- Group separator (rendered above the first item of a new group) -->
                                <Border
                                    Height="1"
                                    Margin="4,5"
                                    Background="{DynamicResource FloatingChromeDividerBrush}"
                                    IsVisible="{Binding ShowSeparatorAbove}" />
                                <Border
                                    Classes="slash-row"
                                    Height="30"
                                    Padding="10,0"
                                    CornerRadius="7"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    PointerPressed="CommandItem_PointerPressed">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Classes="slash-row-name"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                            Foreground="{DynamicResource FloatingChromeForegroundBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource Font.Monospace}"
                                            FontSize="{DynamicResource FontSize.Caption}"
                                            Foreground="{DynamicResource FloatingChromeForegroundMutedBrush}"
                                            Text="{Binding Shortcut}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
