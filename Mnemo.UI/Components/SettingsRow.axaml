<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Mnemo.UI.Components"
                    x:ClassModifier="internal"
                    x:CompileBindings="True">

  <Design.PreviewWith>
    <Border Padding="24" Width="560">
      <StackPanel>
        <local:SettingsRow Title="Launch at startup"
                           Description="Start Mnemo automatically when you log in.">
          <local:SettingsRow.RightContent>
            <ToggleSwitch/>
          </local:SettingsRow.RightContent>
        </local:SettingsRow>
        <local:SettingsRow Title="Toast notifications"
                           Description="Pop-up alerts in the corner."
                           ShowDivider="False">
          <local:SettingsRow.RightContent>
            <ToggleSwitch IsChecked="True"/>
          </local:SettingsRow.RightContent>
        </local:SettingsRow>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type local:SettingsRow}" TargetType="local:SettingsRow">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_RowBorder"
                BorderBrush="{DynamicResource DividerSubtleBrush}"
                BorderThickness="0"
                Padding="0,14"
                HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,24,0" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}"
                         FontSize="{DynamicResource FontSize.Body.Small}"
                         FontFamily="{DynamicResource Font.Medium}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap"/>
              <TextBlock Text="{TemplateBinding Description}"
                         FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                         FontFamily="{DynamicResource Font.Regular}"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         TextWrapping="Wrap"
                         LineHeight="17"
                         IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <ContentPresenter Grid.Column="1"
                              Content="{TemplateBinding RightContent}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Bottom divider; the view suppresses it on each section's last row -->
    <Style Selector="^[ShowDivider=True] /template/ Border#PART_RowBorder">
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
