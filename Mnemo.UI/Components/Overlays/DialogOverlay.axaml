<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mnemo.UI.Components.Overlays"
             xmlns:conv="using:Mnemo.UI.Converters"
             xmlns:controls="using:Mnemo.UI.Controls"
             x:Class="Mnemo.UI.Components.Overlays.DialogOverlay"
             x:DataType="local:DialogOverlay"
             x:CompileBindings="True">
  <UserControl.Resources>
    <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Input field: quiet resting fill, accent ring on focus, constant thickness (no layout jump). -->
    <Style Selector="TextBox#InputTextBox">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Input}"/>
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource InputDialogSelectionForegroundBrush}"/>
      <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      </Style>
      <Style Selector="^:focus">
        <Setter Property="Background" Value="{DynamicResource OverlayBackgroundBrush}"/>
        <Style Selector="^ /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
      </Style>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource OverlayBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="24,22,24,20"
          MinWidth="372"
          MaxWidth="440">
    <StackPanel>
      <!-- Header: title + optional description on the left, close affordance on the right -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}"
                     FontFamily="{DynamicResource Font.SemiBold}"
                     FontSize="{DynamicResource FontSize.Heading6}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Title, Converter={StaticResource NullToBoolConverter}}"/>
          <TextBlock Text="{Binding Description}"
                     FontFamily="{DynamicResource Font.Medium}"
                     FontSize="{DynamicResource FontSize.Body.Small}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     LineHeight="20"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Description, Converter={StaticResource NullToBoolConverter}}"/>
        </StackPanel>

        <controls:AppButton Grid.Column="1"
                            Classes="ghost"
                            IconName="Common/x"
                            IconSize="16"
                            Padding="6"
                            Margin="0,-4,-6,0"
                            VerticalAlignment="Top"
                            Command="{Binding CloseCommand}"/>
      </Grid>

      <!-- Body (input mode only) -->
      <TextBox x:Name="InputTextBox"
               Margin="0,15,0,0"
               Text="{Binding InputValue, Mode=TwoWay}"
               PlaceholderText="{Binding Placeholder}"
               IsVisible="{Binding ShowInput}"/>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right"
                  Margin="0,18,0,0">
        <controls:AppButton Content="{Binding SecondaryText}"
                            Classes="ghost"
                            Command="{Binding SecondaryCommand}"
                            IsVisible="{Binding SecondaryText, Converter={StaticResource NullToBoolConverter}}"/>
        <controls:AppButton Content="{Binding PrimaryText}"
                            IconName="{Binding PrimaryIcon}"
                            Classes.destructive="{Binding IsDestructive}"
                            Classes.accent="{Binding !IsDestructive}"
                            Command="{Binding PrimaryCommand}"
                            IsVisible="{Binding PrimaryText, Converter={StaticResource NullToBoolConverter}}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
