<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mnemo.UI.Controls"
             xmlns:transfer="using:Mnemo.UI.Components.Overlays.Transfer"
             x:Class="Mnemo.UI.Components.Overlays.Transfer.TransferDialog"
             x:CompileBindings="False"
             Focusable="True"
             Width="520">
    <UserControl.Styles>
        <!-- Dashed affordances (dropzone, add-file row). -->
        <Style Selector="Rectangle.dash-outline">
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="4,3" />
            <Setter Property="RadiusX" Value="8" />
            <Setter Property="RadiusY" Value="8" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Rectangle.dash-outline.drag-over">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.SemiBold}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Invisible button hosting the dashed "Add another file" row. -->
        <Style Selector="Button.dash-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.dash-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.dash-row:pointerover TextBlock.dash-row-label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.dash-row-label">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Export format radio card. -->
        <Style Selector="Button.format-card">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.format-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}" />
        </Style>
        <Style Selector="Button.format-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.format-card.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
        </Style>

        <Style Selector="Button.format-card Border.card-check">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.format-card.selected Border.card-check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.format-card.selected TextBlock.card-ext">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.mono-hint">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Monospace}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="{DynamicResource Radius.Lg}"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource OverlayBackgroundBrush}"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Border Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                    Padding="20,16">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <controls:AppIcon Grid.Column="0"
                                      x:Name="DirectionIcon"
                                      Icon="Common/download"
                                      Width="16" Height="16"
                                      Margin="0,3,10,0"
                                      VerticalAlignment="Top"
                                      Color="{DynamicResource AccentBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body.Medium}"
                                   FontFamily="{DynamicResource Font.SemiBold}" />
                        <TextBlock x:Name="SubtitleText"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}" />
                    </StackPanel>
                    <controls:SegmentedToggle Grid.Column="2"
                                              x:Name="ModeToggle"
                                              Width="176"
                                              Margin="12,0"
                                              VerticalAlignment="Center"
                                              LeftIconPath="avares://Mnemo.UI/Icons/Common/download.svg"
                                              RightIconPath="avares://Mnemo.UI/Icons/Common/upload.svg" />
                    <controls:AppButton Grid.Column="3"
                                        Classes="ghost"
                                        IconName="Common/x"
                                        IconSize="14"
                                        Width="28" Height="28"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Click="OnCancelClick" />
                </Grid>
            </Border>

            <!-- Body -->
            <Border Grid.Row="1" Padding="20,18">
                <StackPanel Spacing="18">

                    <!-- ============ IMPORT ============ -->
                    <StackPanel x:Name="ImportPanel" Spacing="18">

                        <!-- Empty state: dropzone -->
                        <Panel x:Name="DropzonePanel" PointerPressed="OnDropzonePressed">
                            <Rectangle x:Name="DropzoneDash" Classes="dash-outline" />
                            <StackPanel Margin="24,32" Spacing="12" HorizontalAlignment="Center">
                                <Border Width="40" Height="40"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                        CornerRadius="{DynamicResource Radius.Md}">
                                    <controls:AppIcon Icon="Common/upload"
                                                      Width="18" Height="18"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Color="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock x:Name="DropHereText"
                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="DropOrText"
                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock x:Name="BrowseText"
                                               FontSize="{DynamicResource FontSize.Body.Small}"
                                               FontFamily="{DynamicResource Font.Medium}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Cursor="Hand" />
                                </StackPanel>
                                <ItemsControl x:Name="ExtensionChips" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                                    CornerRadius="{DynamicResource Radius.Sm}"
                                                    Padding="7,3">
                                                <TextBlock Text="{Binding}" Classes="mono-hint" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Panel>

                        <!-- Queued files -->
                        <StackPanel x:Name="FilesPanel" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="FilesLabel" Classes="field-label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           x:Name="FileCountText"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer MaxHeight="216"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FilesList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="transfer:TransferImportFile">
                                            <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                                    CornerRadius="{DynamicResource Radius.Md}"
                                                    Padding="10,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="30" Height="30"
                                                            Background="{DynamicResource CardIconBackgroundBrush}"
                                                            CornerRadius="{DynamicResource Radius.Md}"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <controls:AppIcon Icon="Common/file-text"
                                                                          Width="15" Height="15"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Color="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                                                   FontFamily="{DynamicResource Font.Medium}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailLabel}"
                                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <controls:AppButton Grid.Column="2"
                                                                        Classes="ghost"
                                                                        IconName="Common/x"
                                                                        IconSize="12"
                                                                        Width="24" Height="24"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        Tag="{Binding}"
                                                                        Click="OnRemoveFileClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button x:Name="AddFileButton" Classes="dash-row" Click="OnAddFileClick">
                                <Panel>
                                    <Rectangle x:Name="AddFileDash" Classes="dash-outline" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                Margin="0,9"
                                                HorizontalAlignment="Center">
                                        <controls:AppIcon Icon="Common/plus"
                                                          Width="13" Height="13"
                                                          VerticalAlignment="Center"
                                                          Color="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="AddFileLabel" Classes="dash-row-label" />
                                    </StackPanel>
                                </Panel>
                            </Button>

                            <Border x:Name="LimitNotice"
                                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                    CornerRadius="{DynamicResource Radius.Md}"
                                    Padding="12,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:AppIcon Icon="Common/triangle-alert"
                                                      Width="14" Height="14"
                                                      VerticalAlignment="Center"
                                                      Color="{DynamicResource ToastAccentWarningBrush}" />
                                    <TextBlock x:Name="LimitNoticeText"
                                               FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="RejectNotice"
                                       FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                                       Foreground="{DynamicResource ToastAccentWarningBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Conflict handling -->
                        <StackPanel x:Name="ConflictSection" Spacing="8">
                            <TextBlock x:Name="ConflictLabel" Classes="field-label" />
                            <Border Classes="segment-track">
                                <UniformGrid Rows="1">
                                    <Button x:Name="KeepBothButton" Classes="segment selected" Click="OnConflictClick" Tag="KeepBoth" />
                                    <Button x:Name="SkipButton" Classes="segment" Click="OnConflictClick" Tag="Skip" />
                                    <Button x:Name="ReplaceButton" Classes="segment" Click="OnConflictClick" Tag="Replace" />
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="ConflictCaption"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ EXPORT ============ -->
                    <StackPanel x:Name="ExportPanel" Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="FormatLabel" Classes="field-label" />
                            <UniformGrid x:Name="FormatCardsPanel" Rows="1" />
                        </StackPanel>

                        <StackPanel x:Name="ScopeSection" Spacing="8">
                            <TextBlock x:Name="ScopeLabel" Classes="field-label" />
                            <Border Classes="segment-track">
                                <UniformGrid x:Name="ScopeSegmentsPanel" Rows="1" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerSubtleBrush}"
                    Background="{DynamicResource CardBackgroundSecondaryBrush}"
                    Padding="20,14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="SummaryText"
                               FontSize="{DynamicResource FontSize.Body.ExtraSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <controls:AppButton x:Name="CancelButton"
                                            Classes="outline"
                                            Height="34"
                                            Padding="16,0"
                                            Click="OnCancelClick" />
                        <controls:AppButton x:Name="ConfirmButton"
                                            Classes="accent"
                                            Height="34"
                                            Padding="18,0"
                                            Click="OnConfirmClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ConfirmLabel" VerticalAlignment="Center" />
                                <TextBlock x:Name="ShortcutHint"
                                           FontFamily="{DynamicResource Font.Monospace}"
                                           FontSize="10"
                                           Opacity="0.65"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:AppButton>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
