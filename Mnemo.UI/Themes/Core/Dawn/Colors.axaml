    <Color x:Key="TabItemHeaderForegroundSelected">#1D1C1A</Color>
    <Color x:Key="TabItemHeaderBackgroundSelectedPointerOver">#EDECE6</Color>
    <Color x:Key="TabItemHeaderForegroundSelectedPointerOver">#1D1C1A</Color>
    <Color x:Key="TabItemHeaderBackgroundSelectedPressed">#F1F0EC</Color>
    <Color x:Key="TabItemHeaderForegroundSelectedPressed">#1D1C1A</Color>
    
    <!-- Disabled State -->
    <Color x:Key="TabItemHeaderBackgroundDisabled">#F1F0EC</Color>
    <Color x:Key="TabItemHeaderForegroundDisabled">#C9C6BE</Color>
    
    <!-- Selected Pipe Indicator -->
    <Color x:Key="TabItemHeaderSelectedPipeFill">#1D1C1A</Color>
    
    <!-- Rich Text Separation Line -->
    <Color x:Key="RichTextSeparationLineColor">#E6E4DE</Color>
    
    <!-- Syntax Highlighting Colors -->
    <Color x:Key="SyntaxKeyword">#0000FF</Color>
    <Color x:Key="SyntaxComment">#008000</Color>
    <Color x:Key="SyntaxString">#A31515</Color>
    <Color x:Key="SyntaxTag">#800080</Color>
    <Color x:Key="SyntaxEntity">#FF0000</Color>
    <Color x:Key="SyntaxSelector">#800000</Color>
    <Color x:Key="SyntaxProperty">#FF8C00</Color>
    
    <!-- Rich Text Highlighting -->
    <Color x:Key="HighlightedText">#E6E4DE</Color>
    <Color x:Key="SearchMatchHighlight">#FBDCAB</Color>
    <!-- Inline text highlight (formatting toolbar marker) -->
    <Color x:Key="InlineHighlightColor">#FFD7AA</Color>

    <!-- Block Editor - drop line -->
    <Color x:Key="BlockEditorDropLineBrush">#E6E4DE</Color>

    <!-- Generic border (card/panel dividers) -->
    <Color x:Key="Border">#E6E4DE</Color>
    <!-- Block quote vertical line -->
    <Color x:Key="QuoteLine">#C64F33</Color>
    <!-- Mindmap -->
    <Color x:Key="MindmapNodeBorder">#C64F33</Color>
    <Color x:Key="MindmapNodeBorderHover">#D66246</Color>
    <Color x:Key="MindmapNodeBorderSelected">#A8402A</Color>
    <Color x:Key="MindmapNodeBackgroundHover">#FBEEE7</Color>
    <Color x:Key="MindmapEdgeStroke">#716E67</Color>
    <Color x:Key="MindmapGridColor">#40000000</Color>
    <!-- Mindmap toolbar (floating panel) -->
    <Color x:Key="MindmapToolbarPanelBackground">#F8F7F3</Color>
    <Color x:Key="MindmapToolbarSectionBackground">#FFFFFF</Color>
    <Color x:Key="MindmapToolbarLabel">#57534D</Color>
    <Color x:Key="MindmapToolbarIcon">#57534D</Color>
    <Color x:Key="MindmapToolbarBorder">#E2E0D9</Color>
    <Color x:Key="MindmapToolbarTabActiveBackground">#E8E7E6</Color>
    <Color x:Key="MindmapToolbarTabActiveForeground">#1D1C1A</Color>
    <Color x:Key="MindmapToolbarButtonHover">#EAE8E2</Color>
    <!-- Mindmap toolbar node color swatches; 1 = default (null color) for new nodes -->
    <Color x:Key="MindmapToolbarNodeColorSwatchOne">#716E67</Color>
    <Color x:Key="MindmapToolbarNodeColorSwatchTwo">#C64F33</Color>
    <Color x:Key="MindmapToolbarNodeColorSwatchThree">#2686C2</Color>
    <Color x:Key="MindmapToolbarNodeColorSwatchFour">#6DA861</Color>
    <Color x:Key="MindmapToolbarNodeColorSwatchFive">#EAB308</Color>
    <Color x:Key="MindmapToolbarNodeColorSwatchSix">#886ce4</Color>
    <!-- Mindmap mode switcher (Edit | Preview bar) - aligned with ViewSwitchButtonActive / app accent -->
    <Color x:Key="MindmapModeSwitcherBorder">#E2E0D9</Color>
    <Color x:Key="MindmapModeSwitcherInactiveBackground">#E8E6E0</Color>
    <Color x:Key="MindmapModeSwitcherActiveBackground">#C64F33</Color>
    <Color x:Key="MindmapModeSwitcherActiveForeground">#FFFFFF</Color>
    <Color x:Key="MindmapModeSwitcherInactiveForeground">#57534D</Color>

    <!-- Inline text color swatches (foreground) -->
    <Color x:Key="TextColorSwatch1">#57534E</Color>
    <Color x:Key="TextColorSwatch2">#7C3AED</Color>
    <Color x:Key="TextColorSwatch3">#2563EB</Color>
    <Color x:Key="TextColorSwatch4">#9333EA</Color>
    <Color x:Key="TextColorSwatch5">#DC2626</Color>
    <Color x:Key="TextColorSwatch6">#16A34A</Color>
    <Color x:Key="TextColorSwatch7">#CA8A04</Color>
    <Color x:Key="TextColorSwatch8">#EA580C</Color>
    <Color x:Key="TextColorSwatch9">#0284C7</Color>
    <Color x:Key="TextColorSwatch10">#0D9488</Color>

    <!-- Inline background color swatches -->
    <Color x:Key="ColorSwatch1">#F1F0EC</Color>
    <Color x:Key="ColorSwatch2">#E6E6FA</Color>
    <Color x:Key="ColorSwatch3">#D8DCEC</Color>
    <Color x:Key="ColorSwatch4">#C4B5FD</Color>
    <Color x:Key="ColorSwatch5">#FADBD8</Color>
    <Color x:Key="ColorSwatch6">#E8F5E9</Color>
    <Color x:Key="ColorSwatch7">#FFF3CD</Color>
    <Color x:Key="ColorSwatch8">#FFE0B2</Color>
    <Color x:Key="ColorSwatch9">#DBEAFE</Color>
    <Color x:Key="ColorSwatch10">#D1EDDA</Color>

    <!-- Notes module (pane, section headers, editor) -->
    <Color x:Key="BlockSelectionBackground">#FDECEA</Color>
    <Color x:Key="NotesPaneBackground">#F8F7F3</Color>
    <Color x:Key="NotesSectionHeaderForeground">#57534D</Color>
    <Color x:Key="NotesPaneDivider">#E8E6E0</Color>
    <Color x:Key="NotesEditorSeparator">#E8E6E0</Color>

    <!-- Floating dark chrome: dark elevated surfaces that float over content
         (inline formatting toolbar, slash command menu, note index chip/popover).
         Deliberately dark even in light themes; overlays are white-alpha so they
         work on any chrome background a theme picks. -->
    <Color x:Key="FloatingChromeBackground">#232220</Color>
    <Color x:Key="FloatingChromeForeground">#EAE8E4</Color>
    <Color x:Key="FloatingChromeForegroundStrong">#F4F2EC</Color>
    <Color x:Key="FloatingChromeForegroundMuted">#8B8880</Color>
    <Color x:Key="FloatingChromeHover">#1AFFFFFF</Color>
    <Color x:Key="FloatingChromeActive">#1FFFFFFF</Color>
    <Color x:Key="FloatingChromePressed">#2EFFFFFF</Color>
    <Color x:Key="FloatingChromeDivider">#24FFFFFF</Color>
    <Color x:Key="FloatingChromeAccent">#C97A5D</Color>

    <!-- Code syntax highlighting (TextMate scopes → brushes in Controls.axaml) -->
    <Color x:Key="SyntaxCodeDefault">#1D1C1A</Color>
    <Color x:Key="SyntaxCodeKeyword">#6F42C1</Color>
    <Color x:Key="SyntaxCodeString">#0B6E0B</Color>
    <Color x:Key="SyntaxCodeComment">#6A737D</Color>
    <Color x:Key="SyntaxCodeNumber">#0550AE</Color>
    <Color x:Key="SyntaxCodeType">#0077C8</Color>
    <Color x:Key="SyntaxCodeFunction">#6639B7</Color>
    <Color x:Key="SyntaxCodeOperator">#A40E26</Color>
    <Color x:Key="SyntaxCodePunctuation">#57606A</Color>
    <Color x:Key="SyntaxCodeVariable">#24292F</Color>
    <Color x:Key="SyntaxCodeMarkup">#116329</Color>
    <Color x:Key="SyntaxCodeInvalid">#D1242F</Color>

    <!-- Slider -->
    <Color x:Key="SliderTrackFill">#E6E4DE</Color>
    <Color x:Key="SliderTrackValueFill">#C64F33</Color>
    <Color x:Key="SliderThumbBackground">#FFFFFF</Color>
    <Color x:Key="SliderThumbBorder">#E6E4DE</Color>
    <Color x:Key="SliderTickBarFill">#C9C6BE</Color>
    <Color x:Key="SliderContainerBackground">Transparent</Color>
    
    <!-- Slider PointerOver -->
    <Color x:Key="SliderTrackFillPointerOver">#DAD8D1</Color>
    <Color x:Key="SliderTrackValueFillPointerOver">#D66246</Color>
    <Color x:Key="SliderThumbBackgroundPointerOver">#F1F0EC</Color>
    <Color x:Key="SliderContainerBackgroundPointerOver">Transparent</Color>
    
    <!-- Slider Pressed -->
    <Color x:Key="SliderTrackFillPressed">#B8B5AC</Color>
    <Color x:Key="SliderTrackValueFillPressed">#A8402A</Color>
    <Color x:Key="SliderThumbBackgroundPressed">#E6E4DE</Color>
    <Color x:Key="SliderContainerBackgroundPressed">Transparent</Color>
    
    <!-- Slider Disabled -->
    <Color x:Key="SliderTrackFillDisabled">#F1F0EC</Color>
    <Color x:Key="SliderTrackValueFillDisabled">#C9C6BE</Color>
    <Color x:Key="SliderThumbBackgroundDisabled">#F1F0EC</Color>
    <Color x:Key="SliderTickBarFillDisabled">#E6E4DE</Color>
    <Color x:Key="SliderContainerBackgroundDisabled">Transparent</Color>

    <!-- Subtle divider (flat list/settings rows; lighter than Border) -->
    <Color x:Key="DividerSubtle">#F0EEE8</Color>

    <!-- Outline Button (bordered secondary action on canvas surfaces) -->
    <Color x:Key="OutlineButtonBackground">#FFFFFF</Color>
    <Color x:Key="OutlineButtonBackgroundPointerOver">#F1F0EC</Color>
    <Color x:Key="OutlineButtonBackgroundPressed">#E9E7E1</Color>
    <Color x:Key="OutlineButtonBackgroundDisabled">#F7F6F2</Color>
    <Color x:Key="OutlineButtonForeground">#514F49</Color>
    <Color x:Key="OutlineButtonForegroundDisabled">#C9C6BE</Color>
    <Color x:Key="OutlineButtonBorder">#E6E4DE</Color>
    <Color x:Key="OutlineButtonBorderPointerOver">#D8D5CE</Color>
    <Color x:Key="OutlineButtonBorderPressed">#D8D5CE</Color>
    <Color x:Key="OutlineButtonBorderDisabled">#F1F0EC</Color>
</ResourceDictionary>