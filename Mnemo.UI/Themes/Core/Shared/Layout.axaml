<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared layout tokens. Theme-independent: merged once at Application level
        (App.axaml) so they survive theme swaps performed by ThemeService.

        Rules of use:
        - Spacing: pick from the 4px scale below; no ad-hoc margins/paddings in views.
        - Radius: Sm = inputs/chips, Md = buttons/rows, Lg = cards/dialogs,
          Xl = large surfaces (widgets, panels), Pill = fully rounded.
        - Icons: Sm = inline/tree, Md = default UI, Lg = feature, Xl = empty states.
        - Elevation: 1 = resting card, 2 = hover/dropdown, 3 = dialog, 4 = command palette.
    -->

    <!-- Spacing scale (4px grid) -->
    <x:Double x:Key="Space.1">4</x:Double>
    <x:Double x:Key="Space.2">8</x:Double>
    <x:Double x:Key="Space.3">12</x:Double>
    <x:Double x:Key="Space.4">16</x:Double>
    <x:Double x:Key="Space.5">20</x:Double>
    <x:Double x:Key="Space.6">24</x:Double>
    <x:Double x:Key="Space.7">32</x:Double>
    <x:Double x:Key="Space.8">40</x:Double>

    <!-- Corner radius scale -->
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Icon sizes -->
    <x:Double x:Key="IconSize.Sm">16</x:Double>
    <x:Double x:Key="IconSize.Md">20</x:Double>
    <x:Double x:Key="IconSize.Lg">24</x:Double>
    <x:Double x:Key="IconSize.Xl">32</x:Double>

    <!-- Standard insets -->
    <Thickness x:Key="PagePadding">40,24</Thickness>
    <Thickness x:Key="PanePadding">20</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ListRowPadding">12,10</Thickness>

    <!-- Sidebar -->
    <x:Double x:Key="SidebarWidth">264</x:Double>
    <x:Double x:Key="SidebarCollapsedWidth">64</x:Double>
    <Thickness x:Key="SidebarPadding">14,10,14,12</Thickness>

    <!-- Topbar -->
    <x:Double x:Key="TopbarHeight">44</x:Double>
    <Thickness x:Key="TopbarPadding">20,0,14,0</Thickness>
    <x:Double x:Key="TopbarSearchWidth">230</x:Double>

    <!-- Elevation (shadow only; pair with theme surface brushes) -->
    <BoxShadows x:Key="Elevation.1">0 1 2 0 #14000000</BoxShadows>
    <BoxShadows x:Key="Elevation.2">0 2 8 0 #1F000000</BoxShadows>
    <BoxShadows x:Key="Elevation.3">0 8 24 0 #29000000</BoxShadows>
    <BoxShadows x:Key="Elevation.4">0 16 48 -4 #3D000000</BoxShadows>
</ResourceDictionary>
