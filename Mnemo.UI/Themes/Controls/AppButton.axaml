<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Mnemo.UI.Controls"
                    x:ClassModifier="internal"
                    x:CompileBindings="True">

  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <controls:AppButton Content="Save" IconName="Common/circle-plus" Classes="accent"/>
        <controls:AppButton Content="Loading" IconName="Common/circle-plus" Classes="accent" IsLoading="True"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type controls:AppButton}" TargetType="controls:AppButton">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ButtonBorderBrushThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:.075" />
      </Transitions>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border x:Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Cursor="Hand">
            <StackPanel x:Name="PART_ContentHost"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <controls:AppIcon x:Name="PART_Icon"
                                 Icon="{TemplateBinding IconName}"
                                 Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                 VerticalAlignment="Center"
                                 IsVisible="{TemplateBinding IconName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <!-- Collapses when empty so icon-only buttons stay centered (StackPanel spacing) -->
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontFamily="{DynamicResource Font.Medium}"
                                RecognizesAccessKey="True"
                                IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <controls:AppIcon x:Name="PART_LoadingIcon"
                             Icon="Common/circle-dashed"
                             Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             IsVisible="False">
            <controls:AppIcon.RenderTransform>
              <RotateTransform Angle="0"/>
            </controls:AppIcon.RenderTransform>
          </controls:AppIcon>

          <Border x:Name="PART_FocusRing"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="2"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Margin="-2"
                  IsHitTestVisible="False"
                  IsVisible="False"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderPointerOverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPointerOverBrush}" />
    </Style>

    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderPressedBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressedBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabledBrush}" />
    </Style>

    <!-- Focus-visible ring: independent overlay, applies the same way across every variant -->
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Loading: content fades out, spinner fades in and spins continuously -->
    <Style Selector="^:loading /template/ StackPanel#PART_ContentHost">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:loading /template/ controls|AppIcon#PART_LoadingIcon">
      <Setter Property="IsVisible" Value="True"/>
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="^.accent">
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderPointerOverBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOverBrush}" />
      </Style>

      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderPressedBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressedBrush}" />
      </Style>

      <Style Selector="^:disabled /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderDisabledBrush}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabledBrush}" />
      </Style>

      <Style Selector="^ /template/ controls|AppIcon#PART_Icon">
        <Setter Property="Color" Value="{DynamicResource AccentButtonForegroundBrush}"/>
      </Style>
      <Style Selector="^ /template/ controls|AppIcon#PART_LoadingIcon">
        <Setter Property="Color" Value="{DynamicResource AccentButtonForegroundBrush}"/>
      </Style>
    </Style>

    <Style Selector="^.destructive">
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource DestructiveButtonColorBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource DestructiveButtonHoverColorBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource DestructiveButtonColorBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^:disabled /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderDisabledBrush}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabledBrush}" />
      </Style>

      <Style Selector="^ /template/ controls|AppIcon#PART_Icon">
        <Setter Property="Color" Value="White"/>
      </Style>
      <Style Selector="^ /template/ controls|AppIcon#PART_LoadingIcon">
        <Setter Property="Color" Value="White"/>
      </Style>
    </Style>

    <Style Selector="^.secondary">
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonTextColorBrush}" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^:disabled /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderDisabledBrush}" />
      </Style>

      <Style Selector="^ /template/ controls|AppIcon#PART_Icon">
        <Setter Property="Color" Value="{DynamicResource SecondaryButtonTextColorBrush}"/>
      </Style>
      <Style Selector="^ /template/ controls|AppIcon#PART_LoadingIcon">
        <Setter Property="Color" Value="{DynamicResource SecondaryButtonTextColorBrush}"/>
      </Style>
    </Style>

    <!-- Outline: bordered, sits on canvas surfaces (settings rows, toolbars) -->
    <Style Selector="^.outline">
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OutlineButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource OutlineButtonForegroundBrush}" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OutlineButtonBackgroundPointerOverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineButtonBorderPointerOverBrush}" />
      </Style>

      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OutlineButtonBackgroundPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineButtonBorderPressedBrush}" />
      </Style>

      <Style Selector="^:disabled /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OutlineButtonBackgroundDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineButtonBorderDisabledBrush}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource OutlineButtonForegroundDisabledBrush}" />
      </Style>

      <Style Selector="^ /template/ controls|AppIcon#PART_Icon">
        <Setter Property="Color" Value="{DynamicResource OutlineButtonForegroundBrush}"/>
      </Style>
      <Style Selector="^ /template/ controls|AppIcon#PART_LoadingIcon">
        <Setter Property="Color" Value="{DynamicResource OutlineButtonForegroundBrush}"/>
      </Style>
    </Style>

    <Style Selector="^.ghost">
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource GhostButtonTextBrush}" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      </Style>

      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      </Style>

      <Style Selector="^:disabled /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^ /template/ controls|AppIcon#PART_Icon">
        <Setter Property="Color" Value="{DynamicResource GhostButtonIconBrush}"/>
      </Style>
      <Style Selector="^ /template/ controls|AppIcon#PART_LoadingIcon">
        <Setter Property="Color" Value="{DynamicResource GhostButtonTextBrush}"/>
      </Style>
    </Style>

    <Style Selector="^.topbar">
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource TopbarButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TopbarButtonForegroundBrush}" />
      </Style>

      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource TopbarButtonBackgroundHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource TopbarButtonBackgroundPressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^:disabled /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource TopbarButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^ /template/ controls|AppIcon#PART_Icon">
        <Setter Property="Color" Value="{DynamicResource TopbarButtonForegroundBrush}"/>
      </Style>
      <Style Selector="^ /template/ controls|AppIcon#PART_LoadingIcon">
        <Setter Property="Color" Value="{DynamicResource TopbarButtonForegroundBrush}"/>
      </Style>
    </Style>

    <!-- Default (no variant class): icon tints follow the base foreground -->
    <Style Selector="^ /template/ controls|AppIcon#PART_Icon">
      <Setter Property="Color" Value="{DynamicResource ButtonForegroundBrush}"/>
    </Style>
    <Style Selector="^ /template/ controls|AppIcon#PART_LoadingIcon">
      <Setter Property="Color" Value="{DynamicResource ButtonForegroundBrush}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
