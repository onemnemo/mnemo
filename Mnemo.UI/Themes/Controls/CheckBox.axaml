<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <CheckBox>Unchecked</CheckBox>
        <CheckBox IsChecked="True">Checked</CheckBox>
        <CheckBox IsThreeState="True" IsChecked="{x:Null}">Indeterminate</CheckBox>
        <CheckBox Width="120">Checkbox should wrap its text</CheckBox>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <StreamGeometry x:Key="CheckMarkPathData">M1 4.5 4 7.5 10 1.5</StreamGeometry>

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Padding" Value="12,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="RootGrid" ColumnDefinitions="19,*">
          <Border x:Name="PART_Border"
                  Grid.ColumnSpan="2"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />

          <Grid VerticalAlignment="Center" Height="19">
            <Border x:Name="NormalRectangle"
                    VerticalAlignment="Top"
                    BorderBrush="{DynamicResource CheckBoxCheckBackgroundStrokeBrush}"
                    Background="{DynamicResource CheckBoxCheckBackgroundFillBrush}"
                    BorderThickness="1.5"
                    CornerRadius="{StaticResource Radius.Sm}"
                    UseLayoutRounding="False"
                    Height="19"
                    Width="19">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <Viewbox UseLayoutRounding="False" VerticalAlignment="Center" Width="10" Height="8">
              <Path x:Name="CheckGlyph"
                    Opacity="0"
                    Fill="Transparent"
                    Stroke="{DynamicResource CheckBoxCheckGlyphForegroundBrush}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Data="{StaticResource CheckMarkPathData}"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight" />
            </Viewbox>
          </Grid>
          <ContentPresenter x:Name="PART_ContentPresenter"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Content="{TemplateBinding Content}"
                          Margin="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          TextWrapping="Wrap"
                          Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Unchecked PointerOver State -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundPointerOverBrush}" />
      </Style>

      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^ /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokePointerOverBrush}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillPointerOverBrush}" />
      </Style>

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
      </Style>
    </Style>

    <!-- Unchecked Pressed State -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundPressedBrush}" />
      </Style>

      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^ /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokePressedBrush}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillPressedBrush}" />
      </Style>

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
      </Style>
    </Style>

    <!-- Unchecked Disabled state -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundDisabledBrush}" />
      </Style>

      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <Style Selector="^ /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeDisabledBrush}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillDisabledBrush}" />
      </Style>

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundDisabledBrush}" />
      </Style>
    </Style>

    <Style Selector="^:checked">
      <!-- Checked Normal State -->
      <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />

      <Style Selector="^ /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundBrush}" />
      </Style>

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
        <Setter Property="Data" Value="{StaticResource CheckMarkPathData}" />
        <Setter Property="Opacity" Value="1" />
      </Style>

      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundCheckedBrush}" />
        <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
      </Style>

      <!-- Checked PointerOver State -->
      <Style Selector="^:pointerover">
        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#NormalRectangle">
          <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundPointerOverBrush}" />
          <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundPointerOverBrush}" />
        </Style>

        <Style Selector="^ /template/ Path#CheckGlyph">
          <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
        </Style>
      </Style>

      <!-- Checked Pressed State -->
      <Style Selector="^:pressed">
        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#NormalRectangle">
          <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundPressedBrush}" />
          <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundPressedBrush}" />
        </Style>

        <Style Selector="^ /template/ Path#CheckGlyph">
          <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
        </Style>
      </Style>

      <!-- Checked Disabled State -->
      <Style Selector="^:disabled">
        <Style Selector="^ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundDisabledBrush}" />
        </Style>

        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#NormalRectangle">
          <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundDisabledBrush}" />
          <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundDisabledBrush}" />
        </Style>

        <Style Selector="^ /template/ Path#CheckGlyph">
          <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundDisabledBrush}" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^:indeterminate">
      <!-- Indeterminate Normal State: filled accent box with a white minus bar,
           matching the checked state's weight so partial selection reads as "active" -->
      <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />

      <Style Selector="^ /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundBrush}" />
      </Style>

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
        <Setter Property="Data" Value="M0 0 L512 0 L512 96 L0 96 Z" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Opacity" Value="1" />
      </Style>

      <!-- Indeterminate PointerOver State -->
      <Style Selector="^:pointerover">
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundPointerOverBrush}" />
        </Style>

        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#NormalRectangle">
          <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundPointerOverBrush}" />
          <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundPointerOverBrush}" />
        </Style>

        <Style Selector="^ /template/ Path#CheckGlyph">
          <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
        </Style>
      </Style>

      <!-- Indeterminate Pressed State -->
      <Style Selector="^:pressed">
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundPressedBrush}" />
        </Style>

        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#NormalRectangle">
          <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundPressedBrush}" />
          <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundPressedBrush}" />
        </Style>

        <Style Selector="^ /template/ Path#CheckGlyph">
          <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundBrush}" />
        </Style>
      </Style>

      <!-- Indeterminate Disabled State -->
      <Style Selector="^:disabled">
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundDisabledBrush}" />
        </Style>

        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#NormalRectangle">
          <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBackgroundDisabledBrush}" />
          <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundDisabledBrush}" />
        </Style>

        <Style Selector="^ /template/ Path#CheckGlyph">
          <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundDisabledBrush}" />
        </Style>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>





