<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    x:CompileBindings="True">

  <!--
    Compact pill switch (32x18 track, 14px knob). States come from the
    ToggleSwitch* theme tokens; keyboard focus renders an accent ring.
    OnContent/OffContent are intentionally not rendered - pair the switch
    with an external label (e.g. a SettingsRow title).
  -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent"
              Width="32" Height="18"
              TemplatedControl.IsTemplateFocusTarget="True">

          <Border x:Name="PillBody"
                  CornerRadius="9"
                  Background="{DynamicResource ToggleSwitchFillOffBrush}"
                  BorderBrush="{DynamicResource ToggleSwitchStrokeOffBrush}"
                  BorderThickness="1">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
          </Border>

          <Grid x:Name="PART_MovingKnobs">
            <Border x:Name="SwitchKnob"
                    Width="14" Height="14"
                    CornerRadius="7"
                    Background="{DynamicResource ToggleSwitchKnobFillOffBrush}"
                    BoxShadow="0 1 2 0 #26000000"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="2,0,0,0">
              <Border.Transitions>
                <Transitions>
                  <ThicknessTransition Property="Margin" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </Grid>

          <Border x:Name="PART_FocusRing"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="2"
                  CornerRadius="11"
                  Margin="-3"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Checked -->
    <Style Selector="^:checked /template/ Border#PillBody">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#SwitchKnob">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnBrush}" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>

    <!-- PointerOver -->
    <Style Selector="^:pointerover /template/ Border#PillBody">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPointerOverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#SwitchKnob">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOverBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#PillBody">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPointerOverBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#SwitchKnob">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOverBrush}" />
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed /template/ Border#PillBody">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOffPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPressedBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#SwitchKnob">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOffPressedBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ Border#PillBody">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPressedBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ Border#SwitchKnob">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnPressedBrush}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled /template/ Border#PillBody">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOffDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#SwitchKnob">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOffDisabledBrush}" />
    </Style>
    <Style Selector="^:checked:disabled /template/ Border#PillBody">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnDisabledBrush}" />
    </Style>
    <Style Selector="^:checked:disabled /template/ Border#SwitchKnob">
      <Setter Property="Background" Value="{DynamicResource ToggleSwitchKnobFillOnDisabledBrush}" />
    </Style>

    <!-- Keyboard focus ring -->
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
