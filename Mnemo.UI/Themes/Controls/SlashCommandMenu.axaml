<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">

    <!--
      SlashCommandListBox: dark floating-chrome palette. Hover/selection is painted on the
      inner Border.slash-row (not the ListBoxItem) so the group separator above a row never
      picks up the highlight.
    -->
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      Default row fill lives in a style setter (not an inline Background on the Border),
      otherwise the local value would outrank the :pointerover / :selected setters below
      and no highlight would ever paint.
    -->
    <Style Selector="ListBox.SlashCommandListBox Border.slash-row">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:pointerover Border.slash-row">
        <Setter Property="Background" Value="{DynamicResource FloatingChromeHoverBrush}" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected Border.slash-row">
        <Setter Property="Background" Value="{DynamicResource FloatingChromeActiveBrush}" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected:pressed Border.slash-row">
        <Setter Property="Background" Value="{DynamicResource FloatingChromePressedBrush}" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected TextBlock.slash-row-name">
        <Setter Property="Foreground" Value="{DynamicResource FloatingChromeForegroundStrongBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}" />
    </Style>

    <!-- The selected row swaps its markdown-alias hint for a return glyph (Enter applies it). -->
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem TextBlock.slash-row-enter">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected TextBlock.slash-row-enter">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox.SlashCommandListBox ListBoxItem:selected TextBlock.slash-row-shortcut">
        <Setter Property="IsVisible" Value="False" />
    </Style>
</Styles>
