<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mnemo.UI.Controls"
             x:Name="Root"
             x:Class="Mnemo.UI.Controls.SegmentedToggle"
             x:DataType="controls:SegmentedToggle">

    <UserControl.Styles>
        <Style Selector="Button.segment">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.segment TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body.ExtraSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>

        <Style Selector="Button.segment controls|SvgIcon">
            <Setter Property="Color" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>

        <!-- Translucent white hover so the track tint shows through on any theme. -->
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8CFFFFFF"/>
        </Style>

        <Style Selector="Button.segment.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
        </Style>

        <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.segment.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Medium}"/>
        </Style>

        <Style Selector="Button.segment.selected controls|SvgIcon">
            <Setter Property="Color" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.segment:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="{DynamicResource Radius.Md}"
            Background="{DynamicResource CardBackgroundSecondaryBrush}"
            Padding="3">

        <Grid ColumnDefinitions="*,*" ColumnSpacing="3">

            <Button Grid.Column="0"
                    Classes="segment"
                    Classes.selected="{Binding #Root.IsLeftSelected}"
                    IsEnabled="{Binding #Root.LeftIsEnabled}"
                    Command="{Binding #Root.LeftCommand}"
                    Click="OnLeftClicked">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <controls:SvgIcon SvgPath="{Binding #Root.LeftIconPath}" Width="11" Height="11"/>
                    <TextBlock Text="{Binding #Root.LeftText}"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Classes="segment"
                    Classes.selected="{Binding #Root.IsRightSelected}"
                    IsEnabled="{Binding #Root.RightIsEnabled}"
                    Command="{Binding #Root.RightCommand}"
                    Click="OnRightClicked">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <controls:SvgIcon SvgPath="{Binding #Root.RightIconPath}" Width="11" Height="11"/>
                    <TextBlock Text="{Binding #Root.RightText}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
