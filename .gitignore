# Improvement notes and deferred rework, not part of the shipped repo
future-review/

# Typst runtime: the per-RID typst binary is fetched by restore-typst (~52 MB each),
# never committed. The vendored mitex package under typst-packages/ IS tracked (375 KB).
Mnemo.Host/TypstRuntime/binaries/

# Our restore-typst tooling lives in scripts/ as source, not generated output; the
# stock VS [Ss]cripts/ rule above would otherwise ignore it.
!scripts/

